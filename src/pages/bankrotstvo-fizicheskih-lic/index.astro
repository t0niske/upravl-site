<script>
  // Колонки «Могут продать» по ширине самого текста: при переносе строки блок шире текста,
  // и справа остаётся пустота. Сужаем колонки, остаток поровну уходит в промежутки.
  const items = [...document.querySelectorAll<HTMLElement>('.im-chips .im-item')];
  const mq = window.matchMedia('(min-width: 1280px)');
  const fit = () => {
    items.forEach((li) => (li.style.width = ''));
    if (!mq.matches) return;
    const widths = items.map((li) => {
      const r = document.createRange();
      r.selectNodeContents(li.querySelector('span')!);
      const right = Math.max(...[...r.getClientRects()].map((x) => x.right));
      return Math.ceil(right - li.getBoundingClientRect().left);
    });
    items.forEach((li, i) => (li.style.width = `${widths[i]}px`));
  };
  let t = 0;
  window.addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(fit, 100); });
  document.fonts.ready.then(fit);
</script>
