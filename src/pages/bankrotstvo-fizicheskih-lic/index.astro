---
import Page from '../../layouts/Page.astro';
import HomeQuiz from '../../components/HomeQuiz.astro';
import LpSection from '../../components/LpSection.astro';
import Steps from '../../components/Steps.astro';
import HomePrice from '../../components/HomePrice.astro';
import { nb } from '../../data/typo';
import HomeCases from '../../components/HomeCases.astro';
import HomeReviews from '../../components/HomeReviews.astro';
import { pricing, law, rub } from '../../data/site';
import { serviceSchema } from '../../data/schema';

const url = '/bankrotstvo-fizicheskih-lic/';
const description = `Списание долгов гражданам через Арбитражный суд Томской области: под ключ от ${rub(pricing.citizenTurnkey)}, рассрочка. Что сохранится, какие сделки оспорят.`;

const CK = 'M20 6 9 17l-5-5';
const XX = 'M6 6l12 12M18 6 6 18';
const written = ['Потребительские кредиты и кредитные карты', 'Микрозаймы (МФО)', 'Займы по распискам у людей и организаций', 'Долги по договорам с организациями', 'Налоги, сборы, штрафы и пени', 'Долги за ЖКХ до подачи заявления', 'Долги ИП по предпринимательской деятельности'];
const notWritten = ['Алименты', 'Возмещение вреда жизни и здоровью', 'Долги по зарплате и выходным пособиям перед работниками', 'Субсидиарная ответственность и убытки, причинённые компании', 'Долги из-за мошенничества или умышленного уклонения', 'Текущие платежи: ЖКХ и налоги после подачи заявления'];
const procedures = [
  { name: 'Реструктуризация долгов', tag: '', rows: [['Цель', 'погасить долги по плану'], ['Когда вводится', 'есть стабильный доход, хватает на платежи'], ['Срок', `план — до ${law.restructuringYears} лет`], ['Статус банкрота', 'нет'], ['Итог', 'долги погашены, пени не начисляются']] },
  { name: 'Реализация имущества', tag: 'большинство дел граждан', rows: [['Цель', 'продать имущество сверх защищённого и списать остаток'], ['Когда вводится', 'дохода не хватает или план не утвердили'], ['Срок', `${law.realizationMonths} месяцев, может продлеваться`], ['Статус банкрота', 'да'], ['Итог', 'освобождение от оставшихся долгов']] },
  { name: 'Мировое соглашение', tag: '', rows: [['Цель', 'договориться с кредиторами'], ['Когда вводится', 'на любой стадии, по согласию сторон'], ['Срок', 'по условиям соглашения'], ['Статус банкрота', 'нет, дело прекращается'], ['Итог', 'долги платятся на новых условиях']] },
];
const keep = ['Единственное жильё и земля под ним, если не в ипотеке', 'Предметы обихода, мебель, одежда и личные вещи, кроме роскоши', 'Имущество для работы стоимостью до 100 МРОТ', 'Прожиточный минимум на вас и иждивенцев — ежемесячно', 'Транспорт и имущество, необходимое инвалиду', 'Государственные награды и памятные знаки'];
const sell = ['Автомобиль', 'Вторая квартира, дача, гараж, участок', 'Доли в недвижимости и в бизнесе', 'Ипотечная квартира — даже если она единственная: деньги в первую очередь получает банк'];
const deals = ['Продажа и дарение имущества, особенно родственникам и по заниженной цене', 'Брачный договор и раздел имущества с супругом', 'Отказ от наследства', 'Алиментное соглашение на сумму выше обычной', 'Погашение долга одному кредитору в ущерб остальным', 'Выход из состава участников ООО', 'Фиктивные займы и залоги'];
const docs = ['Паспорт, ИНН, СНИЛС', 'Свидетельства о браке, разводе, рождении детей, брачный договор', 'Кредитные договоры, справки о задолженности, судебные решения, сведения об исполнительных производствах', 'Справки о доходах за 3 года, сведения о трудовой деятельности', 'Выписка из Социального фонда о состоянии лицевого счёта', 'Выписка из ЕГРН, документы на транспорт, сведения о долях и акциях', 'Выписки по банковским счетам и картам за 3 года', 'Документы о сделках с имуществом за 3 года'];
const after = [['5 лет', 'сообщать о банкротстве при оформлении кредитов и займов'], ['5 лет', 'нельзя повторно подать на собственное банкротство'], ['3 года', 'нельзя занимать должности в органах управления юрлица'], ['5 лет', 'то же в страховой компании, НПФ, инвестфонде, МФО'], ['10 лет', 'то же в кредитной организации']];

const faq = [
  {
    q: 'Можно ли обанкротиться, если долг меньше 500 000 ₽?',
    a: 'Да. Порог 500 000 ₽ определяет, когда гражданин обязан подать заявление. Подать по собственному желанию можно при любой сумме, если вы не можете платить: прекратили расчёты с кредиторами, больше 10 % долгов просрочено дольше месяца или долг больше стоимости имущества. При долге до 1 000 000 ₽ проверьте условия бесплатного банкротства через МФЦ.',
  },
  {
    q: 'Можно ли пройти банкротство без официального дохода и имущества?',
    a: 'Да. Верховный суд в определении от 23.01.2017 по делу № А70-14095/2015 указал, что отсутствие имущества и дохода не мешает признать гражданина банкротом. В таком случае просим суд сразу ввести реализацию имущества, минуя реструктуризацию (п. 8 ст. 213.6 закона о банкротстве).',
  },
  {
    q: 'Что будет с зарплатой во время процедуры?',
    a: 'Зарплату и другие доходы получает финансовый управляющий, но ежемесячно выдаёт должнику сумму не ниже прожиточного минимума на него и иждивенцев. Суд может увеличить сумму, если для этого есть основания: лечение, содержание детей с особыми потребностями.',
  },
  {
    q: 'Узнают ли на работе о банкротстве?',
    a: 'Сведения о процедуре публикуются в Едином федеральном реестре сведений о банкротстве, он открыт. Работодатель получит уведомление от управляющего о перечислении зарплаты. Уволить за банкротство нельзя; ограничение касается только руководящих должностей в организациях.',
  },
  {
    q: 'Можно ли выезжать за границу?',
    a: 'Суд может временно ограничить выезд из России на время реализации имущества, если должник не сотрудничает с управляющим. При добросовестном поведении ограничение обычно не вводят или снимают по ходатайству.',
  },
  {
    q: 'Спишут ли долг поручителя или созаёмщика?',
    a: 'Ваш собственный долг по поручительству или как созаёмщика — спишут вместе с остальными. Но для второго созаёмщика или основного заёмщика обязательство остаётся: банк продолжит требовать с него.',
  },
];
---

<Page
  title="Банкротство физических лиц в Томске — под ключ"
  description={description}
  h1="Банкротство физических лиц в Томске"
  eyebrow="Для граждан"
  crumbs={[{ name: 'Банкротство граждан', href: url }]}
  facts={[
    ['Сопровождение под ключ', `от ${rub(pricing.citizenTurnkey)}`],
    ['Рассрочка', `от ${rub(pricing.citizenInstallmentFrom)} в месяц`],
    ['Депозит управляющему', rub(law.fuDeposit)],
    ['Реализация имущества', `от ${law.realizationMonths} месяцев`],
  ]}
  faq={faq}
  topic="Банкротство гражданина"
  schema={[serviceSchema({ name: 'Банкротство физических лиц', url, description, price: pricing.citizenTurnkey, serviceType: 'Сопровождение процедуры банкротства гражданина' })]}
  related={[
    { href: '/bankrotstvo-fizicheskih-lic/cherez-mfc/', label: 'Банкротство через МФЦ', text: 'Бесплатно при долге до 1 млн ₽ и оконченном исполнительном производстве.' },
    { href: '/stati/mify-o-bankrotstve-grazhdan/', label: '10 мифов о банкротстве', text: 'Что правда про работу, кредиты и имущество после процедуры.' },
    { href: '/dela/', label: 'Завершённые дела', text: 'Номера дел и суммы, которые суд списал гражданам.' },
  ]}
>
  <Fragment slot="lead">
    <p>
      Банкротство гражданина — судебная процедура, после которой Арбитражный суд освобождает должника от долгов, которые он не может вернуть:
      кредитов, микрозаймов, налогов, долгов за ЖКХ и по распискам. Проценты и пени перестают начисляться с первого определения суда,
      звонки коллекторов прекращаются.
    </p>
  </Fragment>

  <Fragment slot="after">
    <!-- Кому подходит -->
    <LpSection id="komu" chip="Кому подходит" title="Кому подходит судебное банкротство" lead="Закон различает обязанность и право подать заявление">
      <div class="lp-two">
        <div class="lp-card lp-blue">
          <p class="lp-k">Обязаны подать</p>
          <p class="lp-big tnum">от {rub(law.citizenDutyThreshold)}</p>
          <p class="lp-t">{nb('долга, и вы не можете расплатиться со всеми кредиторами. Заявление нужно подать в течение 30 рабочих дней (ст. 213.4 закона о банкротстве)')}</p>
        </div>
        <div class="lp-card">
          <p class="lp-k">Вправе подать при любой сумме</p>
          <p class="lp-t lp-t-dark">{nb('если подходит хотя бы один признак неплатёжеспособности:')}</p>
          <ul class="lp-list">
            {['перестали платить кредиторам по наступившим срокам', 'больше 10 % наступивших долгов не оплачено дольше месяца', 'долги больше стоимости вашего имущества', 'приставы окончили исполнительное производство, потому что взыскать нечего'].map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}
          </ul>
        </div>
      </div>
      <a href="/bankrotstvo-fizicheskih-lic/cherez-mfc/" class="lp-strip">
        <span>{nb(`Долг до ${rub(law.mfcMax)} и приставы окончили производство? Сначала проверьте бесплатное банкротство через МФЦ — суд и управляющий там не нужны`)}</span>
        <span class="lp-arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
    </LpSection>

    <!-- Какие долги спишут -->
    <LpSection id="dolgi" chip="Долги" title="Какие долги спишут, а какие останутся" lead="После завершения процедуры суд освобождает от большинства долгов, которые были на дату заявления. Исключения — в ст. 213.28 закона о банкротстве" bg="grey">
      <div class="lp-two">
        <div class="lp-card">
          <p class="lp-h"><span class="lp-ic lp-ic-blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={CK} /></svg></span>Спишут</p>
          <ul class="lp-rows">{written.map((t) => <li>{nb(t)}</li>)}</ul>
        </div>
        <div class="lp-card">
          <p class="lp-h"><span class="lp-ic lp-ic-dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d={XX} /></svg></span>Не спишут</p>
          <ul class="lp-rows">{notWritten.map((t) => <li>{nb(t)}</li>)}</ul>
        </div>
      </div>
    </LpSection>

    <!-- Три процедуры -->
    <LpSection id="procedury" chip="Процедуры" title="Три процедуры: реструктуризация, реализация имущества, мировое соглашение" lead="Суд выбирает процедуру по доходам должника и позиции кредиторов. Большинство дел граждан идёт сразу через реализацию имущества">
      <div class="lp-three">
        {procedures.map((pr) => (
          <div class:list={['lp-card lp-grey', pr.tag && 'is-main']}>
            {pr.tag && <span class="lp-tag">{pr.tag}</span>}
            <h3 class="lp-name">{pr.name}</h3>
            <dl class="lp-dl">
              {pr.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{nb(v)}</dd></div>)}
            </dl>
          </div>
        ))}
      </div>
    </LpSection>

    <!-- Что сохранится -->
    <LpSection id="imushchestvo" chip="Имущество" title="Что из имущества сохранится" lead="Перечень защищённого имущества установлен ст. 446 Гражданского процессуального кодекса — его не продают, даже если долги большие" bg="grey">
      <div class="lp-two">
        <div class="lp-card lp-blue">
          <p class="lp-h"><span class="lp-ic lp-ic-white"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={CK} /></svg></span>Останется</p>
          <ul class="lp-rows lp-rows-light">{keep.map((t) => <li>{nb(t)}</li>)}</ul>
        </div>
        <div class="lp-card">
          <p class="lp-h"><span class="lp-ic lp-ic-dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d={XX} /></svg></span>Могут продать на торгах</p>
          <ul class="lp-rows">{sell.map((t) => <li>{nb(t)}</li>)}</ul>
        </div>
      </div>
    </LpSection>

    <!-- Сделки -->
    <LpSection id="sdelki" chip="Сделки" title="Какие сделки могут оспорить" lead={`Финансовый управляющий обязан проверить сделки за ${law.challengePeriodYears} года до принятия заявления. Если сделка навредила кредиторам, её признают недействительной, а имущество вернут в конкурсную массу`}>
      <ul class="lp-chips">
        {deals.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}
      </ul>
      <div class="lp-strip lp-strip-static">
        <span>{nb('Поэтому сделки за последние три года разбираем до подачи заявления. Иногда безопаснее подождать или выбрать другую процедуру')}</span>
        <a href="#zayavka" class="lp-btn">Обсудить мою ситуацию</a>
      </div>
    </LpSection>

    <!-- Порядок и сроки -->
    <Steps />

    <!-- Документы -->
    <LpSection id="dokumenty" chip="Документы" title="Какие документы понадобятся" lead="Полный список зависит от ситуации, базовый набор — такой. Большую часть можно заказать через Госуслуги, с остальным помогу">
      <ol class="lp-docs">
        {docs.map((t, i) => <li><span class="lp-num tnum">{String(i + 1).padStart(2, '0')}</span><span>{nb(t)}</span></li>)}
      </ol>
    </LpSection>

    <!-- Стоимость -->
    <HomePrice />

    <!-- Ограничения после -->
    <LpSection id="posle" chip="После процедуры" title="Какие ограничения будут после банкротства" lead="Последствия установлены ст. 213.30 закона о банкротстве и действуют с даты завершения процедуры" bg="grey">
      <ul class="lp-after">
        {after.map(([y, t]) => <li class="lp-card"><span class="lp-year tnum">{y}</span><span class="lp-t lp-t-dark">{nb(t)}</span></li>)}
      </ul>
      <p class="lp-strip lp-strip-ok">
        <span class="lp-ic lp-ic-blue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={CK} /></svg></span>
        <span>{nb('Работать по найму, открывать счета, ездить в отпуск и снова брать кредиты после процедуры можно')}</span>
      </p>
    </LpSection>

    <HomeQuiz />
    <HomeCases />
    <HomeReviews />
  </Fragment>
</Page>

<style>
  .lp-two { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 768px) { .lp-two { grid-template-columns: 1fr 1fr; } }
  .lp-three { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 1024px) { .lp-three { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .lp-card { display: flex; flex-direction: column; padding: clamp(1.25rem, 2.4vw, 2.25rem); border-radius: 18px; background: #fff; color: #1d1e21; }
  :global(.lps:not(.is-grey)) .lp-card:not(.lp-blue) { background: #f3f4f6; }
  .lp-blue { background: linear-gradient(135deg, #034b8e 0%, #053a6e 60%, #0b1a30 100%); color: #fff; }
  .lp-k { font-size: 0.9375rem; color: #7c818a; }
  .lp-blue .lp-k { color: rgb(255 255 255 / 0.75); }
  .lp-big { margin-top: 0.75rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(2.25rem, 3.6vw, 3.25rem); line-height: 1; letter-spacing: -0.03em; }
  .lp-t { margin-top: 0.875rem; font-size: var(--fs-body); line-height: 1.5; color: rgb(255 255 255 / 0.88); text-wrap: pretty; }
  .lp-t-dark { color: #2a2d33; }
  .lp-list { display: grid; gap: 0.75rem; margin-top: 1rem; }
  .lp-list li, .lp-chips li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 0.875rem; font-size: var(--fs-body); line-height: 1.45; color: #2a2d33; }
  .lp-sq { display: grid; grid-template-columns: 5px 5px; grid-auto-rows: 5px; gap: 2px; margin-top: 0.45em; }
  .lp-sq i { width: 5px; height: 5px; border-radius: 1px; background: #034b8e; }

  .lp-strip {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem;
    margin-top: clamp(0.75rem, 1.4vw, 1.25rem); padding: clamp(1rem, 1.8vw, 1.5rem) clamp(1.25rem, 2vw, 2rem);
    border-radius: 16px; background: #f3f4f6; font-size: var(--fs-body); line-height: 1.45; color: #1d1e21; text-decoration: none;
    transition: box-shadow 150ms var(--ease-out);
  }
  :global(.lps.is-grey) .lp-strip { background: #fff; }
  a.lp-strip:hover { box-shadow: inset 0 0 0 2px #034b8e; }
  .lp-strip > span:first-child { flex: 1; min-width: 16rem; }
  .lp-arrow { display: grid; flex: none; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 8px; background: #034b8e; color: #fff; }
  .lp-strip-ok { justify-content: flex-start; flex-wrap: nowrap; gap: 1rem; }
  .lp-strip-ok > span:last-child { flex: 1; }
  .lp-btn {
    display: inline-flex; flex: none; align-items: center; justify-content: center; min-height: 3.25rem; padding: 0 1.5rem;
    border-radius: 10px; background: #034b8e; color: #fff; font-weight: 500; text-decoration: none; transition: background-color 150ms var(--ease-out);
  }
  .lp-btn:hover { background: #0a5aa6; }
  @media (max-width: 639px) { .lp-btn { width: 100%; } .lp-strip > span:first-child { min-width: 0; } }

  .lp-h { display: flex; align-items: center; gap: 0.875rem; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; }
  .lp-ic { display: grid; flex: none; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 10px; }
  .lp-ic svg { width: 1.25rem; height: 1.25rem; }
  .lp-ic-blue { background: #034b8e; color: #fff; }
  .lp-ic-dark { background: #1d1e21; color: #fff; }
  .lp-ic-white { background: #fff; color: #034b8e; }
  .lp-rows { margin-top: 1.25rem; }
  .lp-rows li { padding: 0.875rem 0; border-top: 1px solid rgb(29 30 33 / 0.1); font-size: var(--fs-body); line-height: 1.4; color: #2a2d33; }
  .lp-rows-light li { border-top-color: rgb(255 255 255 / 0.16); color: rgb(255 255 255 / 0.92); }

  .lp-grey { background: #f3f4f6; }
  .lp-card.is-main { box-shadow: inset 0 0 0 2px #034b8e; }
