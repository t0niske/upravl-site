---
import Page from '../../layouts/Page.astro';
import LpSection from '../../components/LpSection.astro';
import Lawyer from '../../components/Lawyer.astro';
import HomeReviews from '../../components/HomeReviews.astro';
import { Image } from 'astro:assets';
import { nb } from '../../data/typo';
import imgCar from '../../assets/mfc/bad-car.jpg';
import imgCreditors from '../../assets/mfc/bad-creditors.jpg';
import imgDeals from '../../assets/mfc/bad-deals.jpg';
import imgDebt from '../../assets/mfc/bad-debt.jpg';
import heroBg from '../../assets/mfc/hero-bg.jpg';
import { law, rub } from '../../data/site';
import { serviceSchema } from '../../data/schema';

const url = '/bankrotstvo-fizicheskih-lic/cherez-mfc/';
const description = `Внесудебное банкротство в Томске: бесплатно, долг от ${rub(law.mfcMin)} до ${rub(law.mfcMax)}, около ${law.mfcDurationMonths} месяцев. Проверю условия и список кредиторов до подачи.`;

// Когда МФЦ — плохой выбор: [заголовок, пояснение, картинка]
const bad: [string, string, ImageMetadata][] = [
  ['Есть имущество, которое можно продать', 'Например, автомобиль. Тогда кредиторы вправе перевести дело в суд', imgCar],
  ['Вы не уверены, что знаете всех кредиторов', 'Пропущенные долги не спишут, а повторно обратиться можно только через 5 лет', imgCreditors],
  ['Были сделки с имуществом за последние годы', 'Кредитор может оспорить их уже в судебной процедуре', imgDeals],
  [`Долг больше ${rub(law.mfcMax)}`, 'Внесудебный порядок недоступен ни при каком доходе', imgDebt],
];
// Как подать заявление
const steps = [
  'Получите постановление об окончании исполнительного производства на Госуслугах или у пристава и проверьте основание — п. 4 ч. 1 ст. 46',
  'Закажите кредитные истории во всех бюро, чтобы найти все долги, включая проданные коллекторам',
  'Составьте список кредиторов по установленной форме: кто, по какому договору, сколько',
  'Подайте заявление в МФЦ по месту жительства или пребывания. МФЦ проверяет сведения и в течение нескольких рабочих дней включает их в ЕФРСБ',
  `Через ${law.mfcDurationMonths} месяцев процедура завершается, и долги из списка списываются`,
];
const during = ['Кредиторы не могут взыскивать долги, указанные в заявлении', 'Перестают начисляться неустойки и проценты'];
const limits = ['Брать новые кредиты и займы нельзя', 'О новом имуществе или доходе нужно сообщить, иначе кредиторы смогут оспорить процедуру'];
const after = [['5 лет', 'сообщать о банкротстве при оформлении кредитов и займов'], ['3 года', 'нельзя руководить организацией'], ['5 лет', 'нельзя повторно пройти банкротство через МФЦ']];

const faq = [
  {
    q: 'Сколько стоит банкротство через МФЦ?',
    a: 'Сама процедура бесплатная: госпошлины и вознаграждения управляющему нет. Платная только помощь юриста, если вы решите проверить условия и составить список кредиторов с ним.',
  },
  {
    q: 'Что будет, если забыть указать кредитора?',
    a: 'Долги перед кредиторами, которых нет в заявлении, после процедуры не спишут. Это самая частая ошибка: забывают старые микрозаймы, долги, проданные коллекторам, налоги и задолженность за ЖКХ. Перед подачей стоит заказать кредитную историю во всех бюро.',
  },
  {
    q: 'Могут ли отказать?',
    a: 'МФЦ возвращает заявление, если нет постановления об окончании исполнительного производства по нужному основанию, есть другое неоконченное производство или сумма долга вне пределов. Кредиторы в течение процедуры могут обратиться в суд, тогда внесудебное банкротство прекращается.',
  },
  {
    q: 'Можно ли пройти через МФЦ повторно?',
    a: 'Повторно обратиться можно не раньше чем через 5 лет после завершения предыдущей процедуры. Если заявление вернули из-за неполных сведений, его можно подать снова после исправления.',
  },
];

---

<Page
  title="Банкротство через МФЦ в Томске: условия 2026"
  description={description}
  h1="Банкротство через МФЦ в Томске"
  eyebrow="Для граждан · внесудебная процедура"
  crumbs={[{ name: 'Банкротство физических лиц', href: '/bankrotstvo-fizicheskih-lic/' }, { name: 'Через МФЦ', href: url }]}
  facts={[
    ['Стоимость процедуры', 'бесплатно'],
    ['Сумма долга', `до ${rub(law.mfcMax)}`],
    ['Длительность', `около ${law.mfcDurationMonths} месяцев`],
    ['Суд и управляющий', 'не нужны'],
  ]}
  faq={faq}
  topic="Банкротство через МФЦ"
  expert
  heroBg={heroBg}
  formTitle="Проверю, пройдёт ли ваше заявление в МФЦ"
  formText="Если по условиям подходит МФЦ, скажу об этом прямо — судебная процедура вам не нужна. Помогу составить полный список кредиторов, чтобы ни один долг не остался."
  schema={[serviceSchema({ name: 'Внесудебное банкротство гражданина через МФЦ', url, description })]}
>
  <Fragment slot="lead">
    <p>{nb(`Бесплатное списание долгов без суда и управляющего при долге от ${rub(law.mfcMin)} до ${rub(law.mfcMax)}. Проверю условия и список кредиторов до подачи, чтобы ни один долг не остался`)}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Кому подходит -->
    <LpSection id="komu" chip="Кому подходит" title="Кто может пройти банкротство через МФЦ" lead="Условия установлены ст. 223.2 закона о банкротстве. Основной сценарий — должник, с которого приставы ничего не смогли взыскать">
      <div class="lp-two">
        <div class="lp-card lp-blue">
          <p class="lp-k">Сумма долгов</p>
          <p class="lp-big tnum">до {rub(law.mfcMax)}</p>
          <p class="lp-t">{nb(`общая сумма — от ${rub(law.mfcMin)} до ${rub(law.mfcMax)} включительно. Через ${law.mfcDurationMonths} месяцев после включения в реестр долги из заявления списываются`)}</p>
        </div>
        <div class="lp-card">
          <p class="lp-k">Главное условие</p>
          <h3 class="lp-h3">Приставы ничего не взыскали</h3>
          <ul class="lp-signs">
            {['исполнительное производство окончено из-за отсутствия имущества (п. 4 ч. 1 ст. 46 закона об исполнительном производстве)', 'нового исполнительного производства по тем же долгам нет'].map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}
          </ul>
        </div>
      </div>
      <a href="#zayavka" class="lp-strip">
        <span>{nb('Закон предусматривает и другие основания — например, для получателей пенсии или пособия по уходу за ребёнком, когда исполнительный документ у приставов больше года. Детали проверю на консультации')}</span>
        <span class="lp-arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
    </LpSection>

    <!-- Кто ведёт дело -->
    <Lawyer />

    <!-- Когда не подходит -->
    <LpSection id="ne-podhodit" chip="Ограничения" title="Когда МФЦ — плохой выбор" lead="В этих случаях внесудебная процедура не спишет долги или её прекратят. Тогда нужно судебное банкротство" bg="grey">
      <ul class="mf-grid">
        {bad.map(([h, t, img], i) => (
          <li class="mf-card">
            <Image src={img} alt="" widths={[400, 640]} sizes="(min-width: 1280px) 22vw, (min-width: 768px) 45vw, 92vw" class="mf-img" loading="lazy" />
            <div class="mf-body">
              <span class="mf-n tnum">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mf-h">{nb(h)}</h3>
              <p class="mf-t">{nb(t)}</p>
            </div>
          </li>
        ))}
      </ul>
      <a href="/bankrotstvo-fizicheskih-lic/" class="lp-strip">
        <span>{nb(`Долг больше ${rub(law.mfcMax)}, есть имущество или сделки?`)}<br class="lp-br" /> {nb('Посмотрите, как проходит судебное банкротство и сколько оно стоит')}</span>
        <span class="lp-arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
    </LpSection>

    <!-- Как подать -->
    <LpSection id="kak-podat" chip="Порядок" title="Как подать заявление" lead="Процедуру запускает сам гражданин через МФЦ. Главное — не пропустить ни одного кредитора">
      <div class="sd-wrap">
        <div class="sd-card">
          <p class="sd-num">{law.mfcDurationMonths} месяцев</p>
          <p class="sd-cap">{nb('после включения сведений в ЕФРСБ долги из заявления списываются')}</p>
          <p class="sd-note">{nb('Долги перед кредиторами, которых нет в заявлении, не спишут. Это самая частая ошибка, поэтому список проверяем до подачи')}</p>
          <a href="#zayavka" class="lp-btn sd-btn">Проверить мои условия</a>
        </div>
        <ol class="sd-list">
          {steps.map((t, i) => <li><span class="sd-n tnum">[{String(i + 1).padStart(2, '0')}]</span><span>{nb(t)}</span></li>)}
        </ol>
      </div>
    </LpSection>

    <!-- Во время процедуры -->
    <LpSection id="vo-vremya" chip="Во время процедуры" title="Что происходит во время процедуры" lead="С даты включения сведений в ЕФРСБ вводится мораторий на взыскание долгов из заявления" bg="grey">
      <div class="lp-two">
        <div class="lp-card">
          <div class="dg-head"><h3 class="dg-h">Мораторий</h3><span class="dg-tag">защищает от кредиторов</span></div>
          <ul class="dg-list">{during.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}</ul>
        </div>
        <div class="lp-card">
          <div class="dg-head"><h3 class="dg-h">Ограничения</h3><span class="dg-tag is-grey">на время процедуры</span></div>
          <ul class="dg-list is-grey">{limits.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}</ul>
        </div>
      </div>
    </LpSection>

    <!-- После процедуры -->
    <LpSection id="posle" chip="После процедуры" title="Какие ограничения будут после списания" lead="Последствия похожи на судебное банкротство и действуют с даты завершения процедуры">
      <div class="ps-panel">
        <dl class="ps-facts">
          {after.map(([y, t]) => <div class="ps-fact"><dt>{nb(t)}</dt><dd class="tnum">{y}</dd></div>)}
        </dl>
        <p class="ps-ok"><span class="ps-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb('Если заявление вернули из-за неполных сведений, его можно подать снова после исправления')}</span></p>
      </div>
    </LpSection>

    <HomeReviews />
  </Fragment>
</Page>

<style>
  .lp-two { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 768px) { .lp-two { grid-template-columns: 1fr 1fr; } }
  .lp-three { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 1024px) { .lp-three { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .lp-card { display: flex; flex-direction: column; padding: clamp(1.25rem, 2vw, 1.75rem); border-radius: 18px; background: #fff; color: #1d1e21; }
  :global(.lps:not(.is-grey)) .lp-card:not(.lp-blue) { background: #f3f4f6; }
  .lp-blue { background: linear-gradient(135deg, #034b8e 0%, #053a6e 60%, #0b1a30 100%); color: #fff; }
  .lp-k { font-size: 0.9375rem; color: #7c818a; }
  .lp-blue .lp-k { color: rgb(255 255 255 / 0.75); }
  .lp-big { margin-top: 0.75rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(2.25rem, 3.6vw, 3.25rem); line-height: 1; letter-spacing: -0.03em; }
  .lp-t { margin-top: 0.875rem; font-size: var(--fs-body); line-height: 1.5; color: rgb(255 255 255 / 0.88); text-wrap: pretty; }
  .lp-t-muted { margin-top: 0.625rem; color: #5f646d; }
  .lp-h3 { margin-top: 0.75rem; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -0.015em; color: #1d1e21; text-wrap: balance; }
  .lp-signs { margin-top: 1rem; }
  .lp-signs li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 0.875rem; padding: 0.625rem 0; border-top: 1px solid rgb(29 30 33 / 0.1); font-size: var(--fs-body); line-height: 1.4; color: #2a2d33; }
  .lp-signs li:last-child { padding-bottom: 0; }
  .lp-br { display: none; }
  @media (min-width: 1024px) { .lp-br { display: inline; } }
  .lp-list { display: grid; gap: 0.75rem; margin-top: 1rem; }
  .lp-list li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 0.875rem; font-size: var(--fs-body); line-height: 1.45; color: #2a2d33; }
  .lp-sq { display: grid; grid-template-columns: 5px 5px; grid-auto-rows: 5px; gap: 2px; margin-top: 0.45em; }
  .lp-sq i { width: 5px; height: 5px; border-radius: 1px; background: #034b8e; }

  .lp-strip {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem;
    margin-top: clamp(0.75rem, 1.2vw, 1rem); padding: clamp(1rem, 1.4vw, 1.25rem) clamp(1.25rem, 2vw, 2rem);
    border-radius: 16px; background: #f3f4f6; font-size: var(--fs-body); line-height: 1.45; color: #1d1e21; text-decoration: none;
    transition: box-shadow 150ms var(--ease-out);
  }
  :global(.lps.is-grey) .lp-strip { background: #fff; }
  a.lp-strip:hover { box-shadow: inset 0 0 0 2px #034b8e; }
  .lp-strip > span:first-child { flex: 1; min-width: 16rem; }
  .lp-arrow { display: grid; flex: none; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 8px; background: #034b8e; color: #fff; }
  .lp-btn {
    display: inline-flex; flex: none; align-items: center; justify-content: center; min-height: 3.25rem; padding: 0 1.5rem;
    border-radius: 10px; background: #034b8e; color: #fff; font-weight: 500; text-decoration: none; transition: background-color 150ms var(--ease-out);
  }
  .lp-btn:hover { background: #0a5aa6; }
  @media (max-width: 639px) { .lp-btn { width: 100%; } .lp-strip > span:first-child { min-width: 0; } }



  /* Долги: как карточка «Что входит в сопровождение» — заголовок с ярлыком и список с квадратиками */
  .dg-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1rem; margin-bottom: 1rem; }
  /* телефон: ярлык всегда справа от заголовка; если не влезает — переносится внутри себя */
  @media (max-width: 639px) { .dg-head { flex-wrap: nowrap; } .dg-h { flex: none; } .dg-tag { min-width: 0; padding: 0.3125rem 0.625rem; font-size: 0.8125rem; text-align: center; } }
  .dg-h { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.15; letter-spacing: -0.015em; color: #1d1e21; }
  .dg-tag { padding: 0.375rem 0.75rem; border-radius: 8px; background: #e6eef8; font-size: 0.9375rem; font-weight: 500; line-height: 1.3; color: #034b8e; }
  .dg-tag.is-grey { background: #f3f4f6; color: #5f646d; }
  .dg-list li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 0.875rem; padding: 0.4rem 0; font-size: var(--fs-body); line-height: 1.45; color: #1d1e21; }
  .dg-list.is-grey .lp-sq i { background: #9aa0a8; }
  /* После процедуры: графитовая панель (как «Обо мне» на главной), стеклянная плашка как на первом экране */
  .ps-panel { position: relative; overflow: hidden; padding: clamp(1.25rem, 2.4vw, 2.25rem); border-radius: 18px; background: #1d1e21; color: #fff; }
  .ps-facts { display: grid; border-radius: 16px; background: rgb(255 255 255 / 0.05); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
  .ps-fact { position: relative; display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0.875rem 1.25rem; }
  .ps-fact + .ps-fact::before { content: ''; position: absolute; top: 0; left: 1.25rem; right: 1.25rem; height: 1px; background: rgb(255 255 255 / 0.14); }
  .ps-fact dt { font-size: 0.9375rem; line-height: 1.35; color: rgb(255 255 255 / 0.7); }
  .ps-fact dd { flex: none; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.375rem, 2.1vw, 2rem); line-height: 1.1; letter-spacing: -0.02em; }
  /* телефон и планшет: срок крупно сверху, пояснение под ним на всю ширину */
  @media (max-width: 1023px) {
    .ps-fact { flex-direction: column; align-items: flex-start; gap: 0.375rem; padding: 1rem 1.25rem; }
    .ps-fact dd { order: -1; font-size: 1.5rem; }
    .ps-fact dt { font-size: 1rem; line-height: 1.35; color: rgb(255 255 255 / 0.75); }
  }
  @media (min-width: 1024px) {
    .ps-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 1.5rem 0; }
    .ps-fact { flex-direction: column; align-items: stretch; justify-content: space-between; gap: 0.75rem; padding: 0 1.5rem; }
    .ps-fact + .ps-fact::before { top: 8%; bottom: 8%; left: 0; right: auto; width: 1px; height: auto; background: rgb(255 255 255 / 0.18); }
  }
  .ps-ok { display: flex; align-items: center; gap: 0.875rem; margin-top: 1.25rem; font-size: var(--fs-body); line-height: 1.45; color: rgb(255 255 255 / 0.9); }
  .ps-sq { display: grid; flex: none; grid-template-columns: 5px 5px; grid-auto-rows: 5px; gap: 2px; }
  .ps-sq i { border-radius: 1px; background: #fff; }
  /* Сделки: серая карточка с цифрой (как статистика «Обо мне») + список с [01] (как «Услуги» на главной) */
  .sd-wrap { display: grid; gap: 1.5rem; }
  @media (min-width: 1024px) { .sd-wrap { grid-template-columns: minmax(0, 5fr) minmax(0, 8fr); gap: clamp(1.5rem, 3vw, 3.5rem); } }
  .sd-card { display: flex; flex-direction: column; padding: clamp(1.25rem, 1.8vw, 2rem) clamp(1.25rem, 1.6vw, 1.75rem); border-radius: 16px; background: #f3f4f6; }
  .sd-num { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.25rem, 3.2vw, 3rem); line-height: 1; letter-spacing: -0.02em; color: #1d1e21; }
  .sd-cap { margin-top: 0.5rem; font-size: var(--fs-body); line-height: 1.45; color: #7c818a; text-wrap: pretty; }
  .sd-note { margin-top: auto; padding-top: 2rem; font-size: var(--fs-body); line-height: 1.45; color: #1d1e21; }
  .lp-btn.sd-btn { align-self: flex-start; margin-top: 1.25rem; }
  @media (max-width: 639px) { .lp-btn.sd-btn { align-self: stretch; } }
  .sd-list li { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 1rem; padding: 1rem 0; border-top: 1px solid rgb(29 30 33 / 0.1); font-size: var(--fs-body); line-height: 1.45; color: #1d1e21; }
  .sd-list li:last-child { border-bottom: 1px solid rgb(29 30 33 / 0.1); }
  .sd-n { color: #8a8f98; }
  @media (max-width: 639px) { .sd-list li { grid-template-columns: 2.75rem minmax(0, 1fr); gap: 0.75rem; } }
