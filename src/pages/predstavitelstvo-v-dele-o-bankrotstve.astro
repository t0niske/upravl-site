---
import Page from '../layouts/Page.astro';
import LpSection from '../components/LpSection.astro';
import Lawyer from '../components/Lawyer.astro';
import Steps from '../components/Steps.astro';
import Services from '../components/Services.astro';
import HomeReviews from '../components/HomeReviews.astro';
import { nb } from '../data/typo';
import { law, rub, pricing } from '../data/site';
import { serviceSchema } from '../data/schema';
import HomePrice from '../components/HomePrice.astro';
import heroBg from '../assets/predstavitelstvo/hero-bg.jpg';
import '../styles/lp.css';

const url = '/predstavitelstvo-v-dele-o-bankrotstve/';
const description = 'Представление интересов в деле о банкротстве гражданина в Арбитражном суде Томской области — от 5 000 ₽ за заседание. Под ключ — от 125 000 ₽.';

// Что делаю в суде (по этапам судебной процедуры на сайте)
const work: [string, string][] = [
  ['Заседание о признании заявления обоснованным', 'суд вводит процедуру и утверждает финансового управляющего'],
  ['Требования кредиторов', 'проверяю, что включают в реестр, и возражаю, если требование завышено или спорное'],
  ['Споры о сделках', 'защищаю позицию, если управляющий или кредитор оспаривает сделку за 3 года'],
  ['Имущество', 'отстаиваю то, что защищено законом: единственное жильё, вещи обихода, прожиточный минимум'],
  ['Завершение процедуры', 'заседание, на котором суд освобождает от долгов'],
];

const faq = [
  {
    q: 'Сколько стоит представительство в деле о банкротстве?',
    a: `От 5 000 ₽ за одно заседание в деле о банкротстве гражданина. Если нужна вся процедура — сопровождение под ключ от ${rub(pricing.citizenTurnkey)} с рассрочкой от ${rub(pricing.citizenInstallmentFrom)} в месяц.`,
  },
  {
    q: 'Представляете интересы компаний?',
    a: 'Да, представительство в деле о банкротстве юридического лица — от 5 000 ₽ за заседание. Подробнее — на страницах о банкротстве ООО и АО и о защите от субсидиарной ответственности.',
  },
  {
    q: 'Сколько длится дело о банкротстве?',
    a: 'Ориентировочно: суд вводит процедуру за 1–3 месяца, реализация имущества длится от 6 месяцев. Точные сроки зависят от загрузки суда и сложности дела.',
  },
  {
    q: 'Что из имущества сохранится?',
    a: 'По ст. 446 ГПК не продают единственное жильё и землю под ним, если они не в ипотеке, предметы обихода и личные вещи, кроме роскоши, имущество для работы до 100 МРОТ. Ежемесячно должнику оставляют прожиточный минимум на него и иждивенцев.',
  },
];
---

<Page
  title="Представительство в деле о банкротстве — Томск"
  description={description}
  h1="Представление интересов в деле о банкротстве"
  eyebrow="Арбитражный суд Томской области"
  crumbs={[{ name: 'Представление интересов в суде', href: url }]}
  facts={[
    ['Одно заседание', 'от 5 000 ₽'],
    ['Заявление о банкротстве', 'от 12 000 ₽'],
    ['Сопровождение под ключ', `от ${rub(pricing.citizenTurnkey)}`],
    ['Депозит управляющему', rub(law.fuDeposit)],
  ]}
  faq={faq}
  topic="Представительство в деле о банкротстве"
  expert
  heroBg={heroBg}
  formTitle="Помогу на заседании"
  formText="Расскажите коротко о своей ситуации. Скажу, чем могу помочь, и назову цену до начала работы."
  schema={[serviceSchema({ name: 'Представительство в деле о банкротстве гражданина', url, description, price: 5000, serviceType: 'Представление интересов в Арбитражном суде по делу о банкротстве' })]}
  related={[
    { href: '/bankrotstvo-fizicheskih-lic/', label: 'Банкротство физических лиц', text: 'Кому подходит, какие долги спишут, что сохранится.' },
    { href: '/podgotovka-dokumentov-na-bankrotstvo/', label: 'Подготовка документов', text: 'Заявление о признании банкротом и список кредиторов.' },
    { href: '/yuridicheskie-uslugi-v-arbitrazhnyh-sudah/', label: 'Другие споры в арбитраже', text: 'Иски, жалобы, представительство во всех инстанциях.' },
  ]}
>
  <Fragment slot="lead">
    <p>{nb('Представляю граждан в деле о банкротстве в Арбитражном суде Томской области — от 5 000 ₽ за заседание')}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Что делаю на заседаниях -->
    <Services
      id="zasedaniya"
      chip="В суде"
      title="На каких заседаниях нужна помощь"
      lead="Дело о банкротстве — это несколько заседаний и обособленных споров. На каждом можно потерять то, что сохранил бы закон"
      btnHref="#zayavka"
      btnLabel="Обсудить дело"
      items={work.map(([title, t]) => ({ title, text: t.charAt(0).toUpperCase() + t.slice(1) }))}
      bg="grey"
    />

    <!-- Кто представляет -->
    <Lawyer />

    <!-- Этапы -->
    <Steps />

    <!-- Цены -->
    <HomePrice title="Сколько стоит представительство" tiles={[['заявление о признании гражданина банкротом', 12000, true], ['депозит на вознаграждение финансового управляющего', law.fuDeposit], ['под ключ — рассрочка в месяц', pricing.citizenInstallmentFrom, true]]} totalLabel="Представительство — за одно заседание" totalSum={5000} tag={null} incTitle={`Если нужно всё дело — под ключ от ${rub(pricing.citizenTurnkey)}`} />

    <HomeReviews />
  </Fragment>
</Page>
