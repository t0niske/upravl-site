---
import Page from '../layouts/Page.astro';
import LpSection from '../components/LpSection.astro';
import HomePrice from '../components/HomePrice.astro';
import HomeReviews from '../components/HomeReviews.astro';
import { nb } from '../data/typo';
import { law, rub, pricing } from '../data/site';
import { serviceSchema } from '../data/schema';
import heroBg from '../assets/rassrochka/hero-bg.jpg';
import '../styles/lp.css';

/**
 * Рассрочка на банкротство (25.11.2026). Факты: от 10 000 ₽/мес, без процентов и без банка (дизайнер со слов заказчика),
 * под ключ от 125 000 ₽, депозит 25 000 ₽ отдельно. Срок, первый взнос и порядок внесения депозита неизвестны — не пишем.
 */
const url = '/bankrotstvo-v-rassrochku/';
const description = `Банкротство гражданина в рассрочку в Томске: от ${rub(pricing.citizenInstallmentFrom)} в месяц, без процентов и без банка. Сопровождение под ключ — от ${rub(pricing.citizenTurnkey)}.`;

const terms = [
  'Без процентов — переплаты за рассрочку нет',
  'Без банка — не нужны кредит и одобрение',
  'Платите напрямую за юридическое сопровождение',
  'Цену называю до начала работы и фиксирую в договоре',
];


const faq = [
  { q: 'Есть ли проценты за рассрочку?', a: 'Нет. Рассрочка без процентов: переплаты за то, что платите частями, нет.' },
  { q: 'Нужно ли оформлять кредит или обращаться в банк?', a: 'Нет. Рассрочка без банка: кредит, одобрение и кредитный договор не нужны — вы платите напрямую за юридическое сопровождение.' },
  { q: 'Сколько платить в месяц?', a: `От ${rub(pricing.citizenInstallmentFrom)} в месяц. Сопровождение под ключ — от ${rub(pricing.citizenTurnkey)}. Итоговую цену называю до начала работы и фиксирую в договоре.` },
  { q: 'Входит ли депозит управляющему в итоговую сумму?', a: `Да. В итог «от ${rub(pricing.citizenTurnkey + law.fuDeposit)}» уже входят сопровождение под ключ от ${rub(pricing.citizenTurnkey)} и ${rub(law.fuDeposit)} на депозит суда для вознаграждения финансового управляющего. Публикации в ЕФРСБ и «Коммерсанте» оплачиваются по тарифам, а если имущество продают на торгах, управляющий получает ${law.fuPercent} % от вырученной суммы.` },
  { q: 'Как узнать, подходит ли мне банкротство?', a: 'Записаться на бесплатную устную консультацию. Разберу долги, доходы, имущество и сделки за 3 года и скажу, подходит ли вам банкротство и сколько оно будет стоить.' },
];
---

<Page
  title="Банкротство в рассрочку в Томске — без процентов"
  description={description}
  h1="Банкротство в рассрочку"
  eyebrow="Цены"
  crumbs={[{ name: 'Цены', href: '/yuridicheskie-uslugi/' }, { name: 'Рассрочка', href: url }]}
  faq={faq}
  faqTitle="Частые вопросы о рассрочке"
  topic="Банкротство в рассрочку"
  heroBg={heroBg}
  formTitle="Узнайте, подходит ли вам рассрочка"
  formText="Расскажите коротко о долгах. Перезвоню, договоримся о бесплатной консультации и назову цену и платёж в месяц."
  schema={[serviceSchema({ name: 'Банкротство гражданина в рассрочку', url, description, price: pricing.citizenInstallmentFrom, serviceType: 'Сопровождение банкротства гражданина с оплатой в рассрочку' })]}
  related={[
    { href: '/yuridicheskie-uslugi/', label: 'Стоимость услуг', text: 'Полный прайс юридических услуг.' },
    { href: '/bankrotstvo-fizicheskih-lic/', label: 'Банкротство физических лиц', text: 'Кому подходит, какие долги спишут, что сохранится.' },
    { href: '/konsultaciya-po-bankrotstvu/', label: 'Консультация', text: 'Устная — бесплатно, письменная — от 3 000 ₽.' },
  ]}
>
  <Fragment slot="lead">
    <p>{nb(`Сопровождение банкротства гражданина можно оплачивать частями — от ${rub(pricing.citizenInstallmentFrom)} в месяц. Без процентов и без банка`)}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Условия -->
    <LpSection id="usloviya" chip="Условия" title="Как устроена рассрочка" lead="Вы платите за юридическое сопровождение частями — напрямую, без кредита" bg="grey">
      <div class="lp-two">
        <div class="lp-card lp-blue">
          <p class="lp-k">Платёж в месяц</p>
          <p class="lp-big">от {rub(pricing.citizenInstallmentFrom)}</p>
          <p class="lp-t">{nb(`Сопровождение под ключ — от ${rub(pricing.citizenTurnkey)}: документы, суд и переписка с кредиторами до решения суда`)}</p>
          <a href="#zayavka" class="bl-btn">Бесплатная консультация</a>
        </div>
        <div class="lp-card">
          <p class="lp-k">Условия</p>
          <h3 class="lp-h3">Без процентов и без банка</h3>
          <ul class="lp-signs">
            {terms.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}
          </ul>
        </div>
      </div>
    </LpSection>

    <!-- Стоимость -->
    <HomePrice />



    <HomeReviews />
  </Fragment>
</Page>
