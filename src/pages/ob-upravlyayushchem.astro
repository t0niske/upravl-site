---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import Byline from '../components/Byline.astro';
import { person, contacts, cases, SITE_URL } from '../data/site';
import { personSchema, PERSON_ID } from '../data/schema';
import photo from '../assets/antonec.jpg';
import docMinjust from '../assets/doc-minjust-2003.jpg';
import docTipkia from '../assets/doc-tipkia-2016.jpg';
import docDexter from '../assets/doc-dexter-2018.jpg';

const profile = {
  '@type': 'ProfilePage',
  url: `${SITE_URL}/ob-upravlyayushchem/`,
  name: `${person.name} — арбитражный управляющий`,
  mainEntity: { '@id': PERSON_ID },
};

const registry: [string, string][] = [
  ['СРО арбитражных управляющих', person.sro],
  ['Регистрационный номер в реестре', person.registryNumber],
  ['ИНН', person.inn],
].filter(([, v]) => Boolean(v)) as [string, string][];

const docs = [
  { img: docMinjust, year: '2003', title: 'Свидетельство Минюста России', text: 'О сдаче теоретического экзамена по единой программе подготовки арбитражных управляющих. Серия АА № 002916, рег. № 34/002901, выдано 22.12.2003, Томск.', alt: 'Свидетельство Министерства юстиции РФ о сдаче теоретического экзамена по единой программе подготовки арбитражных управляющих на имя Антонца Ю. А., 2003 год' },
  { img: docTipkia, year: '2016', title: 'Удостоверение о повышении квалификации', text: '«Банкротство предприятий: изменения законодательства и арбитражная практика», 24 часа. ФГБОУ ДПО «Томский институт переподготовки кадров и агробизнеса», 16–19.11.2016.', alt: 'Удостоверение о повышении квалификации по программе «Банкротство предприятий: изменения законодательства и арбитражная практика», Томск, ноябрь 2016 года' },
  { img: docDexter, year: '2018', title: 'Свидетельство о повышении квалификации', text: 'Повышение уровня профессиональной подготовки арбитражных управляющих по законодательству о банкротстве, 24 академических часа. ООО «Декстер».', alt: 'Свидетельство ООО «Декстер» о повышении профессиональной подготовки арбитражных управляющих, 24 академических часа, 2018 год' },
];
---

<Base
  title="Антонец Юрий Анатольевич — арбитражный управляющий"
  description="Арбитражный управляющий в Томске с 1999 года: экзамен Минюста 2003 г., повышение квалификации, завершённые дела. Документы и контакты."
  crumbs={[{ name: 'Об управляющем', href: '/ob-upravlyayushchem/' }]}
  schema={[personSchema(), profile]}
>
  <section class="wrap grid gap-10 pt-6 md:grid-cols-[1fr_1.5fr] md:pt-10">
    <figure>
      <Image src={photo} alt="Юрий Анатольевич Антонец, арбитражный управляющий, портрет в деловом костюме" widths={[360, 600]} sizes="(min-width: 768px) 400px, 90vw" class="aspect-[4/5] w-full rounded-[18px] object-cover object-top" loading="eager" />
    </figure>
    <div>
      <p class="eyebrow">Арбитражный управляющий · Томск</p>
      <h1 class="mt-2">{person.name}</h1>
      <div class="prose-legal lead-answer mt-6">
        <p>
          Арбитражный управляющий из Томска. Работает в антикризисном управлении и банкротстве с {person.sinceYear} года,
          с {person.citizensSinceYear} года ведёт дела о банкротстве граждан. По собственным данным — {person.proceduresText} в нескольких регионах России.
        </p>
        <p>
          Консультирует граждан и предпринимателей, представляет должников, кредиторов и других участников дел о банкротстве в Арбитражном суде
          Томской области и судах общей юрисдикции.
        </p>
      </div>
      <Byline />
      {registry.length > 0 && (
        <dl class="mt-8 grid gap-3 sm:grid-cols-2">
          {registry.map(([k, v]) => <div class="card p-4"><dt class="text-sm text-muted">{k}</dt><dd class="font-medium">{v}</dd></div>)}
        </dl>
      )}
      {person.fedresursUrl && <p class="mt-4"><a href={person.fedresursUrl} rel="noopener" target="_blank">Карточка в Едином федеральном реестре сведений о банкротстве</a></p>}
    </div>
  </section>

  <section class="wrap mt-24" aria-labelledby="timeline-title">
    <h2 id="timeline-title">Профессиональный путь</h2>
    <ol class="mt-8 max-w-[46rem] border-l-2 border-line pl-6">
      {[
        ['1999', 'Сдал экзамен по программе обучения специалистов по антикризисному управлению ФСДН России (свидетельство № 7 от 04.03.1999, Томский политехнический университет). Начало работы в антикризисном управлении.'],
        ['2003', 'Сдал теоретический экзамен по единой программе подготовки арбитражных управляющих (Минюст России).'],
        [String(person.citizensSinceYear), 'Начал вести процедуры банкротства граждан — через год после вступления в силу главы X закона о банкротстве.'],
        ['2016', 'Повышение квалификации «Банкротство предприятий: изменения законодательства и арбитражная практика».'],
        ['2018', 'Повышение профессиональной подготовки арбитражных управляющих.'],
        ['2017–2022', `Завершённые дела граждан с освобождением от долгов — ${cases.length} из них опубликованы на сайте с номерами.`],
      ].map(([y, t]) => (
        <li class="relative pb-7 last:pb-0">
          <span class="absolute -left-[1.95rem] top-2 h-2.5 w-2.5 rounded-full border-2 border-paper bg-ink-2" aria-hidden="true"></span>
          <p class="font-mono text-[0.875rem] text-muted tnum">{y}</p>
          <p class="mt-1 text-ink-2">{t}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6"><a href="/dela/">Посмотреть завершённые дела</a></p>
  </section>

  <section class="wrap mt-24" aria-labelledby="docs-title">
    <h2 id="docs-title">Документы о квалификации</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {docs.map((d) => (
        <li>
          <article class="h-full overflow-hidden rounded-[14px] border border-line bg-card">
            <a href={d.img.src} target="_blank" rel="noopener" aria-label={`Открыть: ${d.title}, ${d.year}`}>
              <Image src={d.img} alt={d.alt} widths={[400, 800]} sizes="(min-width: 768px) 360px, 90vw" class="aspect-[4/3] w-full bg-paper-2 object-contain p-3" />
            </a>
            <div class="p-5">
              <p class="font-mono text-[0.8125rem] text-muted">{d.year}</p>
              <h3 class="mt-1 font-sans text-base font-medium">{d.title}</h3>
              <p class="mt-2 text-[0.95rem] text-muted">{d.text}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap mt-24" aria-labelledby="principles-title">
    <div class="prose-legal">
      <h2 id="principles-title">Как я работаю</h2>
      <ul>
        <li><strong>Сначала — стоит ли вообще.</strong> Если банкротство не нужно или опасно из-за сделок, говорю об этом на первой консультации.</li>
        <li><strong>Без посредников.</strong> Вы общаетесь с практикующим арбитражным управляющим, а не с менеджером колл-центра.</li>
        <li><strong>Цена до начала работы.</strong> Гонорар и обязательные расходы называю заранее и фиксирую в договоре.</li>
        <li><strong>Конфиденциальность.</strong> Сведения о долгах и семье используются только в вашем деле.</li>
      </ul>
      <p>Офис: {contacts.addressFull}. Приём {contacts.hours.toLowerCase()}.</p>
    </div>
  </section>

  <div class="mt-24"><LeadForm /></div>
</Base>
