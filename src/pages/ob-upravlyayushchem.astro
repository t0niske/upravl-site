---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import LpSection from '../components/LpSection.astro';
import HomeCases from '../components/HomeCases.astro';
import HomeReviews from '../components/HomeReviews.astro';
import Steps from '../components/Steps.astro';
import Lawyer from '../components/Lawyer.astro';
import { nb } from '../data/typo';
import { person, contacts, heroStats, pricing, SITE_URL } from '../data/site';
import { personSchema, PERSON_ID } from '../data/schema';
import docTgu from '../assets/doc-diploma-tgu-1992.jpg';
import doc1999 from '../assets/doc-fsdn-1999.jpg';
import docTusur from '../assets/doc-diploma-tusur-2007.jpg';
import docMinjust from '../assets/doc-minjust-2003.jpg';
import docTipkia from '../assets/doc-tipkia-2016.jpg';
import docDexter from '../assets/doc-dexter-2018.jpg';
import mapImg from '../assets/map/regions.svg';
import officeImg from '../assets/photos/office.jpg';
import '../styles/lp.css';

const url = '/ob-upravlyayushchem/';
const description = 'Антонец Юрий Анатольевич — арбитражный управляющий в Томске с 1999 года: 250+ процедур, экзамен Минюста 2003 г., документы и реестр.';
const profile = {
  '@type': 'ProfilePage',
  url: `${SITE_URL}${url}`,
  name: `${person.name} — арбитражный управляющий`,
  mainEntity: { '@id': PERSON_ID },
};


// Профессиональный путь — линейная шкала; тексты из прежнего списка и дипломов
const path = [
  { year: '1992', title: 'Юридическое образование', text: 'Томский государственный университет, «Правоведение», квалификация — юрист' },
  { year: '1999', title: 'Антикризисное управление', text: 'Экзамен по программе обучения специалистов по антикризисному управлению ФСДН России' },
  { year: '2003', title: 'Арбитражный управляющий', text: 'Теоретический экзамен по единой программе подготовки арбитражных управляющих (Минюст России)' },
  { year: '2007', title: 'Экономическое образование', text: 'ТУСУР, «Финансы и кредит», квалификация — экономист' },
  { year: String(person.citizensSinceYear), title: 'Банкротство граждан', text: 'Начал вести процедуры банкротства граждан — через год после вступления в силу главы X закона о банкротстве' },
  { year: 'Ежегодно', title: 'Обучение', text: 'Повышение квалификации в 2016 и 2018 годах, ежегодно — при СРО' },
];

const docs = [
  { img: docTgu, year: '1992', title: 'Диплом юриста', text: 'Томский государственный университет им. В. В. Куйбышева, специальность «Правоведение». УВ № 094320', alt: 'Диплом Томского государственного университета по специальности «Правоведение», квалификация юрист, 1992 год' },
  { img: doc1999, year: '1999', title: 'Свидетельство ФСДН России', text: 'О сдаче экзамена по программе обучения специалистов по антикризисному управлению, № 7 от 04.03.1999', alt: 'Свидетельство ФСДН России о сдаче экзамена по антикризисному управлению, 1999 год' },
  { img: docMinjust, year: '2003', title: 'Свидетельство Минюста России', text: 'О сдаче теоретического экзамена по единой программе подготовки арбитражных управляющих. Серия АА № 002916, выдано 22.12.2003', alt: 'Свидетельство Министерства юстиции РФ о сдаче теоретического экзамена по единой программе подготовки арбитражных управляющих, 2003 год' },
  { img: docTusur, year: '2007', title: 'Диплом экономиста', text: 'Томский государственный университет систем управления и радиоэлектроники, специальность «Финансы и кредит». ВСГ 1863152', alt: 'Диплом ТУСУР по специальности «Финансы и кредит», квалификация экономист, 2007 год' },
  { img: docTipkia, year: '2016', title: 'Удостоверение о повышении квалификации', text: '«Банкротство предприятий: изменения законодательства и арбитражная практика», 24 часа, 16–19.11.2016', alt: 'Удостоверение о повышении квалификации, Томск, ноябрь 2016 года' },
  { img: docDexter, year: '2018', title: 'Свидетельство о повышении квалификации', text: 'Повышение уровня профессиональной подготовки арбитражных управляющих, 24 академических часа, ООО «Декстер»', alt: 'Свидетельство ООО «Декстер» о повышении профессиональной подготовки арбитражных управляющих, 2018 год' },
];

// «Как я работаю» — этапами; тексты прежние, в ярлыках — когда это происходит
const checkRows: [string, string][] = [
  ['СРО', person.sro],
  ['Номер в сводном реестре', person.registryNumber],
  ['ИНН', person.inn],
];

const faq = [
  { q: 'Как проверить арбитражного управляющего?', a: `По ИНН ${person.inn} или номеру ${person.registryNumber} в сводном реестре арбитражных управляющих — сведения публикуются в Едином федеральном реестре сведений о банкротстве. Я состою в ${person.sro}.` },
  { q: 'В каких регионах вы ведёте дела?', a: 'В Томской, Новосибирской и Кемеровской областях, Алтайском и Краснодарском краях. Из других городов можно проконсультироваться онлайн.' },
  { q: 'Можно ли проконсультироваться онлайн?', a: `Да, в Telegram или WhatsApp — без поездки в офис. Устная консультация — ${pricing.consultation}.` },
  { q: 'Кто будет консультировать и вести дело?', a: 'Я сам — консультирую и веду дело лично.' },
  { q: 'Какое у вас образование?', a: 'Два высших: юридическое — Томский государственный университет, 1992 год, и экономическое — ТУСУР, 2007 год. Экзамен арбитражного управляющего сдал в 2003 году, каждый год повышаю квалификацию при СРО.' },
  { q: 'Где находится офис?', a: `${contacts.addressFull}. Приём ${contacts.hours.toLowerCase()}.` },
];

const principles = [
  { title: 'Сначала — стоит ли вообще', time: 'первая консультация', text: 'Если банкротство не нужно или опасно из-за сделок, говорю об этом на первой консультации' },
  { title: 'Цена до начала работы', time: 'в договоре', text: 'Гонорар и обязательные расходы называю заранее и фиксирую в договоре' },
  { title: 'Без посредников', time: 'всё дело', text: 'Вы общаетесь с практикующим арбитражным управляющим, а не с менеджером колл-центра' },
  { title: 'Конфиденциальность', time: 'долги и семья', text: 'Сведения о долгах и семье используются только в вашем деле' },
];
---

<Page
  title="Антонец Юрий Анатольевич — арбитражный управляющий"
  description={description}
  h1={person.name}
  eyebrow="Арбитражный управляющий · Томск"
  crumbs={[{ name: 'Обо мне', href: url }]}
  heroStats={[
    { icon: 'scales', value: heroStats.years, label: heroStats.yearsLabel },
    { icon: 'folder', value: '250+', label: 'процедур банкротства' },
    { icon: 'ruble', value: heroStats.written, label: heroStats.writtenLabel },
  ]}
  topic="Консультация"
  faq={faq}
  faqTitle="Частые вопросы об управляющем"
  heroPortrait
  schema={[personSchema(), profile]}
>
  <Fragment slot="lead">
    <p>{nb('Арбитражный управляющий из Томска. Консультирую граждан и предпринимателей, представляю должников, кредиторов и других участников дел о банкротстве в арбитражных судах и судах общей юрисдикции')}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Профессиональный путь -->
    <LpSection id="put" chip="Путь" title="Профессиональный путь">
      <ol class="tl">
        {path.map((p) => (
          <li class="tl-i">
            <span class="tl-y tnum">{p.year}</span>
            <span class="tl-mark" aria-hidden="true"><i></i></span>
            <h3 class="tl-h">{nb(p.title)}</h3>
            <p class="tl-t">{nb(p.text)}</p>
          </li>
        ))}
      </ol>
    </LpSection>

    <!-- Документы -->
    <LpSection id="dokumenty" chip="Документы" title="Документы о квалификации" lead="Дипломы, свидетельства о сдаче экзаменов и повышении квалификации. Скан можно открыть в полном размере" bg="grey">
      <ul class="dc">
        {docs.map((d) => (
          <li>
            <a href={d.img.src} target="_blank" rel="noopener" class="dc-card" aria-label={`Открыть скан: ${d.title}, ${d.year}`}>
              <span class="dc-scan"><Image src={d.img} alt={d.alt} widths={[320, 640]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw" class="dc-img" loading="lazy" /></span>
              <span class="bz-n tnum">{d.year}</span>
              <span class="dc-h">{nb(d.title)}</span>
              <span class="bz-t">{nb(d.text)}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="ck">
        <p class="ck-k">Сведения в реестре арбитражных управляющих</p>
        <dl class="ck-dl">
        {checkRows.map(([k, v]) => <div><dt>{nb(k)}</dt><dd class="tnum">{nb(v)}</dd></div>)}
        </dl>
        <p class="ck-t">{nb('По ИНН или номеру в реестре сведения об арбитражном управляющем можно найти в Едином федеральном реестре сведений о банкротстве')}</p>
      </div>
    </LpSection>

    <!-- География -->
    <section id="geografiya" class="ky" aria-labelledby="kto-ya-title">
      <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
        <div class="ky-top">
          <div class="ky-text">
            <span class="ky-chip"><span class="ky-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>География</span>
            <h2 id="kto-ya-title" class="ky-title">{nb('Где я веду дела')}</h2>
            <p class="ky-regions">Помогаю гражданам и&nbsp;компаниям с&nbsp;банкротством в&nbsp;Сибири и&nbsp;на&nbsp;юге России&nbsp;— в&nbsp;<b>Томской</b>, <b>Новосибирской</b> и&nbsp;<b>Кемеровской</b> областях, <b>Алтайском</b> и&nbsp;<b>Краснодарском</b> краях</p>
            <div class="ky-online">
              <p class="ky-online-k">Онлайн-консультация</p>
              <p class="ky-online-t">{nb('Консультирую в Telegram и WhatsApp — без поездки в офис')}</p>
              <a href="#zayavka" class="bl-btn">Записаться на консультацию</a>
            </div>
          </div>
          <figure class="ky-map">
            <img src={mapImg.src} width={mapImg.width} height={mapImg.height} alt="Карта России: Томская, Кемеровская, Новосибирская области, Алтайский и Краснодарский края" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>






    <HomeCases />

    <HomeReviews />

    <!-- Кто ведёт дело — тот же блок, что на страницах услуг -->
    <Lawyer />

    <!-- Подход -->
    <LpSection id="podhod" chip="Подход" title="Чем мой подход отличается" lead="Консультирую сам — в офисе в Томске или онлайн. Цену называю до начала работы и фиксирую в договоре" bg="grey">
      <div class="lp-two">
        <div class="lp-card lp-blue">
          <p class="lp-k">Моя задача</p>
          <p class="lp-h3 pa-h-w">{nb('Законно списать долги — или честно сказать, что банкротство не нужно')}</p>
          <p class="lp-t">{nb('Если банкротство вам не подходит или опасно из-за сделок, говорю об этом на первой консультации')}</p>
          <a href="#zayavka" class="bl-btn">Бесплатная консультация</a>
        </div>
        <div class="lp-card">
          <p class="lp-k">Главное преимущество</p>
          <p class="lp-h3">{nb('Дело ведёт арбитражный управляющий, а не посредник')}</p>
          <p class="lp-t is-dark">{nb(`Экзамен арбитражного управляющего сдал в 2003 году, провёл ${person.proceduresText} в пяти регионах`)}</p>
        </div>
      </div>
    </LpSection>

    <!-- Как работаю -->
    <Steps id="kak-rabotayu" chip="Как работаю" titleA="Как я работаю" titleB="" steps={principles} note="" noteLink={false} bg="white" />

    <!-- Офис и связь -->
    <LpSection id="ofis" chip="Офис" title="Офис и связь" bg="grey">
      <div class="of">
        <Image src={officeImg} alt="Кабинет арбитражного управляющего Антонца в офисе на ул. Тверской, 14" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" class="of-img" loading="lazy" />
        <div class="lp-card of-card">
          <p class="lp-k">Адрес</p>
          <p class="of-v">{nb(`г. Томск, ${contacts.street}`).replace(', оф.', ', оф.')}</p>
          <a href={contacts.yandexMapsUrl} target="_blank" rel="noopener" class="of-link">Открыть на карте</a>
          <p class="lp-k of-gap">Приём</p>
          <p class="of-v">{contacts.hoursDays}</p>
          <p class="of-s">{contacts.hoursNote}</p>
          <p class="lp-k of-gap">Телефоны</p>
          <p class="of-v"><a href={contacts.phoneHref} class="tnum">{contacts.phone}</a><br /><a href={contacts.phone2Href} class="tnum">{contacts.phone2}</a></p>
          <p class="of-s">{nb('Онлайн-консультация — в Telegram или WhatsApp')}</p>
          <a href="#zayavka" class="lp-btn is-bottom of-btn">Записаться на консультацию</a>
        </div>
      </div>
    </LpSection>

  </Fragment>
</Page>

<style>
  .ky { padding: clamp(2.5rem, 4vw, 3.5rem) 0; background: #fff; }
  .ky-top { display: grid; gap: clamp(1.5rem, 3vw, 3rem); }
  @media (min-width: 1024px) { .ky-top { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; } }
  .ky-chip { display: inline-flex; align-items: center; gap: 0.75rem; margin-bottom: clamp(1.25rem, 2vw, 1.75rem); padding: 0.625rem 1.125rem; border-radius: 8px; background: #f3f4f6; font-size: clamp(1rem, 1.1vw, 1.1875rem); line-height: 1.2; color: #1d1e21; }
  .ky-sq { display: grid; grid-template-columns: 5px 5px; grid-auto-rows: 5px; gap: 2px; }
  .ky-sq i { width: 5px; height: 5px; border-radius: 1px; background: #034b8e; }
  .ky-title { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.08; letter-spacing: -0.025em; color: #1d1e21; text-wrap: pretty; }
  .ky-regions { margin-top: 1rem; font-size: var(--fs-lead); line-height: 1.45; color: #1d1e21; text-wrap: pretty; }
  .ky-regions b { font-weight: 600; color: #034b8e; }
  .ky-online { margin-top: clamp(1.5rem, 2.4vw, 2rem); padding: clamp(1.25rem, 2vw, 1.75rem); border-radius: 18px; background: linear-gradient(135deg, #034b8e 0%, #053a6e 60%, #0b1a30 100%); color: #fff; }
  .ky-online-k { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h3); line-height: 1.15; }
  .ky-online-t { margin-top: 0.625rem; margin-bottom: 1.25rem; font-size: var(--fs-body); line-height: 1.45; color: rgb(255 255 255 / 0.88); text-wrap: pretty; }
  @media (max-width: 639px) { .ky-online .bl-btn { width: 100%; } }
  .ky-map { margin: 0; }
  .ky-map img { display: block; width: 100%; height: auto; }

  /* Путь: на телефоне — вертикальная шкала слева, с 1024px — горизонтальная */
  .tl { --gap: clamp(2rem, 3.5vw, 4rem); position: relative; display: grid; }
  .tl-i { position: relative; display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); column-gap: 1rem; padding-bottom: 1.75rem; }
  .tl-i:last-child { padding-bottom: 0; }
  .tl-i::before { content: ''; position: absolute; left: calc(0.75rem - 1px); top: 0.6rem; bottom: -0.6rem; width: 2px; background: #c9d6e6; }
  .tl-i:last-child::before { display: none; }
  .tl-mark { grid-column: 1; grid-row: 1; display: grid; place-items: start center; padding-top: 0.35rem; }
  .tl-mark i { position: relative; z-index: 1; width: 0.875rem; height: 0.875rem; border-radius: 50%; background: #034b8e; box-shadow: 0 0 0 4px #fff; }
  .tl-y, .tl-h, .tl-t { grid-column: 2; }
  .tl-y { grid-row: 1; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 2.2vw, 2.25rem); line-height: 1; letter-spacing: -0.02em; color: #034b8e; }
  .tl-h { margin-top: 0.625rem; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -0.015em; color: #1d1e21; }
  .tl-t { margin-top: 0.625rem; font-size: var(--fs-body); line-height: 1.45; color: #5f646d; text-wrap: pretty; }
  @media (min-width: 1024px) {
    .tl { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gap); row-gap: clamp(2.5rem, 4vw, 3.5rem); }
    .tl-i { display: flex; flex-direction: column; padding-bottom: 0; }
    .tl-i::before { display: none; }
    .tl-mark { position: relative; display: flex; justify-content: flex-start; align-items: center; height: 0.875rem; margin: 1rem 0 1.25rem; padding: 0; }
    .tl-mark::before { content: ''; position: absolute; left: 0; right: calc(-1 * var(--gap)); top: calc(50% - 1px); height: 2px; background: #c9d6e6; }
    .tl-i:nth-child(3n) .tl-mark::before { right: 0; background: linear-gradient(90deg, #c9d6e6, transparent); }
    .tl-t { max-width: 26rem; }
    .tl-mark i { position: relative; display: block; }
    .tl-y { order: -1; }
    .tl-h { margin-top: 0; }
  }

  .pa-h-w { color: #fff; }
  .ck { margin-top: clamp(0.75rem, 1.4vw, 1.25rem); padding: clamp(1.25rem, 2vw, 1.75rem); border-radius: 18px; background: linear-gradient(135deg, #034b8e 0%, #053a6e 60%, #0b1a30 100%); color: #fff; }
  .ck-k { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h3); line-height: 1.15; }
  .ck-dl { display: grid; gap: 1rem 2rem; margin-top: 1rem; }
  @media (min-width: 768px) { .ck-dl { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr); } }
  .ck-dl > div { padding-top: 0.875rem; border-top: 1px solid rgb(255 255 255 / 0.18); }
  .ck-dl dt { font-size: 0.9375rem; line-height: 1.35; color: rgb(255 255 255 / 0.7); }
  .ck-dl dd { margin-top: 0.375rem; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.125rem, 1.4vw, 1.375rem); line-height: 1.25; }
  .ck-t { margin-top: 1rem; font-size: 0.9375rem; line-height: 1.45; color: rgb(255 255 255 / 0.75); }

  .of { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 1024px) { .of { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  .of-img { display: block; width: 100%; height: 100%; min-height: 18rem; object-fit: cover; border-radius: 18px; }
  .of-v { margin-top: 0.375rem; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.3; color: #1d1e21; }
  .of-v a { color: inherit; text-decoration: none; }
  .of-v a:hover { color: #034b8e; }
  .of-s { margin-top: 0.375rem; font-size: var(--fs-body); line-height: 1.45; color: #5f646d; }
  .of-gap { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid rgb(29 30 33 / 0.1); }
  .of-link { display: inline-block; margin-top: 0.5rem; font-size: var(--fs-body); color: #034b8e; }
  .of-btn { margin-top: 1.75rem; }



  .dc { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 640px) { .dc { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .dc { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
