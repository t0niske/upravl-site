---
import Page from '../../layouts/Page.astro';
import { law, rub } from '../../data/site';
import { articleSchema } from '../../data/schema';

const url = '/stati/mify-o-bankrotstve-grazhdan/';
const title = '10 мифов о банкротстве граждан: что правда';
const description = 'Спишут ли все долги, заберут ли зарплату и квартиру, возьмут ли на работу и дадут ли кредит после банкротства. Разбор по закону в редакции 2026 года.';

const myths = [
  {
    myth: 'Спишут только один кредит, остальные придётся платить',
    verdict: 'Миф',
    text: 'Процедура охватывает все долги на дату заявления: кредиты, микрозаймы, налоги, ЖКХ, займы по распискам, в том числе уже взысканные судом. Исключения — алименты, возмещение вреда здоровью, долги по зарплате перед работниками и субсидиарная ответственность.',
  },
  {
    myth: 'Долги спишут сразу после признания банкротом',
    verdict: 'Миф',
    text: `Признание банкротом — начало реализации имущества, а не конец. Процедура длится от ${law.realizationMonths} месяцев: управляющий проверяет имущество и сделки, кредиторы заявляют требования. Освобождение от долгов суд объявляет только при завершении — и может отказать недобросовестному должнику.`,
  },
  {
    myth: 'На все заседания нужно ходить лично',
    verdict: 'Миф',
    text: 'Закон не требует личного присутствия должника. Интересы представляет юрист, документы передаются заранее. Суд может вызвать должника, если появятся вопросы — например, о происхождении денег или сделках.',
  },
  {
    myth: 'Финансовый управляющий забирает всю зарплату',
    verdict: 'Миф',
    text: 'Управляющий получает доходы должника на специальный счёт и каждый месяц выдаёт сумму не меньше прожиточного минимума на должника и иждивенцев. Его вознаграждение фиксировано законом и вносится заранее на депозит суда.',
  },
  {
    myth: 'Придётся продать всё имущество',
    verdict: 'Миф',
    text: 'Единственное жильё не в ипотеке, предметы обихода, вещи, имущество для работы до 100 МРОТ защищены ст. 446 ГПК. Продают то, что сверх этого: второе жильё, автомобиль, доли, ценные вещи.',
  },
  {
    myth: 'Без юриста банкротство дешевле',
    verdict: 'Правда, но с оговорками',
    text: `Гонорар юриста можно сэкономить, обязательные ${rub(law.fuDeposit)} на депозит и публикации — нет. Ошибки в заявлении и списке кредиторов приводят к возврату заявления, а неосторожные сделки до подачи — к отказу в списании. Экономия оправдана в простых делах без имущества и сделок.`,
  },
  {
    myth: 'Банкрота не возьмут на работу',
    verdict: 'Миф',
    text: 'Запрет касается только руководящих должностей: 3 года — в любых организациях, 5 лет — в страховых, МФО, фондах, 10 лет — в банках. Работать по найму можно, а сам по себе статус банкрота не входит в основания для увольнения по Трудовому кодексу.',
  },
  {
    myth: 'Коллекторы не отстанут и после списания',
    verdict: 'Частично правда',
    text: 'После введения процедуры кредиторы и коллекторы не вправе взыскивать долг напрямую. Если звонки продолжаются, достаточно сообщить номер дела; при повторении — жалоба в ФССП, которая надзирает за коллекторами. После списания требовать списанный долг незаконно.',
  },
  {
    myth: 'После банкротства кредит не дадут никогда',
    verdict: 'Миф',
    text: '5 лет при оформлении кредита нужно сообщать о банкротстве — решение остаётся за банком. Отказывать автоматически закон не обязывает. Кредитная история после процедуры начинается с чистого листа, и её можно восстановить.',
  },
  {
    myth: 'После банкротства нельзя вести бизнес',
    verdict: 'Частично правда',
    text: 'Зарегистрироваться ИП снова можно через 5 лет, руководить ООО — через 3 года. Быть участником ООО без руководящей должности и работать самозанятым можно сразу.',
  },
];

const faq = [
  { q: 'Что будет с долгами, если банкротство не завершится?', a: 'Если суд прекратит дело или откажет в освобождении от долгов, кредиторы смогут снова взыскивать их, в том числе через приставов. Поэтому главное — честно раскрыть управляющему имущество и доходы.' },
];
---

<Page
  title={title}
  description={description}
  h1="10 мифов о банкротстве граждан — и что на самом деле"
  eyebrow="Статья"
  crumbs={[{ name: 'Статьи', href: '/stati/' }, { name: 'Мифы о банкротстве', href: url }]}
  published="2020-01-23"
  ogType="article"
  faq={faq}
  topic="Статья: мифы о банкротстве"
  schema={[articleSchema({ title, url, description, published: '2020-01-23' })]}
  related={[
    { href: '/bankrotstvo-fizicheskih-lic/', label: 'Банкротство физических лиц', text: 'Условия, порядок, стоимость под ключ.' },
    { href: '/bankrotstvo-fizicheskih-lic/cherez-mfc/', label: 'Через МФЦ', text: 'Бесплатная процедура при долге до 1 млн ₽.' },
    { href: '/stati/kto-takoj-arbitrazhnyj-upravlyayushchij/', label: 'Кто такой арбитражный управляющий', text: 'Кто ведёт процедуру и кто ему платит.' },
  ]}
>
  <Fragment slot="lead">
    <p>
      Банкротство граждан работает в России с 1 октября 2015 года, но вокруг него до сих пор много страхов. Ниже — десять самых частых,
      с ответом по закону в действующей редакции: где правда, где миф, где «зависит».
    </p>
  </Fragment>

  <p class="text-sm text-muted">Обновлено в ноябре 2026: учтены внесудебное банкротство через МФЦ и изменения в порядке внесения депозита; убраны устаревшие сведения о законопроектах 2019 года.</p>

  {myths.map((m, i) => (
    <section class="not-prose mt-8 border-t border-line pt-6">
      <h2 class="text-[1.35rem]">{i + 1}. «{m.myth}»</h2>
      <p class:list={['mt-2 inline-block rounded px-2 py-0.5 text-sm font-medium', m.verdict === 'Миф' ? 'bg-[#e6f0ea] text-ok' : 'bg-[#f6ead6] text-warn']}>{m.verdict}</p>
      <p class="mt-3">{m.text}</p>
    </section>
  ))}
</Page>
