---
import Page from '../layouts/Page.astro';
import LpSection from '../components/LpSection.astro';
import Lawyer from '../components/Lawyer.astro';
import HomeReviews from '../components/HomeReviews.astro';
import { nb } from '../data/typo';
import { law, rub, pricing } from '../data/site';
import { docs } from '../data/docs';
import { priceGroups } from '../data/prices';
import { serviceSchema } from '../data/schema';
import heroBg from '../assets/dokumenty/hero-bg.jpg';
import '../styles/lp.css';

const url = '/podgotovka-dokumentov-na-bankrotstvo/';
const description = 'Подготовка документов на банкротство в Томске: заявление о признании банкротом и список кредиторов — от 12 000 ₽. Помогу собрать справки.';

// Что делаю
const work: [string, string][] = [
  ['Проверяю, подходит ли банкротство', 'смотрю долги, доходы, имущество и сделки за 3 года'],
  ['Составляю список документов', 'под вашу ситуацию: большую часть можно заказать через Госуслуги'],
  ['Пишу заявление о признании банкротом', 'с описанием долгов и имущества'],
  ['Составляю список кредиторов', 'кто, по какому договору и сколько'],
];
// Цены — строки прайса (src/data/prices.ts)
const rows = priceGroups.find((g) => g.id === 'bankrotstvo')!.rows.slice(0, 3);

const faq = [
  {
    q: 'Сколько стоит подготовка заявления о банкротстве?',
    a: 'Заявление о признании гражданина банкротом — от 12 000 ₽. Если нужен ещё и суд, представительство стоит от 5 000 ₽ за заседание, а сопровождение под ключ — от 125 000 ₽.',
  },
  {
    q: 'Где взять справки и выписки?',
    a: 'Большую часть документов можно заказать через Госуслуги: сведения о трудовой деятельности, выписку из Социального фонда, выписку из ЕГРН. Выписки по счетам дают банки. С остальным помогу.',
  },
  {
    q: 'Какие расходы будут кроме оплаты юриста?',
    a: `Закон требует внести ${rub(law.fuDeposit)} на депозит суда для вознаграждения финансового управляющего и оплатить публикации в ЕФРСБ и «Коммерсанте». Эти суммы платит любой заявитель.`,
  },
  {
    q: 'За какой период нужны справки и выписки?',
    a: 'За 3 года: справки о доходах, выписки по банковским счетам и картам, документы о сделках с имуществом. Этот же срок финансовый управляющий проверяет в деле.',
  },
  {
    q: 'Зачем разбирать сделки до подачи заявления?',
    a: 'Финансовый управляющий обязан проверить сделки за 3 года до принятия заявления. Если сделка навредила кредиторам, её признают недействительной, а имущество вернут в конкурсную массу. Позицию по сделкам лучше подготовить заранее.',
  },
];
---

<Page
  title="Подготовка документов на банкротство в Томске"
  description={description}
  h1="Подготовка документов на банкротство"
  eyebrow="Для граждан"
  crumbs={[{ name: 'Подготовка документов', href: url }]}
  facts={[
    ['Заявление о банкротстве', 'от 12 000 ₽'],
    ['Договор или другой документ', 'от 3 000 ₽'],
    ['Депозит управляющему', rub(law.fuDeposit)],
    ['Сопровождение под ключ', `от ${rub(pricing.citizenTurnkey)}`],
  ]}
  faq={faq}
  topic="Подготовка документов на банкротство"
  expert
  heroBg={heroBg}
  formTitle="Подготовлю заявление о банкротстве"
  formText="Расскажите коротко о долгах и имуществе. Скажу, какие документы собрать, и подготовлю заявление и список кредиторов."
  schema={[serviceSchema({ name: 'Подготовка документов на банкротство гражданина', url, description, price: 12000, serviceType: 'Составление заявления о признании гражданина банкротом' })]}
  related={[
    { href: '/bankrotstvo-fizicheskih-lic/', label: 'Банкротство физических лиц', text: 'Кому подходит, какие долги спишут, что сохранится.' },
    { href: '/predstavitelstvo-v-dele-o-bankrotstve/', label: 'Представление интересов в суде', text: 'Заседания в Арбитражном суде Томской области.' },
    { href: '/konsultaciya-po-bankrotstvu/', label: 'Консультация', text: 'Устная — бесплатно, письменная — от 3 000 ₽.' },
  ]}
>
  <Fragment slot="lead">
    <p>{nb('Составлю заявление о признании банкротом и список кредиторов, подскажу, какие справки собрать. Большую часть можно заказать через Госуслуги')}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Какие документы -->
    <LpSection id="dokumenty" chip="Документы" title="Какие документы понадобятся" lead="Полный список зависит от ситуации, базовый набор — такой. Большую часть можно заказать через Госуслуги, с остальным помогу" bg="grey">
      <ol class="dc-grid">
        {docs.map((t, i) => <li><span class="dc-n tnum">{String(i + 1).padStart(2, '0')}</span><span>{nb(t)}</span></li>)}
      </ol>
    </LpSection>

    <!-- Что делаю -->
    <LpSection id="chto-delayu" chip="Что делаю" title="Что входит в подготовку документов" lead="От проверки ситуации до готового заявления в суд">
      <div class="sd-wrap">
        <div class="sd-card">
          <p class="sd-num">от 12 000 ₽</p>
          <p class="sd-cap">{nb('заявление о признании гражданина банкротом')}</p>
          <p class="sd-note">{nb('Сделки за последние три года разбираем до подачи заявления: финансовый управляющий обязан их проверить, и позицию лучше подготовить заранее')}</p>
          <a href="#zayavka" class="lp-btn sd-btn">Заказать заявление</a>
        </div>
        <ol class="sd-list">
          {work.map(([h, t], i) => <li><span class="sd-n tnum">[{String(i + 1).padStart(2, '0')}]</span><span><b>{nb(h)}.</b> {nb(t.charAt(0).toUpperCase() + t.slice(1))}</span></li>)}
        </ol>
      </div>
    </LpSection>

    <!-- Кто готовит -->
    <Lawyer />

    <!-- Цены -->
    <LpSection id="ceny" chip="Цены" title="Сколько стоит подготовка документов" lead="Обязательные расходы — депозит 25 000 ₽ и публикации — оплачиваются отдельно" bg="grey">
      <section class="pr-card" aria-labelledby="doc-h">
        <div>
          <h3 id="doc-h" class="pr-h">Цены на услуги по банкротству</h3>
          <p class="pr-t">{nb('Цена «от» — минимальная стоимость простого дела. Итоговую называю до начала работы и фиксирую в договоре')}</p>
        </div>
        <ul>
          {rows.map((r) => (
            <li class="pr-row">
              <span class="pr-s">{nb(r.service)}{r.note && <span class="pr-note">{nb(r.note)}</span>}</span>
              <span class="pr-p tnum">{r.price}</span>
            </li>
          ))}
        </ul>
      </section>
    </LpSection>

    <HomeReviews />
  </Fragment>
</Page>

<style>
  .dc-grid { display: grid; gap: clamp(0.5rem, 1vw, 0.75rem); }
  @media (min-width: 768px) { .dc-grid { grid-template-columns: 1fr 1fr; } }
  .dc-grid li { display: grid; grid-template-columns: 1.75rem minmax(0, 1fr); gap: 0.75rem; align-items: center; padding: 1.125rem 1.25rem; border-radius: 14px; background: #fff; font-size: var(--fs-body); line-height: 1.45; color: #2a2d33; }
  .dc-n { font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; color: #034b8e; }
</style>
