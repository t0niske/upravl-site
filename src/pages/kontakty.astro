---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import LpSection from '../components/LpSection.astro';
import { nb } from '../data/typo';
import { contacts, SITE_URL } from '../data/site';
import { ORG_ID } from '../data/schema';
import officeImg from '../assets/photos/office.jpg';
import '../styles/lp.css';

/**
 * «Контакты» блоками (25.11.2026). Тексты — с прежней страницы и из данных сайта; мессенджеры без ссылок,
 * пока в contacts не заданы адреса (кнопки шапки ведут сюда же).
 */
const url = '/kontakty/';
const contactPage = { '@type': 'ContactPage', url: `${SITE_URL}${url}`, name: 'Контакты', about: { '@id': ORG_ID } };
const address = nb(`г. Томск, ${contacts.street}`).replace(', оф.', ', оф.');

const bring = [
  'Паспорт',
  'Кредитные договоры',
  'Требования банков',
  'Постановления приставов',
];
---

<Page
  title="Контакты арбитражного управляющего в Томске"
  description={`Офис: г. Томск, ${contacts.street}. Телефоны ${contacts.phone}, ${contacts.phone2}. Первая консультация по банкротству — бесплатно, по предварительной записи.`}
  h1="Контакты"
  eyebrow="Томск"
  crumbs={[{ name: 'Контакты', href: url }]}
  topic="Консультация"
  blog={false}
  formSolo
  ctaLabel="Записаться на консультацию"
  schema={[contactPage]}
  formTitle="Запишитесь на бесплатную консультацию"
  formText="Оставьте телефон — перезвоню и договоримся о времени встречи в офисе или онлайн."
>
  <Fragment slot="lead">
    <p>{nb('Мой офис — в Томске, на ул. Тверской, 14. Консультация бесплатная, приём по предварительной записи: позвоните или оставьте заявку, и договоримся о времени')}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Офис -->
    <LpSection id="ofis" chip="Офис" title="Офис в Томске" bg="grey">
      <div class="of">
        <Image src={officeImg} alt="Кабинет арбитражного управляющего Антонца в офисе на ул. Тверской, 14" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" class="of-img" loading="eager" />
        <div class="lp-card of-card">
          <p class="lp-k">Адрес</p>
          <p class="of-v">{address}</p>
          <a href={contacts.yandexMapsUrl} target="_blank" rel="noopener" class="of-link">Открыть в Яндекс Картах</a>
          <p class="lp-k of-gap">Приём</p>
          <p class="of-v">{contacts.hoursDays}</p>
          <p class="of-s">{contacts.hoursNote}</p>
          <p class="lp-k of-gap">Телефоны</p>
          <p class="of-v"><a href={contacts.phoneHref} class="tnum">{contacts.phone}</a><br /><a href={contacts.phone2Href} class="tnum">{contacts.phone2}</a></p>
          <p class="lp-k of-gap">Почта</p>
          <p class="of-v"><a href={`mailto:${contacts.email}`}>{contacts.email}</a></p>
        </div>
      </div>
    </LpSection>

    <!-- Как подготовиться -->
    <LpSection id="vstrecha" chip="Встреча" title="Перед первой встречей">
      <div class="lp-two">
        <div class="lp-card">
          <p class="lp-k">Как добраться</p>
          <h3 class="lp-h3">{address}</h3>
          <p class="lp-t is-dark">{nb('Перед визитом позвоните, чтобы договориться о времени, — подскажу, как пройти')}</p>
          <a href={contacts.yandexMapsUrl} target="_blank" rel="noopener" class="lp-btn is-bottom ct-btn">Открыть в Яндекс Картах</a>
        </div>
        <div class="lp-card">
          <p class="lp-k">Что взять</p>
          <h3 class="lp-h3">Всё, что есть по долгам</h3>
          <ul class="lp-signs">
            {bring.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}
          </ul>
          <p class="lp-foot ct-foot">{nb('Если документов нет — приходите без них, разберёмся по кредитной истории')}</p>
        </div>
      </div>
      <a href="#zayavka" class="lp-strip">
        <span>{nb('Не в Томске? Консультирую и онлайн — в Telegram или WhatsApp. Оставьте заявку, и договоримся о времени')}</span>
        <span class="lp-arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
    </LpSection>
  </Fragment>
</Page>

<style>
  .of { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 1024px) { .of { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  .of-img { display: block; width: 100%; height: 100%; min-height: 18rem; object-fit: cover; border-radius: 18px; }
  .of-v { margin-top: 0.375rem; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.3; color: #1d1e21; overflow-wrap: anywhere; }
  .of-v a { color: inherit; text-decoration: none; }
  .of-v a:hover { color: #034b8e; }
  .of-s { margin-top: 0.375rem; font-size: var(--fs-body); line-height: 1.45; color: #5f646d; }
  .of-gap { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid rgb(29 30 33 / 0.1); }
  .of-link { display: inline-block; margin-top: 0.5rem; font-size: var(--fs-body); color: #034b8e; }
  .ct-btn { margin-top: 1.5rem; }
  .ct-foot { margin-top: 1.25rem; }
</style>
