---
import Page from '../layouts/Page.astro';
import LpSection from '../components/LpSection.astro';
import { nb } from '../data/typo';
import { contacts, SITE_URL } from '../data/site';
import { ORG_ID } from '../data/schema';
import '../styles/lp.css';

/**
 * «Контакты» (26.11.2026): офис — Яндекс Карта с карточкой адреса поверх (по референсу дизайнера),
 * под картой — полоса про онлайн-консультацию, внизу только форма заявки (formSolo).
 * Тексты — с прежней страницы и из данных сайта; мессенджеры без ссылок, пока в contacts не заданы адреса.
 */
const url = '/kontakty/';
const contactPage = { '@type': 'ContactPage', url: `${SITE_URL}${url}`, name: 'Контакты', about: { '@id': ORG_ID } };
const address = `г. Томск, ${contacts.street}`.replace(/(г\.|ул\.|д\.|оф\.) /g, '$1\u00a0').replace(', оф.', ',\u00a0оф.');
const { lat, lon } = contacts.geo;
const mapSrc = `https://yandex.ru/map-widget/v1/?ll=${lon},${lat}&z=17&pt=${lon},${lat},pm2blm`;
const routeUrl = `https://yandex.ru/maps/?rtext=~${lat},${lon}&rtt=auto`;
const ic = { // иконки дизайнера (Flaticon, font-marker / font-clock-three)
  pin: '<path d="M12,0A10.011,10.011,0,0,0,2,10c0,5.282,8.4,12.533,9.354,13.343l.646.546.646-.546C13.6,22.533,22,15.282,22,10A10.011,10.011,0,0,0,12,0Zm0,15a5,5,0,1,1,5-5A5.006,5.006,0,0,1,12,15Z"/><circle cx="12" cy="10" r="3"/>',
  clock: '<path d="M12,0C5.383,0,0,5.383,0,12s5.383,12,12,12,12-5.383,12-12S18.617,0,12,0Zm4,13h-4c-.552,0-1-.447-1-1V6c0-.553,.448-1,1-1s1,.447,1,1v5h3c.553,0,1,.447,1,1s-.447,1-1,1Z"/>',
  phone: '<path d="M13 1a1 1 0 0 1 1-1A10.01 10.01 0 0 1 24 10a1 1 0 0 1-2 0 8.01 8.01 0 0 0-8-8 1 1 0 0 1-1-1Zm1 5a4 4 0 0 1 4 4 1 1 0 0 0 2 0 6.01 6.01 0 0 0-6-6 1 1 0 0 0 0 2Zm9.09 10.74a3.1 3.1 0 0 1 0 4.38l-.91 1.05C14 30 -6 10 1.79 1.8l1.15-1a3.08 3.08 0 0 1 4.35.04c.03.03 1.88 2.43 1.88 2.43a3.1 3.1 0 0 1 0 4.28L8.02 9.03a12.8 12.8 0 0 0 6.95 6.96l1.47-1.17a3.1 3.1 0 0 1 4.28 0s2.4 1.85 2.43 1.88Z"/>',
  mail: '<path d="M23.95 5.68 15.54 14.1a5.01 5.01 0 0 1-7.08 0L.05 5.68C.04 5.84 0 5.98 0 6.14v12a5.01 5.01 0 0 0 5 5h14a5.01 5.01 0 0 0 5-5v-12c0-.16-.04-.3-.05-.46Z"/><path d="M14.12 12.68 23.24 3.56A5 5 0 0 0 19 1.14H5A5 5 0 0 0 .76 3.56l9.12 9.12a3 3 0 0 0 4.24 0Z"/>',
};
---

<Page
  title="Контакты арбитражного управляющего в Томске"
  description={`Офис: г. Томск, ${contacts.street}. Телефоны ${contacts.phone}, ${contacts.phone2}. Первая консультация по банкротству — бесплатно, по предварительной записи.`}
  h1="Контакты"
  eyebrow="Томск"
  crumbs={[{ name: 'Контакты', href: url }]}
  topic="Консультация"
  blog={false}
  formSolo
  ctaLabel="Записаться на консультацию"
  schema={[contactPage]}
  formTitle="Запишитесь на бесплатную консультацию"
  formText="Оставьте телефон — перезвоню и договоримся о времени встречи в офисе или онлайн."
>
  <Fragment slot="lead">
    <p>{nb('Первая консультация бесплатная, приём по предварительной записи: позвоните или оставьте заявку, и договоримся о времени')}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Телефоны и почта -->
    <LpSection id="svyaz" chip="Контакты" title="Телефоны и почта" bg="grey">
      <ul class="cs">
        <li><a href={contacts.phoneHref} class="cs-a"><span class="cs-v tnum">{contacts.phone}</span><span class="cs-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={ic.phone} /></span></a></li>
        <li><a href={contacts.phone2Href} class="cs-a"><span class="cs-v tnum">{contacts.phone2}</span><span class="cs-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={ic.phone} /></span></a></li>
        <li><a href={`mailto:${contacts.email}`} class="cs-a"><span class="cs-v">{contacts.email}</span><span class="cs-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={ic.mail} /></span></a></li>
      </ul>
    </LpSection>

    <!-- Офис: карта с карточкой адреса -->
    <LpSection id="ofis" chip="Офис" title="Офис в Томске">
      <div class="om">
        <div class="om-map">
          <iframe src={mapSrc} title="Офис на Яндекс Картах: Томск, ул. Тверская, 14" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="om-card">
          <ul class="om-list">
            <li><span class="om-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={ic.pin} /></span><span class="om-v">{address}</span></li>
            <li><span class="om-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={ic.clock} /></span><span class="om-v">{contacts.hoursDays}<span class="om-s">{nb(contacts.hoursNote.charAt(0).toUpperCase() + contacts.hoursNote.slice(1))}</span></span></li>
          </ul>
          <div class="om-btns">
            <a href="#zayavka" class="lp-btn">Записаться на консультацию</a>
            <a href={routeUrl} target="_blank" rel="noopener" class="om-route">Проложить маршрут</a>
          </div>
        </div>
      </div>
      <a href="#zayavka" class="lp-strip om-strip">
        <span>{nb('Не в Томске? Консультирую и онлайн — в Telegram или WhatsApp. Оставьте заявку, и договоримся о времени')}</span>
        <span class="lp-arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
    </LpSection>
  </Fragment>
</Page>

<style>
  .om { position: relative; display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  .om-map { height: 20rem; overflow: hidden; border-radius: 18px; background: #e9ebee; }
  .om-map iframe { display: block; width: 100%; height: 100%; border: 0; }
  .om-card { padding: clamp(1.25rem, 2vw, 2rem); border-radius: 18px; background: #f3f4f6; }
  .om-card .om-ic { background: #fff; }
  @media (min-width: 1024px) {
    .om { display: block; }
    .om-map { height: clamp(32rem, 40vw, 38rem); border-radius: 24px; }
    .om-card, .om-card .om-ic { background: #fff; }
    .om-card .om-ic { background: #f3f4f6; }
    .om-card { position: absolute; left: 1.5rem; bottom: 1.5rem; width: min(30rem, 40%); box-shadow: 0 12px 40px rgb(11 26 48 / 0.18); }
  }
  .om-list { display: grid; }
  .om-list li { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 1rem; align-items: center; padding: 0.875rem 0; border-top: 1px solid rgb(29 30 33 / 0.1); }
  .om-list li:first-child { padding-top: 0; border-top: 0; }
  .om-ic { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 10px; background: #f3f4f6; color: #034b8e; }
  .om-ic svg { width: 1.25rem; height: 1.25rem; fill: currentColor; }
  .om-v { font-family: var(--font-display); font-weight: 600; font-size: 1.125rem; line-height: 1.3; color: #1d1e21; overflow-wrap: anywhere; }
  .om-v a { color: inherit; text-decoration: none; }
  .om-v a:hover { color: #034b8e; }
  .om-s { display: block; margin-top: 0.125rem; font-family: var(--font-sans); font-weight: 400; font-size: 0.9375rem; color: #5f646d; }
  .om-btns { display: grid; gap: 0.625rem; margin-top: 1.25rem; }
  .om-route { display: inline-flex; align-items: center; justify-content: center; min-height: 3.25rem; padding: 0 1.5rem; border-radius: 10px; box-shadow: inset 0 0 0 1.5px #034b8e; color: #034b8e; font-weight: 500; text-decoration: none; transition: background-color 150ms var(--ease-out); }
  .om-route:hover { background: #e6eef8; }
  .cs { display: grid; border-top: 1px solid rgb(29 30 33 / 0.14); border-bottom: 1px solid rgb(29 30 33 / 0.14); }
  .cs li + li { border-top: 1px solid rgb(29 30 33 / 0.14); }
  @media (min-width: 1024px) {
    .cs { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0.75rem 0; }
    .cs li + li { border-top: 0; border-left: 1px solid rgb(29 30 33 / 0.14); }
    .cs li { padding: 0 1.5rem; }
    .cs li:first-child { padding-left: 0; }
    .cs li:last-child { padding-right: 0; }
  }
  .cs-a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.125rem 0; text-decoration: none; }
  .cs-v { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; line-height: 1.25; color: #1d1e21; overflow-wrap: anywhere; transition: color 150ms var(--ease-out); }
  .cs-a:hover .cs-v { color: #034b8e; }
  .cs-ic { display: grid; place-items: center; flex: none; width: 2.25rem; height: 2.25rem; border-radius: 8px; background: #034b8e; color: #fff; }
  .cs-ic svg { width: 1.125rem; height: 1.125rem; fill: currentColor; }
  .om-strip { margin-top: clamp(0.75rem, 1.4vw, 1.25rem); }
</style>
