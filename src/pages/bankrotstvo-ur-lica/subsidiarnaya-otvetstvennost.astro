---
import Page from '../../layouts/Page.astro';
import LpSection from '../../components/LpSection.astro';
import Lawyer from '../../components/Lawyer.astro';
import HomeReviews from '../../components/HomeReviews.astro';
import Steps from '../../components/Steps.astro';
import heroBg from '../../assets/subsidiary/hero-bg.jpg';
import { nb } from '../../data/typo';
import { serviceSchema } from '../../data/schema';

const url = '/bankrotstvo-ur-lica/subsidiarnaya-otvetstvennost/';
const description = 'Защита директора, учредителя и главбуха от субсидиарной ответственности при банкротстве ООО в Томске: основания, сроки. От 100 000 ₽.';

// Кого могут привлечь (ст. 61.10)
const who = [
  'директор, в том числе бывший и номинальный',
  'участник с долей 50 % и больше',
  'главный бухгалтер и финансовый директор',
  'лица, действовавшие по доверенности',
  'фактический владелец и его родственники, получавшие выгоду',
];
// Ст. 61.11: когда вина предполагается
const presumptions = [
  'Сделки, совершённые по его указанию, причинили существенный вред кредиторам',
  'Документы бухучёта и отчётность отсутствуют или искажены, и это мешает процедуре',
  'Больше 50 % требований в реестре — налоговые недоимки и штрафы по итогам проверки',
  'В ЕГРЮЛ внесены недостоверные сведения или они не обновлялись',
];
// Ст. 61.12: неподача заявления
const late: [string, string][] = [
  ['Когда', 'руководитель не обратился в суд в течение месяца после появления признаков банкротства'],
  ['Размер', 'обязательства, возникшие после истечения этого месяца и до возбуждения дела'],
  ['Что спасает', 'реальный план выхода из кризиса освобождает от ответственности за период его исполнения'],
];
// Линии защиты
const defense: [string, string][] = [
  ['Разумность сделок', 'Показываем экономический смысл: рыночная цена, реальная поставка, получение встречного исполнения'],
  ['План выхода из кризиса', 'Если директор не подал заявление, но действовал по реальному плану восстановления'],
  ['Причины банкротства вне контроля', 'Потеря ключевого заказчика, рыночные изменения, действия третьих лиц'],
  ['Передача документов', 'Подтверждаем, что документы переданы управляющему или их отсутствие не помешало процедуре'],
  ['Снижение размера', 'Если ответственность неизбежна: раскрытие информации, размер реального вреда'],
];
// Что сделать сейчас
// «Что сделать сейчас» — этапами; тексты прежние, ярлыки — по смыслу текстов
const now = [
  { title: 'Не выводите имущество', time: 'проверит управляющий', text: 'И не рассчитывайтесь с «удобными» кредиторами — это первое, что проверит управляющий' },
  { title: 'Сохраните документы', time: 'экономический смысл', text: 'Первичку, договоры, переписку — то, что подтвердит экономический смысл решений' },
  { title: 'Зафиксируйте дату', time: 'признаки неплатёжеспособности', text: 'Когда появились признаки неплатёжеспособности и что решили: план восстановления или заявление в суд' },
  { title: 'Обсудите с юристом', time: 'до заявления кредитора', text: 'До того, как заявление подаст кредитор или налоговая' },
];

const faq = [
  {
    q: 'Можно ли списать субсидиарную ответственность через личное банкротство?',
    a: 'Нет. Долг по субсидиарной ответственности и убытки, причинённые компании, не списываются при банкротстве гражданина (п. 6 ст. 213.28 закона о банкротстве). Поэтому защищаться нужно в деле компании, а не надеяться на личное банкротство потом.',
  },
  {
    q: 'В течение какого срока могут привлечь к субсидиарной ответственности?',
    a: 'Заявление можно подать в течение трёх лет с момента, когда заявитель узнал или должен был узнать об основаниях, но не позднее трёх лет после признания должника банкротом и не позднее десяти лет с момента нарушения (ст. 61.14). На практике срок обычно отсчитывают от дат в деле о банкротстве.',
  },
  {
    q: 'Отвечает ли номинальный директор?',
    a: 'Да, номинальный директор отвечает солидарно с фактическим владельцем. Суд может снизить размер ответственности, если номинал раскрыл, кто реально управлял компанией, и это помогло найти имущество.',
  },
  {
    q: 'Могут ли привлечь бухгалтера или родственника?',
    a: 'Да, если суд признает их контролирующими лицами: они могли давать обязательные указания или извлекали выгоду из незаконных действий. Главбуха привлекают, например, за искажение или отсутствие документов бухучёта.',
  },
];
---

<Page
  title="Субсидиарная ответственность: защита директора"
  description={description}
  h1="Защита от субсидиарной ответственности в Томске"
  eyebrow="Для директоров и учредителей"
  crumbs={[{ name: 'Банкротство ООО и АО', href: '/bankrotstvo-ur-lica/' }, { name: 'Субсидиарная ответственность', href: url }]}
  facts={[
    ['Стоимость защиты', 'от 100 000 ₽'],
    ['Срок давности', '3 года'],
    ['Списать через личное банкротство', 'нельзя'],
    ['Бремя доказывания', 'часто на ответчике'],
  ]}
  faq={faq}
  topic="Субсидиарная ответственность"
  expert
  heroBg={heroBg}
  formTitle="Разберу заявление о субсидиарной ответственности"
  formText="Пришлите номер дела о банкротстве или расскажите о компании. Посмотрю основания, доказательства управляющего и скажу, какие аргументы у вас есть."
  schema={[serviceSchema({ name: 'Защита от субсидиарной ответственности', url, description, price: 100000, serviceType: 'Представление интересов лица, привлекаемого к субсидиарной ответственности' })]}
  related={[
    { href: '/bankrotstvo-ur-lica/', label: 'Банкротство ООО', text: 'Процедуры, сроки и обязанность директора подать заявление.' },
    { href: '/bankrotstvo-ur-lica/kreditoram/', label: 'Кредиторам', text: 'Как кредиторы используют субсидиарку для возврата долга.' },
    { href: '/yuridicheskie-uslugi/', label: 'Цены', text: 'Все юридические услуги в одном прайсе.' },
  ]}
>
  <Fragment slot="lead">
    <p>{nb('Защищаю директоров, учредителей и бухгалтеров, когда долги компании-банкрота хотят взыскать с них лично. Лучше начать до того, как управляющий подал заявление')}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Что это и кого привлекают -->
    <LpSection id="chto-eto" chip="Что это" title="Что такое субсидиарная ответственность" lead="Взыскание долгов компании-банкрота с контролирующих её людей лично. Основания — опоздание с заявлением о банкротстве, вывод активов, отсутствие или искажение документов" bg="grey">
      <div class="lp-two">
        <div class="lp-card lp-blue">
          <p class="lp-k">Чем грозит</p>
          <p class="lp-big">{nb('Все долги компании')}</p>
          <p class="lp-t">{nb('Сумма может равняться всем непогашенным долгам. Взыскивают с человека лично, и через личное банкротство этот долг не спишут (п. 6 ст. 213.28)')}</p>
          <a href="#zayavka" class="bl-btn">Разобрать мою ситуацию</a>
        </div>
        <div class="lp-card">
          <p class="lp-k">Ст. 61.10 закона о банкротстве</p>
          <h3 class="lp-h3">Кого могут привлечь</h3>
          <ul class="lp-signs">
            {who.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}
          </ul>
          <p class="lp-foot">{nb('Учитывается период в три года до появления признаков банкротства')}</p>
        </div>
      </div>
    </LpSection>

    <!-- Кто ведёт дело -->
    <Lawyer />

    <!-- Два основания -->
    <LpSection id="osnovaniya" chip="Основания" title="Два основания: за что привлекают" lead="Закон различает доведение компании до банкротства и опоздание с заявлением. Размер ответственности в этих случаях разный" bg="grey">
      <div class="lp-two">
        <div class="lp-card">
          <div class="dg-head"><h3 class="dg-h">{nb('Невозможность погасить требования')}</h3><span class="dg-tag">ст. 61.11</span></div>
          <p class="os-t">{nb('Действия или бездействие контролирующего лица довели компанию до банкротства. Вина предполагается, если:')}</p>
          <ul class="dg-list">{presumptions.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}</ul>
        </div>
        <div class="lp-card">
          <div class="dg-head"><h3 class="dg-h">{nb('Неподача заявления о банкротстве')}</h3><span class="dg-tag">ст. 61.12</span></div>
          <dl class="pr-dl">
            {late.map(([k, v]) => <div><dt>{k}</dt><dd>{nb(v)}</dd></div>)}
          </dl>
        </div>
      </div>
    </LpSection>

    <!-- Защита -->
    <LpSection id="zashchita" chip="Защита" title="Как строится защита" lead="Презумпции вины опровержимы. Суды учитывают, что бизнес-решение могло быть разумным, даже если не сработало">
      <div class="sd-wrap">
        <div class="sd-card">
          <p class="sd-num">от 100 000 ₽</p>
          <p class="sd-cap">{nb('защита ответчика в Арбитражном суде Томской области — в зависимости от сложности и числа заседаний')}</p>
          <p class="sd-note">{nb('Лучший момент начать — до того, как управляющий подал заявление: успеваем собрать документы и объяснения по каждой спорной сделке')}</p>
          <a href="#zayavka" class="lp-btn sd-btn">Обсудить защиту</a>
        </div>
        <ol class="sd-list">
          {defense.map(([h, t], i) => <li><span class="sd-n tnum">[{String(i + 1).padStart(2, '0')}]</span><span><b>{nb(h)}.</b> {nb(t)}</span></li>)}
        </ol>
      </div>
    </LpSection>

    <!-- Что сделать сейчас -->
    <Steps id="seychas" chip="Если компания на грани" titleA="Что сделать сейчас, если компания" titleB="на грани банкротства" steps={now} note="Эти шаги снижают риск ещё до того, как дело о банкротстве возбуждено." noteLink={false} />

    <HomeReviews />
  </Fragment>
</Page>

<style>
  .lp-two { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 768px) { .lp-two { grid-template-columns: 1fr 1fr; } }
  .lp-card { display: flex; flex-direction: column; padding: clamp(1.25rem, 2vw, 1.75rem); border-radius: 18px; background: #fff; color: #1d1e21; }
  :global(.lps:not(.is-grey)) .lp-card:not(.lp-blue) { background: #f3f4f6; }
  .lp-blue { background: linear-gradient(135deg, #034b8e 0%, #053a6e 60%, #0b1a30 100%); color: #fff; }
  .lp-k { font-size: 0.9375rem; color: #7c818a; }
  .lp-blue .lp-k { color: rgb(255 255 255 / 0.75); }
  .lp-big { margin-top: 0.75rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 3.2vw, 3rem); line-height: 1.05; letter-spacing: -0.03em; }
  .lp-t { margin-top: 0.875rem; font-size: var(--fs-body); line-height: 1.5; color: rgb(255 255 255 / 0.88); text-wrap: pretty; }
  .lp-h3 { margin-top: 0.75rem; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -0.015em; color: #1d1e21; text-wrap: balance; }
  .lp-signs { margin-top: 1rem; }
  .lp-signs li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 0.875rem; padding: 0.625rem 0; border-top: 1px solid rgb(29 30 33 / 0.1); font-size: var(--fs-body); line-height: 1.4; color: #2a2d33; }
  .lp-sq { display: grid; grid-template-columns: 5px 5px; grid-auto-rows: 5px; gap: 2px; margin-top: 0.45em; }
  .lp-sq i { width: 5px; height: 5px; border-radius: 1px; background: #034b8e; }
  .lp-foot { margin-top: auto; padding-top: 1rem; border-top: 1px solid rgb(29 30 33 / 0.1); font-size: 0.9375rem; line-height: 1.45; color: #7c818a; }
  .bl-btn { display: inline-flex; align-self: flex-start; align-items: center; justify-content: center; min-height: 3.25rem; margin-top: auto; padding: 0 1.75rem; border-radius: 10px; background: #fff; color: #034b8e; font-weight: 600; font-size: 1rem; text-decoration: none; transition: background-color 150ms var(--ease-out); }
  .lp-blue .lp-t { margin-bottom: 1.5rem; }
  .bl-btn:hover { background: #e6eef8; }
  @media (max-width: 639px) { .bl-btn { align-self: stretch; } }
  .lp-btn {
    display: inline-flex; flex: none; align-items: center; justify-content: center; min-height: 3.25rem; padding: 0 1.5rem;
    border-radius: 10px; background: #034b8e; color: #fff; font-weight: 500; text-decoration: none; transition: background-color 150ms var(--ease-out);
  }
  .lp-btn:hover { background: #0a5aa6; }

  .dg-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem 1rem; margin-bottom: 1rem; }
  .dg-h { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.15; letter-spacing: -0.015em; color: #1d1e21; }
  .dg-tag { flex: none; padding: 0.375rem 0.75rem; border-radius: 8px; background: #e6eef8; font-size: 0.9375rem; font-weight: 500; line-height: 1.3; color: #034b8e; }
  .dg-list li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 0.875rem; padding: 0.4rem 0; font-size: var(--fs-body); line-height: 1.45; color: #1d1e21; }
  .os-t { margin-bottom: 0.5rem; font-size: var(--fs-body); line-height: 1.45; color: #5f646d; }
  .pr-dl > div { padding: 0.75rem 0; border-top: 1px solid rgb(29 30 33 / 0.1); }
  .pr-dl > div:last-child { padding-bottom: 0; }
  .pr-dl dt { font-size: 0.875rem; color: #7c818a; }
  .pr-dl dd { margin-top: 0.25rem; font-size: var(--fs-body); line-height: 1.45; color: #1d1e21; }
  @media (min-width: 1024px) {
    .pr-dl > div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1rem; align-items: baseline; }
    .pr-dl dd { margin-top: 0; }
  }

  /* Защита: карточка с ценой + список линий защиты */
  .sd-wrap { display: grid; gap: 1.5rem; }
  @media (min-width: 1024px) { .sd-wrap { grid-template-columns: minmax(0, 5fr) minmax(0, 8fr); gap: clamp(1.5rem, 3vw, 3.5rem); } }
  .sd-card { display: flex; flex-direction: column; padding: clamp(1.25rem, 1.8vw, 2rem) clamp(1.25rem, 1.6vw, 1.75rem); border-radius: 16px; background: #f3f4f6; }
  .sd-num { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.25rem, 3.2vw, 3rem); line-height: 1; letter-spacing: -0.02em; color: #1d1e21; }
  .sd-cap { margin-top: 0.5rem; font-size: var(--fs-body); line-height: 1.45; color: #7c818a; text-wrap: pretty; }
  .sd-note { margin-top: auto; padding-top: 2rem; font-size: var(--fs-body); line-height: 1.45; color: #1d1e21; }
  .lp-btn.sd-btn { align-self: flex-start; margin-top: 1.25rem; }
  @media (max-width: 639px) { .lp-btn.sd-btn { align-self: stretch; } }
  .sd-list li { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 1rem; padding: 1rem 0; border-top: 1px solid rgb(29 30 33 / 0.1); font-size: var(--fs-body); line-height: 1.45; color: #2a2d33; }
  .sd-list li:last-child { border-bottom: 1px solid rgb(29 30 33 / 0.1); }
  .sd-list b { font-weight: 600; color: #1d1e21; }
  .sd-n { color: #8a8f98; }
  @media (max-width: 639px) { .sd-list li { grid-template-columns: 2.75rem minmax(0, 1fr); gap: 0.75rem; } }

  /* Что сделать сейчас: 4 белые карточки с синим номером */
  .bz-grid { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 640px) { .bz-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .bz-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .bz-card { display: flex; flex-direction: column; padding: clamp(1.25rem, 2vw, 1.75rem); border-radius: 18px; background: #fff; }
</style>
