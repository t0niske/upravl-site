---
import Base from '../layouts/Base.astro';
import CaseGrid from '../components/CaseGrid.astro';
import CaseStory from '../components/CaseStory.astro';
import LeadForm from '../components/LeadForm.astro';
import Byline from '../components/Byline.astro';
import { cases, recentCases, rub, maskCase, SITE_URL } from '../data/site';
import { nb } from '../data/typo';

const all = recentCases.length + cases.length;
const itemList = {
  '@type': 'ItemList',
  name: 'Завершённые дела о банкротстве граждан',
  url: `${SITE_URL}/dela/`,
  numberOfItems: all,
  itemListElement: [
    ...recentCases.map((c) => `Дело № ${maskCase(c.number)}: ${c.title}`),
    ...cases.map((c) => `Дело № ${maskCase(c.number)}: списано ${rub(c.amount)}`),
  ].map((name, i) => ({ '@type': 'ListItem', position: i + 1, name })),
};
---

<Base
  title="Завершённые дела о банкротстве — номера и истории"
  description={`${all} дел, где граждане освобождены от долгов: свежие дела 2025–2026 и прошлых лет. Имена и номера дел скрыты.`}
  crumbs={[{ name: 'Дела', href: '/dela/' }]}
  schema={[itemList]}
>
  <section class="wrap pt-6 md:pt-10">
    <h1>Завершённые дела о банкротстве граждан</h1>
    <div class="prose-legal lead-answer mt-6">
      <p>
        {nb('Дела, которые я вёл финансовым управляющим и в которых суд освободил граждан от долгов. Имена и номера дел скрыты, чтобы не раскрывать клиентов.')}
      </p>
    </div>
    <Byline />
  </section>

  <section class="mx-auto mt-10 w-full max-w-[100rem] px-4 sm:px-[3.25rem]" aria-labelledby="recent-title">
    <h2 id="recent-title">{nb(`Последние завершённые дела — ${recentCases.length}`)}</h2>
    <ul class="dela-grid mt-6">
      {recentCases.map((c) => <li><CaseStory c={c} /></li>)}
    </ul>
  </section>

  <section class="wrap mt-16" aria-labelledby="past-title">
    <h2 id="past-title">{nb(`Дела прошлых лет — ${cases.length}`)}</h2>
    <p class="mt-3 text-ink-2">{nb(`По этим делам в сумме списано ${rub(cases.reduce((s, c) => s + c.amount, 0))}`)}</p>
    <div class="mt-8"><CaseGrid /></div>
  </section>

  <section class="wrap mt-16">
    <div class="prose-legal">
      <h2>Почему на сайте нет имён, номеров дел и копий определений</h2>
      <p>
        В определениях указаны дата рождения, адрес, ИНН и СНИЛС должника. Сведения о банкротстве и так публикуются в ЕФРСБ, но размещать их
        на коммерческом сайте ради рекламы мы не будем. По полному номеру дела в картотеке видно имя должника, поэтому номера тоже скрыты.
      </p>
      <h2>Что значит «списано»</h2>
      <p>
        Это сумма требований кредиторов, от исполнения которых суд освободил должника по итогам процедуры. Деньги, вырученные от продажи
        имущества (если оно было), к этому моменту уже распределены между кредиторами.
      </p>
      <h2>Гарантирует ли это результат в вашем деле</h2>
      <p>
        Нет. Освобождение от долгов зависит от добросовестности должника, сделок за последние годы и решения суда.
        Гарантировать списание по закону нельзя — честно оцениваю перспективы на консультации.
      </p>
    </div>
  </section>

  <div class="mt-24"><LeadForm /></div>
</Base>

<style>
  .dela-grid { display: grid; gap: clamp(1rem, 1.5vw, 1.75rem); grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  .dela-grid > li { display: flex; }
  .dela-grid > li > :global(*) { flex: 1; }
</style>
