---
import Page from '../layouts/Page.astro';
import LpSection from '../components/LpSection.astro';
import portrait from '../assets/antonets-glasses.png';
import { person } from '../data/site';
import HomeReviews from '../components/HomeReviews.astro';
import Steps from '../components/Steps.astro';
import HomeQuiz from '../components/HomeQuiz.astro';
import { Image } from 'astro:assets';
import { nb } from '../data/typo';
import imgCar from '../assets/mfc/bad-car.jpg';
import imgCreditors from '../assets/mfc/bad-creditors.jpg';
import imgDeals from '../assets/mfc/bad-deals.jpg';
import imgDebt from '../assets/mfc/bad-debt.jpg';
import heroBg from '../assets/mfc/hero-bg.jpg';
import { law, pricing, rub } from '../data/site';
import { serviceSchema } from '../data/schema';

const url = '/bankrotstvo-cherez-mfc/';
const description = `Внесудебное банкротство в Томске: бесплатно, долг от ${rub(law.mfcMin)} до ${rub(law.mfcMax)}, около ${law.mfcDurationMonths} месяцев. Проверю условия и список кредиторов до подачи.`;

// Когда МФЦ — плохой выбор: [заголовок, пояснение, картинка]
const bad: [string, string, ImageMetadata][] = [
  ['Есть имущество, которое можно продать', 'Например, автомобиль. Тогда кредиторы вправе перевести дело в суд', imgCar],
  ['Вы не уверены, что знаете всех кредиторов', 'Пропущенные долги не спишут, а повторно обратиться можно только через 5 лет', imgCreditors],
  ['Были сделки с имуществом за последние годы', 'Кредитор может оспорить их уже в судебной процедуре', imgDeals],
  [`Долг больше ${rub(law.mfcMax)}`, 'Внесудебный порядок недоступен ни при каком доходе', imgDebt],
];
// Этапы: от проверки условий до списания
const stages = [
  { title: 'Консультация', time: 'бесплатно', text: 'Смотрю постановление пристава, сумму долгов и имущество. Если МФЦ не подходит, скажу прямо и объясню, какая процедура нужна' },
  { title: 'Постановление пристава', time: 'Госуслуги или ФССП', text: 'Получаем постановление об окончании исполнительного производства и проверяем основание — п. 4 ч. 1 ст. 46' },
  { title: 'Список кредиторов', time: 'до подачи', text: 'По кредитным историям из всех бюро находим все долги, включая проданные коллекторам, и составляем список по форме' },
  { title: 'Подача в МФЦ', time: 'несколько рабочих дней', text: 'Вы подаёте паспорт, заявление и список в МФЦ по месту жительства. МФЦ проверяет сведения и включает их в ЕФРСБ' },
  { title: 'Процедура', time: `${law.mfcDurationMonths} месяцев`, text: 'Действует мораторий: кредиторы не взыскивают долги из заявления, неустойки и проценты не начисляются' },
  { title: 'Списание долгов', time: 'результат', text: 'Процедура завершается, и долги из заявления списываются' },
];
// Что такое: главное о процедуре и сравнение с судом
const basics = [
  'Процедура бесплатная: госпошлины и вознаграждения управляющему нет',
  'Заявление гражданин подаёт сам в МФЦ по месту жительства или пребывания',
  `Через ${law.mfcDurationMonths} месяцев после включения сведений в ЕФРСБ долги из заявления списываются`,
  'Списывают только долги, которые указаны в заявлении. Если сумма занижена, спишут только указанную',
  'Не спишут алименты, долги по зарплате и возмещение вреда здоровью',
];
const compare: [string, string, string][] = [
  ['Стоимость', 'бесплатно', `от ${rub(pricing.citizenTurnkey)} + депозит ${rub(law.fuDeposit)}`],
  ['Кто ведёт', 'МФЦ, без суда и управляющего', 'Арбитражный суд и финансовый управляющий'],
  ['Кому подходит', 'тем, у кого приставам нечего взыскать', 'всем, кто не может платить по долгам'],
  ['Сумма долга', `от ${rub(law.mfcMin)} до ${rub(law.mfcMax)}`, 'любая'],
  ['Исполнительные производства', 'в основном случае окончено, других открытых нет', 'не важно, могут идти'],
  ['Имущество', 'для тех, с кого взыскать нечего', 'единственное жильё без ипотеки сохраняют, остальное продают на торгах'],
  ['Срок', `${law.mfcDurationMonths} месяцев`, `от ${law.realizationMonths} месяцев`],
];
// Цифры — те же, что в блоке юриста и «Обо мне»
const stats = [['25+ лет', 'в банкротстве'], ['250+', 'процедур банкротства'], ['320+ млн ₽', 'списанных долгов']];
// Зачем юрист: три карточки под синей панелью
const why: [string, string][] = [
  ['Проверю, подходит ли вам МФЦ', 'Смотрю постановление пристава, сумму долгов и имущество. Если МФЦ не подходит, скажу прямо и объясню, какая процедура нужна'],
  ['Соберу полный список кредиторов', 'По кредитным историям из всех бюро находим старые микрозаймы, долги, проданные коллекторам, налоги и ЖКХ'],
  ['Сниму риск возврата заявления', 'До подачи проверяю основание окончания производства, другие производства и сумму долга — всё, из-за чего МФЦ возвращает документы'],
];
const during = ['Кредиторы не могут взыскивать долги, указанные в заявлении', 'Перестают начисляться неустойки и проценты'];
const limits = ['Брать новые кредиты и займы, давать поручительства нельзя', 'О новом имуществе или доходе нужно сообщить в МФЦ в течение 5 рабочих дней, тогда процедуру прекратят. Если промолчать, кредитор вправе обратиться в суд'];
const after = [['5 лет', 'сообщать о банкротстве при оформлении кредитов и займов'], ['3 года', 'нельзя руководить организацией'], ['5 лет', 'нельзя повторно пройти банкротство через МФЦ']];

const faq = [
  {
    q: 'Сколько стоит банкротство через МФЦ?',
    a: 'Сама процедура бесплатная: госпошлины и вознаграждения управляющему нет. Платная только помощь юриста, если вы решите проверить условия и составить список кредиторов с ним.',
  },
  {
    q: 'Что будет, если забыть указать кредитора?',
    a: 'Долги перед кредиторами, которых нет в заявлении, после процедуры не спишут. Это самая частая ошибка: забывают старые микрозаймы, долги, проданные коллекторам, налоги и задолженность за ЖКХ. Перед подачей стоит заказать кредитную историю во всех бюро.',
  },
  {
    q: 'Могут ли отказать?',
    a: 'МФЦ возвращает заявление, если нет постановления об окончании исполнительного производства по нужному основанию, есть другое неоконченное производство, сумма долга вне пределов или с прошлой процедуры не прошло 5 лет. Для пенсионеров и получателей пособия заявление вернут, если приставы или Социальный фонд не подтвердят условия. Отказ можно обжаловать в арбитражном суде. Во время процедуры кредитор вправе обратиться в суд в случаях, указанных в законе, например если должник скрыл новое имущество. Если суд введёт процедуру банкротства, внесудебная прекращается.',
  },
  {
    q: 'Можно ли пройти через МФЦ повторно?',
    a: 'Повторно обратиться можно не раньше чем через 5 лет после завершения предыдущей процедуры. Если заявление вернули, подать его снова можно не раньше чем через месяц.',
  },
];

---

<Page
  title="Банкротство через МФЦ в Томске: условия 2026"
  description={description}
  h1="Банкротство через МФЦ в Томске"
  eyebrow="Для граждан · внесудебная процедура"
  crumbs={[{ name: 'Банкротство через МФЦ', href: url }]}
  facts={[
    ['Стоимость процедуры', 'бесплатно'],
    ['Сумма долга', `до ${rub(law.mfcMax)}`],
    ['Длительность', `около ${law.mfcDurationMonths} месяцев`],
    ['Суд и управляющий', 'не нужны'],
  ]}
  faq={faq}
  topic="Банкротство через МФЦ"
  expert
  heroBg={heroBg}
  formTitle="Проверю, пройдёт ли ваше заявление в МФЦ"
  formText="Если по условиям подходит МФЦ, скажу об этом прямо — судебная процедура вам не нужна. Помогу составить полный список кредиторов, чтобы ни один долг не остался."
  schema={[serviceSchema({ name: 'Внесудебное банкротство гражданина через МФЦ', url, description })]}
>
  <Fragment slot="lead">
    <p>{nb(`Бесплатное списание долгов без суда и управляющего при долге от ${rub(law.mfcMin)} до ${rub(law.mfcMax)}. Проверю условия и список кредиторов до подачи, чтобы ни один долг не остался`)}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Что такое -->
    <LpSection id="chto-eto" chip="Что это" title="Что такое банкротство через МФЦ" lead="Внесудебное банкротство — бесплатная процедура через МФЦ для граждан, с которых приставы ничего не смогли взыскать. Она проще судебной: заявление подаёте сами, суд и финансовый управляющий не нужны" bg="grey">
      <div class="ce-wrap">
        <div class="lp-card">
          <h3 class="dg-h">Главное о процедуре</h3>
          <ul class="dg-list ce-list">{basics.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}</ul>
          <a href="#zayavka" class="lp-btn ce-btn">Проверить, подойдёт ли МФЦ</a>
        </div>
        <div class="lp-card ce-card">
          <table class="ce-table">
            <caption class="sr-only">Сравнение банкротства через МФЦ и через суд</caption>
            <thead><tr><th scope="col"><span class="sr-only">Параметр</span></th><th scope="col" class="is-mfc">Через МФЦ</th><th scope="col">Через суд</th></tr></thead>
            <tbody>
              {compare.map(([k, a, b]) => <tr><th scope="row">{k}</th><td class="is-mfc">{nb(a)}</td><td>{nb(b)}</td></tr>)}
            </tbody>
          </table>
        </div>
      </div>
    </LpSection>

    <!-- Квиз -->
    <HomeQuiz variant="mfc" />

    <!-- Кому подходит -->
    <LpSection id="komu" chip="Кому подходит" title="Кому подходит банкротство через МФЦ" lead="Условия установлены ст. 223.2 закона о банкротстве. Важны сумма долга и то, чем закончилось исполнительное производство">
      <div class="lp-two">
        <div class="lp-card lp-blue">
          <p class="lp-k">Сумма долгов</p>
          <p class="lp-big tnum">до {rub(law.mfcMax)}</p>
          <p class="lp-t">{nb(`общая сумма — от ${rub(law.mfcMin)} до ${rub(law.mfcMax)} включительно. Сюда входят и долги, срок оплаты которых ещё не наступил, алименты и поручительства`)}</p>
        </div>
        <div class="lp-card">
          <p class="lp-k">Главное условие</p>
          <h3 class="lp-h3">Приставы ничего не взыскали</h3>
          <ul class="lp-signs">
            {['исполнительное производство окончено из-за отсутствия имущества (п. 4 ч. 1 ст. 46 закона об исполнительном производстве)', 'после этого не возбуждено другое исполнительное производство'].map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}
          </ul>
        </div>
      </div>
      <a href="#zayavka" class="lp-strip">
        <span>{nb('Есть и другие основания: для пенсионеров и получателей пособия на ребёнка, а также если долг по исполнительному документу не взыскан 7 лет. Детали проверю на консультации')}</span>
        <span class="lp-arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
      <div class="km-sub">
        <h3 class="km-h">Когда МФЦ — плохой выбор</h3>
        <p class="km-t">{nb('В этих случаях внесудебная процедура не спишет долги или её прекратят. Тогда нужно судебное банкротство')}</p>
      </div>
      <ul class="mf-grid">
        {bad.map(([h, t, img], i) => (
          <li class="mf-card">
            <Image src={img} alt="" widths={[400, 640]} sizes="(min-width: 1280px) 22vw, (min-width: 768px) 45vw, 92vw" class="mf-img" loading="lazy" />
            <div class="mf-body">
              <span class="mf-n tnum">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mf-h">{nb(h)}</h3>
              <p class="mf-t">{nb(t)}</p>
            </div>
          </li>
        ))}
      </ul>
      <a href="/bankrotstvo-fizicheskih-lic/" class="lp-strip">
        <span>{nb(`Долг больше ${rub(law.mfcMax)}, есть имущество или сделки?`)}<br class="lp-br" /> {nb('Посмотрите, как проходит судебное банкротство и сколько оно стоит')}</span>
        <span class="lp-arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
    </LpSection>

    <!-- Зачем юрист, если процедура бесплатная -->
    <section class="wy-sec" aria-labelledby="wy-title">
      <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
        <div class="wy-panel">
          <div class="wy-text">
            <h2 id="wy-title" class="wy-h"><span>Зачем юрист,</span> если процедура бесплатная?</h2>
            <p class="wy-t">{nb('Одна ошибка в заявлении — и долг останется или МФЦ вернёт документы. Я знаю, где обычно ошибаются')}</p>
            <dl class="wy-stats">{stats.map(([v, l]) => <div><dt class="tnum">{v}</dt><dd>{l}</dd></div>)}</dl>
            <a href="#zayavka" class="wy-btn">Бесплатная консультация</a>
          </div>
          <figure class="wy-fig">
            <Image src={portrait} alt={person.name} widths={[480, 720, 1000]} sizes="(min-width: 1024px) 30vw, 80vw" class="wy-img" loading="lazy" />
            <figcaption class="wy-badge"><span>{person.name}</span><span>{person.job}</span></figcaption>
          </figure>
        </div>
        <ol class="wy-cards">
          {why.map(([h, t], i) => (
            <li class="wy-card">
              <span class="wy-steps" aria-hidden="true">{[0, 1, 2].map((k) => <i class:list={[k <= i && 'is-on']}></i>)}</span>
              <h3 class="wy-ch">{nb(h)}</h3>
              <p class="wy-ct">{nb(t)}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>


    <!-- Этапы -->
    <Steps steps={stages} titleA="Помогу подготовить заявление —" titleB="от проверки условий до списания долгов" note={`${law.mfcDurationMonths} месяцев считаются с даты включения сведений в ЕФРСБ.`} noteLink={false} />

    <!-- Во время процедуры -->
    <LpSection id="vo-vremya" chip="Во время и после" title="Что изменится во время и после процедуры" lead="С даты включения сведений в ЕФРСБ вводится мораторий на взыскание долгов из заявления. После списания действуют ограничения">
      <div class="lp-two">
        <div class="lp-card">
          <div class="dg-head"><h3 class="dg-h">Мораторий</h3><span class="dg-tag">защищает от кредиторов</span></div>
          <ul class="dg-list">{during.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}</ul>
        </div>
        <div class="lp-card">
          <div class="dg-head"><h3 class="dg-h">Ограничения</h3><span class="dg-tag is-grey">на время процедуры</span></div>
          <ul class="dg-list is-grey">{limits.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}</ul>
        </div>
      </div>
      <div class="ps-panel vp-after">
        <h3 class="ps-h">После списания</h3>
        <dl class="ps-facts">
          {after.map(([y, t]) => <div class="ps-fact"><dt>{nb(t)}</dt><dd class="tnum">{y}</dd></div>)}
        </dl>
      </div>
    </LpSection>


    <HomeReviews />
  </Fragment>
</Page>

<style>
  .lp-two { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 768px) { .lp-two { grid-template-columns: 1fr 1fr; } }
  .lp-three { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 1024px) { .lp-three { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .lp-card { display: flex; flex-direction: column; padding: clamp(1.25rem, 2vw, 1.75rem); border-radius: 18px; background: #fff; color: #1d1e21; }
  :global(.lps:not(.is-grey)) .lp-card:not(.lp-blue) { background: #f3f4f6; }
  .lp-blue { background: linear-gradient(135deg, #034b8e 0%, #053a6e 60%, #0b1a30 100%); color: #fff; }
  .lp-k { font-size: 0.9375rem; color: #7c818a; }
  .lp-blue .lp-k { color: rgb(255 255 255 / 0.75); }
  .lp-big { margin-top: 0.75rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(2.25rem, 3.6vw, 3.25rem); line-height: 1; letter-spacing: -0.03em; }
  .lp-t { margin-top: 0.875rem; font-size: var(--fs-body); line-height: 1.5; color: rgb(255 255 255 / 0.88); text-wrap: pretty; }
  .lp-t-muted { margin-top: 0.625rem; color: #5f646d; }
  .lp-h3 { margin-top: 0.75rem; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -0.015em; color: #1d1e21; text-wrap: balance; }
  .lp-signs { margin-top: 1rem; }
  .lp-signs li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 0.875rem; padding: 0.625rem 0; border-top: 1px solid rgb(29 30 33 / 0.1); font-size: var(--fs-body); line-height: 1.4; color: #2a2d33; }
  .lp-signs li:last-child { padding-bottom: 0; }
  .lp-br { display: none; }
  @media (min-width: 1024px) { .lp-br { display: inline; } }
  .lp-list { display: grid; gap: 0.75rem; margin-top: 1rem; }
  .lp-list li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 0.875rem; font-size: var(--fs-body); line-height: 1.45; color: #2a2d33; }
  .lp-sq { display: grid; grid-template-columns: 5px 5px; grid-auto-rows: 5px; gap: 2px; margin-top: 0.45em; }
  .lp-sq i { width: 5px; height: 5px; border-radius: 1px; background: #034b8e; }

  .lp-strip {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem;
    margin-top: clamp(0.75rem, 1.2vw, 1rem); padding: clamp(1rem, 1.4vw, 1.25rem) clamp(1.25rem, 2vw, 2rem);
    border-radius: 16px; background: #f3f4f6; font-size: var(--fs-body); line-height: 1.45; color: #1d1e21; text-decoration: none;
    transition: box-shadow 150ms var(--ease-out);
  }
  :global(.lps.is-grey) .lp-strip { background: #fff; }
  a.lp-strip:hover { box-shadow: inset 0 0 0 2px #034b8e; }
  .lp-strip > span:first-child { flex: 1; min-width: 16rem; }
  .lp-arrow { display: grid; flex: none; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 8px; background: #034b8e; color: #fff; }
  .lp-btn {
