---
import Page from '../layouts/Page.astro';
import LpSection from '../components/LpSection.astro';
import Lawyer from '../components/Lawyer.astro';
import HomeReviews from '../components/HomeReviews.astro';
import { nb } from '../data/typo';
import { priceGroups } from '../data/prices';
import { serviceSchema } from '../data/schema';
import heroBg from '../assets/arbitrazh/hero-bg.jpg';
import '../styles/lp.css';

const url = '/yuridicheskie-uslugi-v-arbitrazhnyh-sudah/';
const description = 'Юридические услуги в арбитражных судах в Томске: иск или отзыв — от 10 000 ₽, первая инстанция — от 30 000 ₽, жалобы в любой инстанции.';
const arb = priceGroups.find((g) => g.id === 'arbitrazhnyj-sud')!;

// Инстанции
const stages: [string, string, string][] = [
  ['Первая инстанция', 'Иск или отзыв, доказательства, участие в заседаниях', 'от 30 000 ₽'],
  ['Апелляция', 'Жалоба на решение или возражения на чужую жалобу, участие в заседании', 'от 10 000 ₽'],
  ['Кассация', 'Жалоба или возражения и участие в заседании', 'от 20 000 ₽'],
];

const faq = [
  {
    q: 'Сколько стоит представительство в арбитражном суде?',
    a: 'В первой инстанции — от 30 000 ₽ плюс 7 % от взысканной суммы, транспортные и командировочные расходы. В апелляции — от 10 000 ₽, в кассации — от 20 000 ₽. Дело в упрощённом порядке — от 20 000 ₽.',
  },
  {
    q: 'Можно заказать только иск или только жалобу?',
    a: 'Да. Исковое заявление или отзыв на иск — от 10 000 ₽, жалоба на решение или возражения на жалобу в любой инстанции — от 15 000 ₽.',
  },
  {
    q: 'Работаете с делами вне Томска?',
    a: 'Да. Транспортные и командировочные расходы по делам вне Томска оплачиваются отдельно. Итоговую цену называю до начала работы и фиксирую в договоре.',
  },
  {
    q: 'Можно подключиться только на апелляции?',
    a: 'Да. Жалоба на решение или возражения на жалобу — от 15 000 ₽, представительство в апелляции — от 10 000 ₽, в кассации — от 20 000 ₽.',
  },
  {
    q: 'Кто будет вести дело?',
    a: 'Я сам — Антонец Юрий Анатольевич, арбитражный управляющий. Документы, суд и переписку беру на себя.',
  },
];
---

<Page
  title="Юридические услуги в арбитражных судах — Томск"
  description={description}
  h1="Юридические услуги в арбитражных судах"
  eyebrow="Споры компаний и ИП"
  crumbs={[{ name: 'Услуги в арбитражных судах', href: url }]}
  facts={[
    ['Иск или отзыв', 'от 10 000 ₽'],
    ['Первая инстанция', 'от 30 000 ₽'],
    ['Апелляция', 'от 10 000 ₽'],
    ['Кассация', 'от 20 000 ₽'],
  ]}
  faq={faq}
  topic="Юридические услуги в арбитражном суде"
  faqTitle="Частые вопросы об арбитражных спорах"
  expert
  heroBg={heroBg}
  formTitle="Оценю перспективы спора"
  formText="Расскажите коротко о споре или пришлите номер дела. Скажу, какие есть аргументы, и назову цену до начала работы."
  schema={[serviceSchema({ name: 'Юридические услуги в арбитражных судах', url, description, price: 10000, serviceType: 'Представление интересов в арбитражном суде' })]}
  related={[
    { href: '/predstavitelstvo-v-dele-o-bankrotstve/', label: 'Представительство в деле о банкротстве', text: 'Заседания по делам о банкротстве граждан и компаний.' },
    { href: '/bankrotstvo-ur-lica/', label: 'Банкротство ООО и АО', text: 'Процедуры, сроки и риски для директора.' },
    { href: '/yuridicheskie-uslugi/', label: 'Цены', text: 'Все юридические услуги в одном прайсе.' },
  ]}
>
  <Fragment slot="lead">
    <p>{nb('Составлю иск или отзыв, подготовлю жалобу и представлю интересы компании или ИП в арбитражном суде любой инстанции — не только в делах о банкротстве')}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Инстанции -->
    <LpSection id="instancii" chip="Инстанции" title="Представительство во всех инстанциях" lead="Можно подключиться на любой стадии: в первой инстанции, при обжаловании решения или в кассации" bg="grey">
      <ul class="bz-grid is-3">
        {stages.map(([h, t, p], i) => (
          <li class="bz-card">
            <span class="bz-n tnum">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="bz-h">{nb(h)}</h3>
            <p class="bz-t">{nb(t)}</p>
            <p class="dg-price">{p}</p>
          </li>
        ))}
      </ul>
      <a href="#zayavka" class="lp-strip">
        <span>{nb('В первой инстанции к цене добавляется 7 % от взысканной суммы.')} {nb('Расскажите о споре — назову цену до начала работы')}</span>
        <span class="lp-arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
    </LpSection>

    <!-- Кто ведёт дело -->
    <Lawyer />

    <!-- Цены -->
    <LpSection id="ceny" chip="Цены" title="Сколько стоят услуги в арбитражном суде" lead="Цена «от» — минимальная стоимость простого дела. Итоговую называю до начала работы и фиксирую в договоре" bg="grey">
      <section class="pr-card" aria-labelledby="arb-h">
        <div>
          <h3 id="arb-h" class="pr-h">{nb(arb.title)}</h3>
          <p class="pr-t">{nb('Транспортные и командировочные расходы по делам вне Томска оплачиваются отдельно')}</p>
        </div>
        <ul>
          {arb.rows.map((r) => (
            <li class="pr-row">
              <span class="pr-s">{nb(r.service)}{r.note && <span class="pr-note">{nb(r.note)}</span>}</span>
              <span class="pr-p tnum">{r.price}</span>
            </li>
          ))}
        </ul>
      </section>
    </LpSection>

    <HomeReviews />
  </Fragment>
</Page>
