---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import LpSection from '../components/LpSection.astro';
import Lawyer from '../components/Lawyer.astro';
import HomeReviews from '../components/HomeReviews.astro';
import { nb } from '../data/typo';
import { law, rub, pricing, contacts } from '../data/site';
import { serviceSchema } from '../data/schema';
import heroBg from '../assets/konsultaciya/hero-bg.jpg';
import imgOffice from '../assets/photos/office.jpg';
import imgOnline from '../assets/konsultaciya/online.jpg';
import '../styles/lp.css';

const url = '/konsultaciya-po-bankrotstvu/';
const description = 'Консультация по банкротству в Томске: устная — бесплатно, письменная с анализом документов — от 3 000 ₽. Скажу, какая процедура подходит.';

// Что разберём (по тексту этапа «Консультация» и блоку юриста)
const topics: [string, string][] = [
  ['Долги и кредиторы', 'Кредиты, микрозаймы, налоги, ЖКХ, расписки — какие спишут, а какие останутся'],
  ['Доходы и имущество', 'Что сохранится по закону, а что могут продать на торгах'],
  ['Сделки за 3 года', 'Продажи, дарения и переоформления, которые управляющий может оспорить'],
  ['Процедура и цена', 'Подходит ли банкротство, какая процедура и сколько это будет стоить вместе с обязательными расходами'],
];
const bring = [
  'Кредитные договоры, справки о задолженности, судебные решения',
  'Сведения об исполнительных производствах',
  'Документы на имущество',
  'Документы о сделках с имуществом за 3 года',
];

const faq = [
  {
    q: 'Сколько стоит консультация по банкротству?',
    a: `Устная консультация — бесплатно. Письменная консультация с анализом документов и правовой позицией по вопросу — от 3 000 ₽, цена зависит от объёма документов.`,
  },
  {
    q: 'Что будет после консультации?',
    a: `Если банкротство вам подходит, можно заказать сопровождение под ключ — от ${rub(pricing.citizenTurnkey)}, рассрочка от ${rub(pricing.citizenInstallmentFrom)} в месяц, — или отдельные услуги: подготовку заявления или представительство в суде. Итоговую цену называю до начала работы и фиксирую в договоре.`,
  },
  {
    q: 'Какие расходы будут кроме оплаты юриста?',
    a: `Закон требует внести ${rub(law.fuDeposit)} на депозит суда для вознаграждения финансового управляющего и оплатить публикации в ЕФРСБ и «Коммерсанте». Эти суммы платит любой заявитель — с юристом или без.`,
  },
  {
    q: 'Кто проводит консультацию?',
    a: 'Я сам — Антонец Юрий Анатольевич, арбитражный управляющий. В банкротстве больше 25 лет, провёл 250+ процедур банкротства.',
  },
  {
    q: 'Можно ли проконсультироваться по телефону?',
    a: 'Да. Позвоните или напишите — отвечу сам. Для точного ответа лучше показать документы: кредитные договоры, справки о задолженности, сведения об исполнительных производствах.',
  },
  {
    q: 'Можно ли обанкротиться, если долг меньше 500 000 ₽?',
    a: 'Да. Порог 500 000 ₽ определяет, когда гражданин обязан подать заявление. Подать по собственному желанию можно при любой сумме, если вы не можете платить: прекратили расчёты с кредиторами, больше 10 % долгов просрочено дольше месяца или долг больше стоимости имущества.',
  },
];
---

<Page
  title="Консультация по банкротству в Томске"
  description={description}
  h1="Консультация по банкротству в Томске"
  eyebrow="Для граждан"
  crumbs={[{ name: 'Консультации по вопросам банкротства', href: url }]}
  faq={faq}
  topic="Консультация по банкротству"
  heroBg={heroBg}
  heroPortrait
  formTitle="Запишитесь на бесплатную консультацию"
  formText="Расскажите коротко о долгах и имуществе. Перезвоню, договоримся о времени и скажу, какие документы взять с собой."
  schema={[serviceSchema({ name: 'Консультация по банкротству', url, description, serviceType: 'Консультация по вопросам банкротства граждан' })]}
  related={[
    { href: '/bankrotstvo-fizicheskih-lic/', label: 'Банкротство физических лиц', text: 'Кому подходит, какие долги спишут, что сохранится.' },
    { href: '/podgotovka-dokumentov-na-bankrotstvo/', label: 'Подготовка документов', text: 'Заявление о признании банкротом и список кредиторов.' },
    { href: '/yuridicheskie-uslugi/', label: 'Цены', text: 'Все юридические услуги в одном прайсе.' },
  ]}
>
  <Fragment slot="lead">
    <p>{nb('Разберу долги, доходы, имущество и сделки за 3 года и скажу, подходит ли вам банкротство, какая процедура и есть ли риски. Устная консультация — бесплатно, письменная — от 3 000 ₽')}</p>
  </Fragment>

  <Fragment slot="after">
    <!-- Устная и письменная -->
    <LpSection id="formaty" chip="Форматы" title="Консультация в офисе или онлайн" lead="Устная консультация — бесплатно, в любом формате" bg="grey">
      <div class="lp-two">
        <div class="lp-card lp-blue">
          <Image src={imgOffice} alt="Кабинет арбитражного управляющего Антонца в офисе на ул. Тверской, 14" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 45vw, 100vw" class="fm-img" loading="lazy" />
          <p class="lp-k">Устная консультация</p>
          <h3 class="fm-h">В офисе</h3>
          <p class="lp-t">{nb(`Томск, ${contacts.street}. ${contacts.hoursDays}, ${contacts.hoursNote}`)}</p>
          <a href="#zayavka" class="bl-btn">Записаться</a>
        </div>
        <div class="lp-card">
          <Image src={imgOnline} alt="Ноутбук, наушники, телефон и документы на столе дома" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 45vw, 100vw" class="fm-img" loading="lazy" />
          <p class="lp-k">Устная консультация</p>
          <h3 class="fm-h is-dark">Онлайн</h3>
          <p class="lp-t is-dark">{nb('В Telegram или WhatsApp — без поездки в офис. Подойдёт, если вы не в Томске: помогаю с банкротством в Новосибирской и Кемеровской областях, Алтайском и Краснодарском краях')}</p>
          <a href="#zayavka" class="lp-btn is-bottom">Записаться</a>
        </div>
      </div>
      <a href="#zayavka" class="lp-strip">
        <span>{nb('Письменная консультация — анализ документов и правовая позиция по вашему вопросу, от 3 000 ₽. Цена зависит от объёма документов')}</span>
        <span class="lp-arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
    </LpSection>

    <!-- Что разберём -->
    <LpSection id="chto-razberem" chip="Что разберём" title="Что разберём на консультации" lead="Говорю, какая процедура подходит: реструктуризация, реализация имущества или мировое соглашение">
      <ul class="bz-grid is-4">
        {topics.map(([h, t], i) => (
          <li class="bz-card">
            <span class="bz-n tnum">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="bz-h">{nb(h)}</h3>
            <p class="bz-t">{nb(t)}</p>
          </li>
        ))}
      </ul>
    </LpSection>

    <!-- Кто консультирует -->
    <Lawyer />

    <!-- Что взять -->
    <LpSection id="chto-vzyat" chip="Подготовка" title="Что взять на консультацию" lead="Не обязательно собирать всё — возьмите то, что есть. По документам ответ будет точнее" bg="grey">
      <div class="lp-two">
        <div class="lp-card">
          <p class="lp-k">Если есть</p>
          <h3 class="lp-h3">Документы, которые помогут</h3>
          <ul class="lp-signs">
            {bring.map((t) => <li><span class="lp-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb(t)}</span></li>)}
          </ul>
        </div>
        <div class="lp-card">
          <p class="lp-k">После консультации</p>
          <h3 class="lp-h3">Если банкротство подходит</h3>
          <p class="lp-t is-dark">{nb(`Сопровождение под ключ — от ${rub(pricing.citizenTurnkey)}, рассрочка от ${rub(pricing.citizenInstallmentFrom)} в месяц. Или отдельные услуги: подготовка заявления — от 12 000 ₽, представительство в суде — от 5 000 ₽ за заседание`)}</p>
          <a href="/yuridicheskie-uslugi/" class="lp-btn is-bottom">Все цены</a>
        </div>
      </div>
    </LpSection>

    <HomeReviews />
  </Fragment>
</Page>

<style>
  /* картинки в карточках «Форматы» (26.11.2026) */
  .fm-h { margin-top: 0.375rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.75rem, 2.6vw, 2.5rem); line-height: 1.05; letter-spacing: -0.02em; color: #fff; }
  .fm-h.is-dark { color: #1d1e21; }
  .fm-h + .lp-t { margin-bottom: 1.5rem; }
  .fm-img { display: block; width: 100%; aspect-ratio: 3 / 2; height: auto; object-fit: cover; border-radius: 12px; margin-bottom: clamp(1.25rem, 2vw, 1.75rem); }
  #chto-vzyat .lp-t.is-dark { margin-bottom: 1.5rem; }
</style>
