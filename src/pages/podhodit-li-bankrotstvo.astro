---
import Page from '../layouts/Page.astro';
import HomeQuiz from '../components/HomeQuiz.astro';
import HomeLimits from '../components/HomeLimits.astro';
import HomeCases from '../components/HomeCases.astro';
import HomeReviews from '../components/HomeReviews.astro';
import { nb } from '../data/typo';
import { questions } from '../data/quiz';
import heroBg from '../assets/proverka/hero-bg.jpg';

/**
 * Страница квиза «Подходит ли вам банкротство» (25.11.2026): на неё ведёт карточка в меню «Услуги»
 * (раньше вела на якорь #proverka, который есть только на главной). Квиз — тот же HomeQuiz, что на главной.
 */
const url = '/podhodit-li-bankrotstvo/';
const description = `Проверьте за пару минут, можно ли списать ваши долги через банкротство: ${questions.length} вопросов, предварительный вывод и главные риски. Бесплатно.`;

const faq = [
  {
    q: 'Можно ли обанкротиться, если долг меньше 500 000 ₽?',
    a: 'Да. Порог 500 000 ₽ определяет, когда гражданин обязан подать заявление. Подать по собственному желанию можно при любой сумме, если вы не можете платить: прекратили расчёты с кредиторами, больше 10 % долгов просрочено дольше месяца или долг больше стоимости имущества.',
  },
  {
    q: 'Какие долги не спишут?',
    a: 'Алименты, возмещение вреда жизни и здоровью, зарплатные долги перед работниками, субсидиарную ответственность и долги, возникшие из-за мошенничества или сокрытия имущества. Суд также может не освободить от долгов должника, который скрыл доход или имущество от управляющего.',
  },
  {
    q: 'Насколько точен результат проверки?',
    a: 'Это предварительный вывод по вашим ответам. Точный ответ можно дать только по документам: кредитным договорам, сведениям о доходах, имуществе и сделках за 3 года. Их разбираю на бесплатной консультации.',
  },
  {
    q: 'Что делать после проверки?',
    a: 'Оставьте заявку или позвоните — договоримся о бесплатной консультации. Скажу, подходит ли вам банкротство, какая процедура и сколько это будет стоить.',
  },
];
---

<Page
  title="Подходит ли вам банкротство — проверка за 2 минуты"
  description={description}
  h1="Подходит ли вам банкротство"
  eyebrow="Проверка за пару минут"
  crumbs={[{ name: 'Подходит ли вам банкротство', href: url }]}
  faq={faq}
  faqTitle="Частые вопросы перед банкротством"
  topic="Проверка: подходит ли банкротство"
  heroBg={heroBg}
  heroBgPos="80% 18%"
  ctaHref="#proverka"
  ctaLabel="Пройти проверку"
  formTitle="Разберу вашу ситуацию бесплатно"
  formText="Расскажите коротко о долгах. Перезвоню, договоримся о консультации и скажу, подходит ли вам банкротство."
  related={[
    { href: '/bankrotstvo-fizicheskih-lic/', label: 'Банкротство физических лиц', text: 'Кому подходит, какие долги спишут, что сохранится.' },
    { href: '/konsultaciya-po-bankrotstvu/', label: 'Консультация', text: 'Устная — бесплатно, письменная — от 3 000 ₽.' },
    { href: '/bankrotstvo-v-rassrochku/', label: 'Рассрочка', text: 'От 10 000 ₽ в месяц, без процентов и без банка.' },
  ]}
>
  <Fragment slot="lead">
    <p>{nb('Короткая проверка прямо на этой странице. Если банкротство не подойдёт — подскажу другой путь: реструктуризацию или переговоры с банком')}</p>
  </Fragment>

  <Fragment slot="after">
    <HomeQuiz />
    <HomeLimits />
    <HomeReviews />
    <HomeCases />
  </Fragment>
</Page>
