---
/**
 * Шаблон посадочной/контентной страницы в стиле новой главной (18.11.2026):
 * синяя полоса (шапка, крошки, плашка, H1, прямой ответ, кнопки, цифры) → текст с липкой карточкой справа →
 * слот after (блоки с главной: кейсы, отзывы…) → FAQ → «по теме» → форма и контакты.
 */
import Base from './Base.astro';
import Byline from '../components/Byline.astro';
import HomeFaq from '../components/HomeFaq.astro';
import LeadForm from '../components/LeadForm.astro';
import { contacts, knowMenu, person } from '../data/site';
import portrait from '../assets/antonets-hero.png';
import { nb } from '../data/typo';
import { faqSchema, type Crumb } from '../data/schema';
import { Image } from 'astro:assets';
import imgMyths from '../assets/blog/myths.jpg';
import imgManager from '../assets/blog/manager.jpg';
import imgCourt from '../assets/blog/court.jpg';
import imgMfc from '../assets/blog/mfc.jpg';

interface Props {
  title: string;
  description: string;
  h1: string;
  eyebrow?: string;
  crumbs: Crumb[];
  facts?: [string, string][];
  faq?: { q: string; a: string }[];
  related?: { href: string; label: string; text: string }[];
  schema?: Record<string, unknown>[];
  published?: string;
  ogType?: 'website' | 'article';
  formTitle?: string;
  formText?: string;
  topic?: string;
  cta?: boolean;
  /** плашка с фото управляющего рядом с кнопкой на первом экране */
  expert?: boolean;
}
const {
  title, description, h1, eyebrow, crumbs, facts = [], faq = [], related = [], schema = [],
  published, ogType = 'website', formTitle, formText, topic, cta = true, expert = false,
} = Astro.props;
const allSchema = [...schema, ...(faq.length ? [faqSchema(faq)] : [])];
// страница из блоков (без сплошного текста) — тогда отметка «Обновлено» уходит в синюю полосу
const hasBody = Astro.slots.has('default');

/**
 * Блок «Всё о банкротстве» внизу страницы: пункты меню шапки «Все о банкротстве», у которых уже есть страница.
 * Рубрика — колонка меню. Текущая страница не показывается, максимум 3 карточки.
 */
const relInfo: Record<string, { img: ImageMetadata; text: string }> = {
  '/bankrotstvo-fizicheskih-lic/': { img: imgCourt, text: 'Кому подходит, какие долги спишут, что сохранится из имущества и сколько это стоит. Этапы процедуры и ограничения после неё' },
  '/bankrotstvo-fizicheskih-lic/cherez-mfc/': { img: imgMfc, text: 'Бесплатно при долге до 1 млн ₽ и оконченном исполнительном производстве. Через 6 месяцев долги из заявления списываются' },
  '/stati/kto-takoj-arbitrazhnyj-upravlyayushchij/': { img: imgManager, text: 'Требования к управляющему, виды, СРО, кто его выбирает и сколько ему платят. Отдельно — как проверить управляющего до начала дела' },
  '/stati/mify-o-bankrotstve-grazhdan/': { img: imgMyths, text: 'Спишут ли все долги, заберут ли зарплату и квартиру, дадут ли кредит после процедуры. Разбираю 10 частых мифов и что на самом деле говорит закон' },
};
const here = Astro.url.pathname.replace(/\/?$/, '/');
const relArticles = knowMenu
  .flatMap((c) => c.items.filter((i) => i.href && relInfo[i.href]).map((i) => ({ href: i.href, label: i.label, tag: c.title, ...relInfo[i.href] })))
  .filter((a) => !here.endsWith(a.href))
  .slice(0, 3);
---
<Base title={title} description={description} crumbs={crumbs} schema={allSchema} ogType={ogType}>
  <Fragment slot="top">
    <div class="ph">
      <h1 class="ph-title">{nb(h1)}</h1>
      <div class="ph-lead"><slot name="lead" /></div>
      {cta && (
        <div class="ph-actions" data-ph-actions>
          <a href="#zayavka" class="ph-btn">Бесплатная консультация</a>
        </div>
      )}
      {facts.length > 0 && (
        <dl class={`ph-facts${expert ? ' has-person' : ''}`}>
          {expert && (
            <div class="ph-fact ph-person">
              <dt class="sr-only">Ведёт дело</dt>
              <dd>
                <Image src={portrait} alt="" widths={[120, 180]} sizes="60px" class="ph-person-img" loading="eager" />
                <span><b>{person.name}</b><span>{person.job.toLowerCase()}</span></span>
              </dd>
            </div>
          )}
          {facts.map(([k, v]) => (
            <div class="ph-fact">
              <dt>{nb(k)}</dt>
              <dd class="tnum">{v}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </Fragment>

  {hasBody && (
  <article class="pg">
    <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
      <div class="pg-grid">
        <div class="prose-legal pg-prose min-w-0">
          <Byline published={published} />
          <slot />
        </div>
        <aside class="pg-aside" aria-label="Связаться">
          <div class="pg-card">
            <span class="ph-sq ph-sq-blue" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <p class="pg-card-title">{nb('Разберу вашу ситуацию бесплатно')}</p>
            <p class="pg-card-text">{nb('По телефону или в офисе на ул. Тверской, 14. Первая консультация бесплатная')}</p>
            <a href="#zayavka" class="pg-card-btn">Оставить заявку</a>
            <a href={contacts.phone2Href} class="pg-card-phone tnum">{contacts.phone2}</a>
          </div>
        </aside>
      </div>
    </div>
  </article>
  )}

  <slot name="after" />

  {faq.length > 0 && <HomeFaq items={faq} />}

  {relArticles.length > 0 && (
    <section class="rel" aria-labelledby="related-title">
      <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
        <span class="rel-chip"><span class="rel-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Блог</span>
        <h2 id="related-title" class="rel-title">Всё о банкротстве</h2>
        <ul class="rel-grid">
          {relArticles.map((a) => (
            <li>
              <a href={a.href} class="rel-card">
                <Image src={a.img} alt="" widths={[400, 640]} sizes="(min-width: 768px) 30vw, 90vw" class="rel-img" loading="lazy" />
                <span class="rel-body">
                  <span class="rel-meta"><span class="rel-tag">{a.tag}</span></span>
                  <span class="rel-name">{nb(a.label)}</span>
                  <span class="rel-text">{nb(a.text.replace(/\.$/, ''))}</span>
                  <span class="rel-arrow" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/stati/" class="rel-more">Все статьи блога</a>
      </div>
    </section>
  )}

  <LeadForm title={formTitle} text={formText} topic={topic} />

  {cta && (
    <div class="mbar" data-mbar aria-hidden="true">
      <a href={contacts.phoneHref} class="mbar-call" aria-label={`Позвонить ${contacts.phone}`} tabindex="-1">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
      </a>
      <a href="#zayavka" class="mbar-btn" tabindex="-1">Бесплатная консультация</a>
    </div>
  )}
</Base>

<script>
  // Нижняя панель на телефоне: появляется, когда кнопка первого экрана ушла вверх, и прячется у формы заявки
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const hero = document.querySelector<HTMLElement>('[data-ph-actions]');
  const form = document.getElementById('zayavka');
  if (bar && hero) {
    const upd = () => {
      const show = hero.getBoundingClientRect().bottom < 0 && (!form || form.getBoundingClientRect().top > window.innerHeight);
      bar.classList.toggle('is-on', show);
      bar.setAttribute('aria-hidden', String(!show));
      bar.querySelectorAll('a').forEach((a) => (a.tabIndex = show ? 0 : -1));
    };
    window.addEventListener('scroll', upd, { passive: true });
    window.addEventListener('resize', upd);
    upd();
  }
</script>

<style>
  /* Заголовок страницы в синей полосе */
  .ph { max-width: none; }
  .ph-title { max-width: 62rem; }
  .ph-chip {
    display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.625rem 1.125rem; border-radius: 8px;
    background: rgb(255 255 255 / 0.12); font-size: clamp(1rem, 1.1vw, 1.1875rem); line-height: 1.2; color: #fff;
  }
  .ph-sq { display: grid; grid-template-columns: 5px 5px; grid-auto-rows: 5px; gap: 2px; flex: none; }
  .ph-sq i { width: 5px; height: 5px; border-radius: 1px; background: #fff; }
  .ph-sq-blue i { background: #034b8e; }
  .ph-title { margin-top: clamp(0.5rem, 1.2vw, 1rem); font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h1); line-height: 1.04; letter-spacing: -0.025em; color: #fff; text-wrap: balance; }
  /* отступы и кнопка — как на первом экране главной */
  .ph-lead { margin-top: clamp(1.25rem, 1.9vw, 1.75rem); max-width: 52rem; font-size: var(--fs-lead); line-height: 1.4; letter-spacing: -0.01em; color: rgb(255 255 255 / 0.88); text-wrap: pretty; }
  .ph-lead :global(a) { color: #fff; }
  .ph-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-top: clamp(2.5rem, 3.2vw, 3rem); }
  .ph-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: clamp(3.75rem, 8.5vh, 4.75rem); padding: 0 2.5rem;
    border-radius: 10px; background: #034b8e; color: #fff; font-size: clamp(1.0625rem, min(1.5vw, 2.8vh), 1.625rem); font-weight: 600; text-decoration: none;
    transition: background-color 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .ph-btn:hover { background: #0a5aa6; }
  .ph-btn:active { transform: scale(0.98); }
  .ph-btn-glass { background: rgb(255 255 255 / 0.12); font-weight: 600; }
  .ph-btn-glass:hover { background: rgb(255 255 255 / 0.2); }
  .ph-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  @media (max-width: 639px) { .ph-btn { width: 100%; } }
  @media (min-width: 1024px) { .ph-btn { font-weight: 400; } }
  /* Цифры — одна стеклянная полоса с тонкими разделителями (вариант A, 19.11.2026) */
  .ph-facts {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.25rem; margin-top: clamp(2.5rem, 4vw, 3.5rem);
    padding: 1.5rem 0; border-radius: 16px; background: rgb(255 255 255 / 0.08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
  }
  @media (min-width: 1024px) { .ph-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ph-fact { position: relative; display: flex; flex-direction: column; gap: 0.5rem; padding: 0 1.25rem; }
  @media (min-width: 1024px) {
    .ph-fact { padding: 0 1.75rem; }
    .ph-fact + .ph-fact::before { content: ''; position: absolute; left: 0; top: 12%; bottom: 12%; width: 1px; background: rgb(255 255 255 / 0.18); }
  }
  .ph-fact dt { font-size: 0.9375rem; line-height: 1.35; color: rgb(255 255 255 / 0.65); }
  .ph-fact dd { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.375rem, 1.9vw, 1.75rem); line-height: 1.1; letter-spacing: -0.02em; color: #fff; }
  /* на телефоне — строки «подпись слева, цифра справа», чтобы «₽/мес» не переносилось */
  @media (max-width: 639px) {
    .ph-facts { grid-template-columns: minmax(0, 1fr); row-gap: 0; padding: 0.25rem 0; }
    .ph-fact { flex-direction: row; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0.875rem 1.25rem; }
    .ph-fact + .ph-fact::before { content: ''; position: absolute; top: 0; left: 1.25rem; right: 1.25rem; height: 1px; background: rgb(255 255 255 / 0.14); }
    .ph-fact dd { flex: none; font-size: 1.25rem; white-space: nowrap; text-align: right; }
  }
  /* Юрист — первая ячейка полосы (вариант C, 21.11.2026). Отступ слева = отступу справа у последней цифры */
  .ph-person { grid-column: 1 / -1; padding-bottom: 1.25rem; }
  .ph-person::after { content: ''; position: absolute; left: 1.25rem; right: 1.25rem; bottom: 0; height: 1px; background: rgb(255 255 255 / 0.14); }
  .ph-person dd { flex: 1 1 auto; min-width: 0; display: flex; align-items: center; gap: 0.875rem; font: inherit; letter-spacing: 0; text-align: left; white-space: normal; }
  .ph-person-img { flex: none; box-sizing: border-box; width: 3.75rem; height: 3.75rem; padding-top: 0.5rem; border-radius: 12px; object-fit: cover; object-position: 50% 0; background: #e6eef8; }
  .ph-person b { display: block; font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; line-height: 1.2; color: #fff; }
  .ph-person b + span { display: block; margin-top: 0.25rem; font-size: 0.875rem; line-height: 1.3; color: rgb(255 255 255 / 0.7); }
  .ph-person + .ph-fact::before { display: none; }
  @media (min-width: 1024px) { .ph-person::after { left: 1.75rem; right: 1.75rem; } }
  @media (max-width: 639px) {
    .ph-person { padding: 0.875rem 1.25rem; }
    .ph-person::after { display: none; }
    .ph-person + .ph-fact::before { display: block; }
  }
  @media (min-width: 1280px) {
    .ph-facts.has-person { grid-template-columns: minmax(0, 1.25fr) repeat(4, auto); align-items: center; }
    .ph-facts.has-person .ph-fact:not(.ph-person) dd { white-space: nowrap; }
    .ph-person { grid-column: auto; padding-bottom: 0; }
    .ph-person::after { display: none; }
    .ph-person + .ph-fact::before { display: block; }
  }

  /* Текст и липкая карточка */
  .pg { padding: clamp(2.5rem, 4vw, 3.5rem) 0 clamp(3rem, 5vw, 4.5rem); background: #fff; }
  .pg-grid { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) { .pg-grid { grid-template-columns: minmax(0, 1fr) 20rem; gap: clamp(3rem, 6vw, 6rem); } }
  .pg-prose { max-width: 50rem; font-size: var(--fs-body); }
  .pg-prose :global(> p:first-child) { margin-top: 0; }
  .pg-aside { display: none; }
  @media (min-width: 1024px) { .pg-aside { display: block; } }
  .pg-card { position: sticky; top: 6.75rem; display: flex; flex-direction: column; padding: 1.75rem; border-radius: 18px; background: #f3f4f6; }
  .pg-card-title { margin-top: 1.25rem; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -0.015em; color: #1d1e21; }
  .pg-card-text { margin-top: 0.75rem; font-size: 1rem; line-height: 1.45; color: #5f646d; }
  .pg-card-btn {
    display: flex; align-items: center; justify-content: center; min-height: 3.25rem; margin-top: 1.5rem;
    border-radius: 10px; background: #034b8e; color: #fff; font-weight: 500; text-decoration: none; transition: background-color 150ms var(--ease-out);
  }
  .pg-card-btn:hover { background: #0a5aa6; }
  .pg-card-phone { margin-top: 1rem; text-align: center; font-family: var(--font-sans); font-weight: 700; font-size: 1.25rem; color: #1d1e21; text-decoration: none; }
  .pg-card-phone:hover { color: #034b8e; }

  /* Плашка с управляющим рядом с кнопкой первого экрана */

  /* Нижняя панель на телефоне */
  .mbar { position: fixed; z-index: 40; left: 0.75rem; right: 0.75rem; bottom: 0.75rem; display: none; gap: 0.5rem; padding: 0.5rem; border-radius: 16px; background: rgb(29 30 33 / 0.92); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: 0 10px 30px rgb(0 0 0 / 0.2); transform: translateY(calc(100% + 1rem)); transition: transform 200ms var(--ease-out); }
  .mbar.is-on { transform: none; }
  @media (max-width: 767px) { .mbar { display: flex; } }
  .mbar-call { display: grid; flex: none; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 10px; background: rgb(255 255 255 / 0.12); color: #fff; }
  .mbar-btn { display: flex; flex: 1; align-items: center; justify-content: center; height: 3.25rem; border-radius: 10px; background: #034b8e; color: #fff; font-weight: 600; font-size: 1rem; text-decoration: none; }
  /* По этой теме */
  .rel { padding: clamp(2.5rem, 4vw, 3.5rem) 0; background: #f3f4f6; }
  .rel-title { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.08; letter-spacing: -0.025em; color: #1d1e21; }
  .rel-grid { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); margin-top: clamp(1.25rem, 2.4vw, 2rem); }
  @media (min-width: 768px) { .rel-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .rel-card { display: flex; flex-direction: column; height: 100%; overflow: hidden; border-radius: 16px; background: #fff; color: #1d1e21; text-decoration: none; transition: box-shadow 150ms var(--ease-out); }
  .rel-card:hover { box-shadow: inset 0 0 0 2px #034b8e; }
  .rel-img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; transition: transform 300ms var(--ease-out); }
  .rel-card:hover .rel-img { transform: scale(1.03); }
  .rel-body { position: relative; z-index: 1; display: flex; flex: 1; flex-direction: column; padding: clamp(1.25rem, 2vw, 1.75rem); background: #fff; }
  .rel-chip { display: inline-flex; align-items: center; gap: 0.75rem; margin-bottom: clamp(1.25rem, 2vw, 1.75rem); padding: 0.625rem 1.125rem; border-radius: 8px; background: #fff; font-size: clamp(1rem, 1.1vw, 1.1875rem); line-height: 1.2; color: #1d1e21; }
  .rel-sq { display: grid; grid-template-columns: 5px 5px; grid-auto-rows: 5px; gap: 2px; }
  .rel-sq i { width: 5px; height: 5px; border-radius: 1px; background: #034b8e; }
  /* «Все статьи блога» — обычная синяя кнопка под карточками (на телефоне на всю ширину) */
  .rel-more { display: inline-flex; align-items: center; justify-content: center; min-height: 3.25rem; margin-top: clamp(1.25rem, 2.4vw, 2rem); padding: 0 1.75rem; border-radius: 10px; background: #034b8e; color: #fff; font-weight: 600; font-size: 1rem; text-decoration: none; transition: background-color 150ms var(--ease-out); }
  .rel-more:hover { background: #0a5aa6; }
  .rel-more:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; }
  @media (max-width: 639px) { .rel-more { display: flex; } }
  .rel-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.875rem; margin-bottom: 0.875rem; font-size: 0.875rem; color: #7c818a; }
  .rel-tag { padding: 0.3125rem 0.625rem; border-radius: 8px; background: #e6eef8; font-size: 0.875rem; font-weight: 500; line-height: 1.3; color: #034b8e; }
  .rel-name { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -0.015em; }
  .rel-text { margin-top: 0.625rem; font-size: var(--fs-body); line-height: 1.45; color: #7c818a; }
  .rel-arrow { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; margin-top: auto; border-radius: 8px; background: #f3f4f6; color: #1d1e21; transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out); }
  .rel-card .rel-arrow { margin-top: 1.5rem; }
  .rel-card:hover .rel-arrow { background: #034b8e; color: #fff; }
  .rel-card:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; }
</style>
