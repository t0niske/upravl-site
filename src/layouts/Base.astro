---
import '../styles/global.css';
import { SITE_URL, contacts, person, mainNav, services } from '../data/site';
import { orgSchema, websiteSchema, breadcrumbSchema, type Crumb } from '../data/schema';
import PageTop from '../components/PageTop.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CookieNotice from '../components/CookieNotice.astro';

interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** true — страница рисует свою шапку внутри первого экрана (главная) */
  hideHeader?: boolean;
}

const { title, description, crumbs = [], schema = [], noindex = false, ogType = 'website', hideHeader = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE_URL).href;
const ogImage = `${SITE_URL}/og/antonec.jpg`;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    orgSchema(),
    websiteSchema(),
    ...(crumbs.length ? [breadcrumbSchema([{ name: 'Главная', href: '/' }, ...crumbs])] : []),
    ...schema,
  ],
};
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#13284a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Арбитражный управляющий Антонец Ю. А." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2">К содержанию</a>

    {!hideHeader && (
      <PageTop crumbs={crumbs}>
        {Astro.slots.has('top') && <slot name="top" />}
      </PageTop>
    )}


    <main id="main">
      <slot />
    </main>

    <SiteFooter />
    <CookieNotice />

  </body>
</html>
