---
import '../styles/global.css';
import { SITE_URL, contacts, person, mainNav, services } from '../data/site';
import { orgSchema, websiteSchema, breadcrumbSchema, type Crumb } from '../data/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CookieNotice from '../components/CookieNotice.astro';

interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** true — страница рисует свою шапку внутри первого экрана (главная) */
  hideHeader?: boolean;
}

const { title, description, crumbs = [], schema = [], noindex = false, ogType = 'website', hideHeader = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE_URL).href;
const ogImage = `${SITE_URL}/og/antonec.jpg`;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    orgSchema(),
    websiteSchema(),
    ...(crumbs.length ? [breadcrumbSchema([{ name: 'Главная', href: '/' }, ...crumbs])] : []),
    ...schema,
  ],
};
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#13233d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Арбитражный управляющий Антонец Ю. А." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2">К содержанию</a>

    {!hideHeader && <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-md">
      <div class="wrap flex h-16 items-center justify-between gap-6">
        <a href="/" class="group flex flex-col no-underline" aria-label="Главная: арбитражный управляющий Антонец Ю. А.">
          <span class="font-serif text-[1.25rem] leading-6 font-medium tracking-[-0.01em]">Антонец</span>
          <span class="text-[0.8125rem] leading-4 text-muted">арбитражный управляющий, Томск</span>
        </a>

        <nav aria-label="Основное меню" class="hidden xl:block">
          <ul class="flex items-center gap-1 whitespace-nowrap text-[0.9375rem]">
            {mainNav.map((i) => (
              <li>
                <a href={i.href} class:list={['block rounded-lg px-3 py-1.5 no-underline transition-colors hover:bg-paper-2', isActive(i.href) ? 'bg-paper-2 text-ink' : 'text-ink-2']} aria-current={isActive(i.href) ? 'page' : undefined}>{i.label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex items-center gap-3">
          <a href={contacts.phoneHref} class="tnum hidden whitespace-nowrap font-medium no-underline sm:block">{contacts.phone}</a>
          <a href="#zayavka" class="btn btn-primary hidden !min-h-9 !px-4 text-[0.9375rem] md:inline-flex xl:hidden">Консультация</a>
          <details class="group relative xl:hidden">
            <summary class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-[10px] border border-line-strong bg-card [&::-webkit-details-marker]:hidden" aria-label="Меню">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </summary>
            <nav aria-label="Мобильное меню" class="absolute right-0 top-14 w-72 rounded-[14px] border border-line bg-card p-2 shadow-[0_8px_24px_rgba(23,32,46,0.08)]">
              <ul>
                {mainNav.map((i) => (
                  <li><a href={i.href} class="block rounded-[8px] px-3 py-2.5 no-underline transition-colors hover:bg-paper">{i.label}</a></li>
                ))}
              </ul>
              <a href={contacts.phoneHref} class="tnum mt-1 block rounded-[8px] bg-paper px-3 py-2.5 font-medium no-underline">{contacts.phone}</a>
              <a href={contacts.phone2Href} class="tnum mt-1 block rounded-[8px] bg-paper px-3 py-2.5 font-medium no-underline">{contacts.phone2}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>}

    {crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}

    <main id="main">
      <slot />
    </main>

    <SiteFooter />
    <CookieNotice />

  </body>
</html>
