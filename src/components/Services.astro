---
/**
 * Блок «Услуги» по макету дизайнера (17.11.2026): слева заголовок и кнопка
 * (на компьютере закреплены и едут со скроллом), справа нумерованный список услуг.
 * Пороги долга сверены с seo/BRANDCORE.md (500 000 ₽, 25 000–1 000 000 ₽, 2 000 000 ₽).
 */
import { nb } from '../data/typo';

const items = [
  {
    href: '/bankrotstvo-fizicheskih-lic/',
    title: 'Банкротство через суд',
    text: 'Для долгов от 500 000 ₽, или меньше, если платить уже нечем. Суд списывает долги, а я веду процедуру от сбора документов до завершения дела',
  },
  {
    href: '/bankrotstvo-ip/',
    title: 'Банкротство ИП',
    text: 'Списание личных долгов и долгов по бизнесу: кредиты, налоги, поставщики. Объясню, что будет с имуществом и можно ли продолжать работать',
  },
  {
    href: '/bankrotstvo-ur-lica/',
    title: 'Банкротство компании (ООО)',
    text: 'Законное завершение бизнеса с долгами от 2 000 000 ₽, если просрочка больше 3 месяцев. Провожу процедуру так, чтобы снизить риски для руководителя и собственников',
  },
  {
    href: '/bankrotstvo-ur-lica/subsidiarnaya-otvetstvennost/',
    title: 'Защита от субсидиарной ответственности',
    text: 'Когда долги компании пытаются взыскать с директора или владельца лично. Оценю риски и представлю ваши интересы в суде',
  },
  {
    href: '/bankrotstvo-ur-lica/kreditoram/',
    title: 'Кредиторам',
    text: 'Если компания или человек не возвращает долг. Помогу включиться в реестр требований и защитить ваши интересы в деле о банкротстве',
  },
  {
    href: '/yuridicheskie-uslugi/',
    title: 'Другие юридические услуги',
    text: 'Помогаю и в делах, не связанных с банкротством: консультирую, составляю договоры и иски, представляю интересы в арбитражном суде и судах общей юрисдикции',
  },
];
---

<section id="uslugi" class="services" aria-labelledby="services-title">
  <div class="mx-auto grid w-full max-w-[100rem] gap-10 px-4 sm:px-[3.25rem] lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-[clamp(2rem,3vw,4rem)]">
    <div class="sv-side">
      <span class="sv-chip">
        <span class="grid grid-cols-2 gap-[2px]" aria-hidden="true">
          <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
          <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
        </span>
        Услуги
      </span>
      <h2 id="services-title" class="sv-title">{nb('Проведу банкротство гражданина, ИП или компании')}</h2>
      <p class="sv-lead">{nb('Первая консультация бесплатна. Разберём долги и имущество, и я скажу, какая процедура вам подходит и что будет дальше')}</p>
      <a href="#proverka" class="sv-btn">Обсудить моё дело</a>
    </div>

    <ol class="sv-list">
      {items.map((s, i) => (
        <li>
          <a href={s.href} class="sv-row">
            <span class="sv-num tnum">[{String(i + 1).padStart(2, '0')}]</span>
            <span class="sv-body">
              <span class="sv-row-title">{nb(s.title)}</span>
              <span class="sv-row-text">{nb(s.text)}</span>
            </span>
            <span class="sv-plus" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services {
    background: #fff;
    padding: clamp(3rem, 5.5vw, 5.75rem) 0 clamp(3.5rem, 7vw, 7rem);
  }
  .sv-side { align-self: start; }
  @media (min-width: 1024px) {
    .sv-side { position: sticky; top: 6.75rem; }
  }
  .sv-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1.125rem;
    border-radius: 8px;
    background: #f3f4f6;
    font-size: clamp(1rem, 1.1vw, 1.1875rem);
    line-height: 1.2;
    color: var(--color-ink);
  }
  .sv-title {
    margin-top: clamp(1.5rem, 3.4vw, 3.5rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: #1d1e21;
    text-wrap: pretty;
  }
  .sv-lead {
    margin-top: clamp(1rem, 1.6vw, 1.75rem);
    max-width: 34rem;
    font-size: var(--fs-lead);
    line-height: 1.4;
    color: #5f646d;
    text-wrap: pretty;
  }
  .sv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: clamp(3.5rem, 4.5vw, 4.75rem);
    margin-top: clamp(1.5rem, 2.6vw, 2.75rem);
    padding: 0 2.5rem;
    border-radius: 10px;
    background: #034b8e;
    color: #fff;
    font-size: clamp(1.0625rem, 1.25vw, 1.375rem);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .sv-btn:hover { background: #0a5aa6; }
  .sv-btn:active { transform: scale(0.98); }
  @media (min-width: 640px) { .sv-btn { width: auto; } }

  .sv-list { border-top: 1px solid #dfe1e5; }
  .sv-list > li { border-bottom: 1px solid #dfe1e5; }
  .sv-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    padding: clamp(1.5rem, 2.6vw, 2.5rem) 0 clamp(1.5rem, 2.2vw, 2.125rem);
    color: inherit;
    text-decoration: none;
  }
  .sv-num {
    grid-column: 1 / -1;
    margin-bottom: 0.5rem;
    font-size: clamp(0.9375rem, 1.15vw, 1.25rem);
    line-height: 1.4;
    color: #8a8f98;
  }
  .sv-body { display: flex; flex-direction: column; }
  .sv-row-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #1d1e21;
    text-wrap: pretty;
    transition: color 150ms var(--ease-out);
  }
  .sv-row-text {
    margin-top: clamp(0.625rem, 1vw, 1.125rem);
    max-width: 40rem;
    font-size: var(--fs-body);
    line-height: 1.4;
    color: #7c818a;
    text-wrap: pretty;
  }
  .sv-plus {
    display: grid;
    place-items: center;
    width: clamp(2.75rem, 3.4vw, 3.5rem);
    aspect-ratio: 1;
    border-radius: 6px;
    background: #034b8e;
    color: #fff;
    transition: background-color 150ms var(--ease-out), transform 150ms var(--ease-out);
  }
  .sv-plus svg { width: 46%; height: 46%; }
  .sv-row:hover .sv-row-title { color: #034b8e; }
  .sv-row:hover .sv-plus { background: #0a5aa6; }
  .sv-row:active .sv-plus { transform: scale(0.94); }
  .sv-row:focus-visible { outline: 2px solid #034b8e; outline-offset: 4px; border-radius: 6px; }

  @media (min-width: 640px) {
    .sv-row { grid-template-columns: clamp(3.5rem, 5vw, 5.25rem) minmax(0, 1fr) auto; column-gap: clamp(1rem, 1.6vw, 1.5rem); }
    .sv-num { grid-column: auto; margin-bottom: 0; padding-top: 0.125em; }
  }
</style>
