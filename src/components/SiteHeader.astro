---
/**
 * Шапка-плашка сайта (из первого экрана главной): стекло поверх тёмно-синего фона, меню с выпадающими
 * панелями, телефон, мессенджеры, мобильное меню. Используется на главной и в синей полосе внутренних страниц.
 */
import { Image } from 'astro:assets';
import { contacts, headerNav } from '../data/site';
import { nb } from '../data/typo';
import iconWhatsapp from '../assets/icons/whatsapp.png';
import iconMax from '../assets/icons/max.png';

const path = Astro.url.pathname;
// подсветка текущей страницы в меню (26.11.2026): пункт верхнего меню, в котором лежит страница, и сама строка в выпадающем меню
const isCur = (h?: string) => !!h && h === path;
const activeTop =
  headerNav.find((i) => i.columns?.some((col) => col.items.some((x) => isCur(x.href)))) ??
  headerNav.find((i) => i.children?.some((x) => isCur(x.href))) ??
  headerNav.find((i) => isCur(i.href));
const messengers = [
  { label: 'Telegram', href: contacts.telegram || '/kontakty/', icon: 'telegram' },
  { label: 'WhatsApp', href: contacts.whatsapp || '/kontakty/', icon: 'whatsapp' },
  { label: 'MAX', href: contacts.max || '/kontakty/', icon: 'max' },
];
---

<!-- Шапка: на месте внутри первого экрана; после прокрутки за неё закрепляется сверху (sh-slot держит место) -->
<div class="sh-slot mt-2">
<header class="site-header relative z-30 flex h-[4.5rem] items-center justify-between gap-4 2xl:gap-6 glass rounded-[16px] pr-2 pl-5 lg:h-[calc(clamp(4.25rem,9vh,5.5rem)+8px)] lg:pr-4 lg:pl-8">
  <a href="/" class="flex shrink-0 items-center gap-2.5 whitespace-nowrap font-serif text-[1.125rem] font-bold no-underline lg:text-[1.375rem] 2xl:text-[1.5rem]" aria-label="Главная: арбитражный управляющий Антонец Ю. А.">
    <span class="grid grid-cols-2 gap-[3px]" aria-hidden="true">
      <i class="size-[5px] rounded-[1px] bg-[#3d8bff]"></i><i class="size-[5px] rounded-[1px] bg-[#3d8bff]/60"></i>
      <i class="size-[5px] rounded-[1px] bg-[#3d8bff]/60"></i><i class="size-[5px] rounded-[1px] bg-[#3d8bff]"></i>
    </span>
    Антонец Юрий
  </a>

  <nav aria-label="Основное меню" class="hidden self-stretch xl:flex">
    <ul class="flex h-full items-stretch gap-0.5 whitespace-nowrap text-[1rem] 2xl:gap-1 2xl:text-[1.125rem]">
      {headerNav.map((i) => (
        <li class:list={['group flex items-center', !i.columns && 'relative']}>
          <a href={i.href} class:list={['flex items-center gap-1.5 rounded-[8px] px-2.5 py-2 font-semibold text-white no-underline transition-colors 2xl:px-3.5', i.children ? 'nav-top group-hover:bg-white group-hover:text-[#034B8E]' : 'hover:bg-white/10']} aria-current={path === i.href ? 'page' : undefined} aria-haspopup={i.children ? 'true' : undefined}>
            {i.label}
            {i.children && <svg class="nav-caret transition-transform duration-150 group-hover:rotate-180" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.25 5 7l3.5-3.75z" fill="currentColor" /></svg>}
          </a>

          {i.columns && (
            <div class="menu-drop absolute inset-x-0 top-full z-40 pt-3">
              <div class="menu-panel grid gap-10 px-9 py-7" style={`grid-template-columns: repeat(${i.columns.length}, minmax(0, 1fr))${i.promo ? ' 20rem' : ''}`}>
                {i.columns.map((col) => (
                  <div class="whitespace-normal">
                    <p class="menu-colh">{col.title}</p>
                    <ul class="mt-2">
                      {col.items.map((c) => (
                        <li>
                          {c.href ? (
                            <a href={c.href} class="menu-item" aria-current={isCur(c.href) ? 'page' : undefined}>{nb(c.label)}</a>
                          ) : (
                            <span class="menu-item is-soon">{nb(c.label)}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
                {i.promo && (
                  <a href="/podhodit-li-bankrotstvo/" class="menu-promo">
                    <span class="flex items-start justify-between gap-4">
                      <span class="font-serif text-[1.25rem] leading-[1.15] font-bold text-[#1d1e21]">Можно ли списать ваши долги?</span>
                      <span class="menu-promo-btn" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg></span>
                    </span>
                    <span class="mt-1.5 block text-[0.9375rem] leading-[1.35] text-[#6d737c]">{nb('Ответьте на 6 вопросов — это займёт пару минут')}</span>
                    <span class="qz" aria-hidden="true">
                      <span class="qz-phone">
                        <span class="qz-screen">
                          <span class="qz-step">Вопрос 2 из 6</span>
                          <span class="qz-bar"><i></i></span>
                          <span class="qz-q">Какая сумма долга?</span>
                          <span class="qz-opt">до 500 тыс. ₽</span>
                          <span class="qz-opt is-on">от 500 тыс. до 1 млн ₽</span>
                          <span class="qz-opt">больше 1 млн ₽</span>
                        </span>
                      </span>
                    </span>
                  </a>
                )}
              </div>
            </div>
          )}

          {i.children && !i.columns && (
            <div class="menu-drop absolute top-full left-0 z-40 pt-3">
              <ul class="menu-panel min-w-[16rem] px-5 py-3">
                {i.children.map((c) => (
                  <li><a href={c.href} class="menu-item" aria-current={isCur(c.href) ? 'page' : undefined}>{nb(c.label)}</a></li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))}
    </ul>
  </nav>

  <div class="flex items-center gap-2 lg:gap-3">
    <div class="mr-1 hidden flex-col items-start leading-tight md:flex 2xl:mr-4">
      <a href={contacts.phoneHref} class="tnum whitespace-nowrap text-[1rem] font-semibold text-white no-underline transition-opacity hover:opacity-80 2xl:text-[1.125rem]">{contacts.phone}</a>
      <span class="mt-1 whitespace-nowrap text-[0.8125rem] text-white/85 2xl:text-[0.875rem]">{contacts.hoursDays}</span>
      <span class="whitespace-nowrap text-[0.8125rem] text-white/85 2xl:text-[0.875rem]">{contacts.hoursNote}</span>
    </div>
    {messengers.map((m) => (
      <a href={m.href} class="msg-btn hidden size-11 place-items-center rounded-[8px] bg-white text-[#034B8E] no-underline sm:grid 2xl:size-14" aria-label={m.label}>
        {m.icon === 'telegram' && <svg class="size-7 2xl:size-8" viewBox="0 0 24 24" aria-hidden="true"><path fill="#26A5E4" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" /></svg>}
        {m.icon === 'whatsapp' && <Image src={iconWhatsapp} alt="" width={64} height={64} class="size-7 2xl:size-8" />}
        {m.icon === 'max' && <Image src={iconMax} alt="" width={64} height={64} class="size-7 2xl:size-8" />}
      </a>
    ))}
    <button type="button" class="grid size-11 cursor-pointer place-items-center rounded-[8px] bg-white text-[#034B8E] xl:hidden lg:size-12" aria-label="Открыть меню" aria-expanded="false" aria-controls="m-drawer" data-mnav-open>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>
</header>
</div>

<!-- Мобильное меню: панель выезжает справа, разделы раскрываются по нажатию -->
<div class="m-wrap xl:hidden" data-mnav hidden>
  <div class="m-back" data-mnav-close></div>
  <nav id="m-drawer" class="m-drawer" aria-label="Мобильное меню">
    <div class="m-top">
      <span class="m-title">Меню</span>
      <button type="button" class="m-close" aria-label="Закрыть меню" data-mnav-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <ul class="m-list">
      <li><a href="/" class:list={['m-row', path === '/' && 'is-active']} aria-current={path === '/' ? 'page' : undefined}>Главная</a></li>
      {headerNav.map((i) => (
        <li>
          {i.children ? (
            <details class="m-group" name="m-nav">
              <summary class:list={['m-row', activeTop === i && 'is-active']}>
                {i.label}
                <svg class="m-caret" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </summary>
              <ul class="m-sub">
                {i.children.map((c) => (
                  <li>{c.href ? <a href={c.href} class="m-link" aria-current={path === c.href ? 'page' : undefined}>{nb(c.label)}</a> : <span class="m-link is-soon">{nb(c.label)}</span>}</li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={i.href} class:list={['m-row', activeTop === i && 'is-active']} aria-current={isCur(i.href) ? 'page' : undefined}>{i.label}</a>
          )}
        </li>
      ))}
    </ul>
    <div class="m-foot">
      <div class="m-msgs">
        {messengers.map((m) => (
          <a href={m.href} class="m-msg">
            {m.icon === 'telegram' && <svg class="m-msg-ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="#26A5E4" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" /></svg>}
            {m.icon === 'whatsapp' && <Image src={iconWhatsapp} alt="" width={64} height={64} class="m-msg-ic" />}
            {m.icon === 'max' && <Image src={iconMax} alt="" width={64} height={64} class="m-msg-ic" />}
            {m.label}
          </a>
        ))}
      </div>
      <a href={contacts.phoneHref} class="m-phone tnum">{contacts.phone}</a>
      <p class="m-hours">{nb(`${contacts.hoursDays}, ${contacts.hoursNote}`)}</p>
    </div>
  </nav>
</div>

<script>
  // служебное: /#open-menu-1 открывает первое выпадающее меню (для скриншотов и показа)
  const m = location.hash.match(/^#open-menu-(\d)$/);
  if (m) document.querySelectorAll('.site-header nav > ul > li')[Number(m[1]) - 1]?.classList.add('is-open');

  // закреплённая шапка: когда исходное место шапки ушло за верх экрана, шапка становится fixed
  const slot = document.querySelector<HTMLElement>('.sh-slot');
  const bar = slot?.querySelector<HTMLElement>('.site-header');
  if (slot && bar) {
    let stuck = false;
    const update = () => {
      const s = slot.getBoundingClientRect().bottom < 0;
      if (s === stuck) return;
      stuck = s;
      slot.style.height = s ? `${slot.offsetHeight}px` : '';
      bar.classList.toggle('is-stuck', s);
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }

  // мобильное меню: переносим в body (у шапки backdrop-filter, иначе fixed считается от неё)
  const wrap = document.querySelector<HTMLElement>('[data-mnav]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-mnav-open]');
  if (wrap && openBtn) {
    document.body.append(wrap);
    const setOpen = (open: boolean) => {
      if (open) { wrap.hidden = false; requestAnimationFrame(() => requestAnimationFrame(() => wrap.classList.add('is-open'))); }
      else { wrap.classList.remove('is-open'); setTimeout(() => { if (!wrap.classList.contains('is-open')) wrap.hidden = true; }, 260); }
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) wrap.querySelector<HTMLElement>('.m-close')?.focus({ preventScroll: true });
      else openBtn.focus({ preventScroll: true });
    };
    openBtn.addEventListener('click', () => setOpen(true));
    wrap.querySelectorAll('[data-mnav-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
    wrap.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && wrap.classList.contains('is-open')) setOpen(false); });
    // служебное: /#open-mnav открывает меню (для скриншотов)
    if (location.hash === '#open-mnav') setOpen(true);
  }
</script>

<style>
  /* белые выпадающие меню */
  .menu-drop { visibility: hidden; opacity: 0; transform: translateY(4px); transition: opacity 150ms var(--ease-out), transform 150ms var(--ease-out), visibility 150ms; }
  .group:hover > .menu-drop, .group:has(:focus-visible) > .menu-drop, .group.is-open > .menu-drop { visibility: visible; opacity: 1; transform: none; }
  .group.is-open > a, .group:has(:focus-visible) > .nav-top { background: #fff; color: #034b8e; }
  .group:has(:focus-visible) .nav-caret { transform: rotate(180deg); }
  /* открыто только меню под курсором: остальные (по фокусу или #open-menu) прячутся */
  nav > ul:hover > .group:not(:hover) > .menu-drop { visibility: hidden; opacity: 0; transform: translateY(4px); }
  nav > ul:hover > .group:not(:hover) > .nav-top { background: transparent; color: #fff; }
  nav > ul:hover > .group:not(:hover) .nav-caret { transform: none; }
  .menu-panel { border-radius: 16px; background: #fff; color: #1d1e21; box-shadow: 0 24px 60px rgb(2 14 34 / 0.28); }
  .menu-colh { font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; letter-spacing: -0.01em; padding-bottom: 0.75rem; border-bottom: 1px solid #e7eaef; margin-bottom: 0.375rem; }
  .menu-item { display: flex; align-items: center; gap: 0.75rem; margin: 0 -0.625rem; padding: 0.4375rem 0.625rem; border-radius: 8px; font-size: 1rem; font-weight: 400; line-height: 1.25; color: #1d1e21; text-decoration: none; white-space: normal; transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out); }
  a.menu-item:hover { background: #eef4fb; color: #034b8e; }
  a.menu-item[aria-current='page'] { background: #eef4fb; color: #034b8e; font-weight: 500; }
  .menu-item.is-soon { color: #8a9099; cursor: default; }
  .menu-promo { display: flex; flex-direction: column; overflow: hidden; border-radius: 14px; background: #eef4fb; padding: 1.25rem 1.375rem 0.5rem; text-decoration: none; white-space: normal; }
  .menu-promo-btn { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; flex: none; border-radius: 6px; background: #1d1e21; color: #fff; transition: background-color 150ms var(--ease-out), transform 120ms var(--ease-out); }
  .menu-promo:hover .menu-promo-btn { background: #034b8e; }
  .menu-promo:active .menu-promo-btn { transform: scale(0.96); }
  /* Мини-экран квиза кодом вместо фото: телефон выглядывает снизу карточки */
  .qz { display: flex; justify-content: center; height: 10.5rem; margin: 1rem -1.375rem -0.5rem; overflow: hidden; }
  .qz-phone { width: 12.5rem; padding: 0.4375rem 0.4375rem 0; border-radius: 1.75rem 1.75rem 0 0; background: #1d1e21; box-shadow: 0 10px 30px rgb(3 75 142 / 0.18); transition: transform 200ms var(--ease-out); }
  .menu-promo:hover .qz-phone { transform: translateY(-4px); }
  .qz-screen { display: flex; flex-direction: column; height: 100%; padding: 1rem 0.75rem 0; border-radius: 1.375rem 1.375rem 0 0; background: #fff; }
  .qz-screen > * { flex-shrink: 0; }
  .qz-step { font-size: 0.625rem; line-height: 1; color: #8a8f98; }
  .qz-bar { display: block; height: 3px; margin-top: 0.4375rem; border-radius: 2px; background: #e6e8ec; }
  .qz-bar i { display: block; width: 33%; height: 100%; border-radius: inherit; background: #034b8e; }
  .qz-q { margin: 0.6875rem 0 0.5rem; font-family: var(--font-display); font-size: 0.875rem; font-weight: 700; line-height: 1.15; color: #1d1e21; }
  .qz-opt { display: flex; align-items: center; gap: 0.4375rem; margin-top: 0.3125rem; padding: 0.4375rem 0.5rem; border: 1px solid #e3e5e9; border-radius: 7px; font-size: 0.6875rem; line-height: 1.1; color: #1d1e21; }
  .qz-opt::before { content: ''; flex: none; width: 0.6875rem; height: 0.6875rem; border: 1.5px solid #b8bcc4; border-radius: 50%; }
  .qz-opt.is-on { border-color: #034b8e; background: #034b8e; color: #fff; }
  .qz-opt.is-on::before { border-color: #fff; background: radial-gradient(circle, #fff 0 2.5px, transparent 3px); }
  /* кнопки мессенджеров: без подсветки фона, при наведении значок светлеет и появляется мягкое кольцо */
  .msg-btn {
    transition: color 150ms var(--ease-out), box-shadow 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .msg-btn:hover { box-shadow: 0 0 0 3px rgb(255 255 255 / 0.22); }
  .msg-btn:active { transform: scale(0.96); }

  /* закреплённая шапка: та же плашка, но плотный тёмно-синий фон — на белых блоках белый текст читается */
  .site-header.is-stuck {
    position: fixed; z-index: 50; top: 0.5rem;
    left: max(1rem, calc((100% - 100rem) / 2 + 1rem)); right: max(1rem, calc((100% - 100rem) / 2 + 1rem));
    height: 4rem; background-color: rgb(13 34 65 / 0.92);
    box-shadow: 0 10px 30px rgb(2 14 34 / 0.25);
    animation: sh-in 220ms var(--ease-out);
  }
  @media (min-width: 640px) {
    .site-header.is-stuck { left: max(3.25rem, calc((100% - 100rem) / 2 + 3.25rem)); right: max(3.25rem, calc((100% - 100rem) / 2 + 3.25rem)); }
  }
  @media (min-width: 1024px) { .site-header.is-stuck { height: 4.75rem; } }
  @keyframes sh-in { from { transform: translateY(calc(-100% - 0.5rem)); } }
  @media (prefers-reduced-motion: reduce) { .site-header.is-stuck { animation: none; } }
  /* мобильное меню: белая панель справа, не на весь экран */
  .m-wrap { position: fixed; inset: 0; z-index: 70; }
  .m-wrap[hidden] { display: none; }
  .m-back { position: absolute; inset: 0; background: rgb(2 14 34 / 0.5); opacity: 0; transition: opacity 240ms var(--ease-out); }
  .m-drawer {
    position: absolute; inset: 0; display: flex; flex-direction: column; background: #fff; color: #1d1e21;
    transform: translateX(100%); transition: transform 260ms var(--ease-out);
  }
  .m-wrap.is-open .m-back { opacity: 1; }
  .m-wrap.is-open .m-drawer { transform: none; }
  @media (prefers-reduced-motion: reduce) { .m-back, .m-drawer { transition: none; } }
  .m-top { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; padding: 0.75rem 1rem 0.75rem 1.25rem; border-bottom: 1px solid #eceef1; }
  .m-title { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; }
  .m-close { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 10px; background: #f3f4f6; color: #1d1e21; cursor: pointer; }
  .m-close:hover { background: #e6eef8; color: #034b8e; }
  .m-list { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 0.5rem 0.75rem; }
  .m-list > li + li { border-top: 1px solid #f0f1f3; }
  .m-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.25rem; padding: 0 0.5rem; font-weight: 600; font-size: 1.0625rem; color: #1d1e21; text-decoration: none; cursor: pointer; list-style: none; }
  .m-row::-webkit-details-marker { display: none; }
  .m-caret { flex: none; color: #8a8f98; transition: transform 200ms var(--ease-out); }
  .m-group[open] .m-caret { transform: rotate(180deg); color: #034b8e; }
  .m-group[open] > .m-row { color: #034b8e; }
