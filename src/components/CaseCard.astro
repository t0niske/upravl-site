---
/**
 * «Папка дела» — главный визуальный момент: итог реального завершённого дела.
 * Не копия судебного акта, а карточка с данными из открытой картотеки.
 */
import { rub, type CaseItem } from '../data/site';
interface Props { item: CaseItem; class?: string }
const { item, class: cls = '' } = Astro.props;
---
<figure class:list={['case-card w-[19rem] max-w-full', cls]} aria-label={`Завершённое дело № ${item.number}`}>
  <div class="relative rounded-[14px] border border-line bg-card p-5 shadow-[0_1px_2px_rgba(23,32,46,0.06),0_16px_40px_rgba(23,32,46,0.12)]">
    <div class="flex items-center justify-between gap-3">
      <span class="docket">№ {item.number}</span>
      <span class="font-mono text-[0.75rem] text-muted tnum"><time datetime={item.finished}>{item.finished.split('-').reverse().join('.')}</time></span>
    </div>
    <p class="mt-4 text-[0.875rem] leading-5 text-muted">Арбитражный суд Томской области освободил гражданина от долгов</p>
    <p class="figure mt-2 text-[2rem] leading-none text-accent">{rub(item.amount)}</p>
    <div class="mt-4 flex items-center gap-2 border-t border-line pt-3 text-[0.8125rem] text-ink-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-ok"><path d="M20 6 9 17l-5-5" /></svg>
      Реализация имущества завершена
    </div>
  </div>
  <figcaption class="sr-only">Дело № {item.number}: списано {rub(item.amount)}, завершено {item.finishedLabel}</figcaption>
</figure>
