---
interface Props { items: { q: string; a: string }[]; title?: string; id?: string }
const { items, title = 'Частые вопросы', id = 'faq' } = Astro.props;
---
<section aria-labelledby={`${id}-title`} class="wrap mt-24">
  <h2 id={`${id}-title`}>{title}</h2>
  <div class="mt-8 max-w-[48rem] divide-y divide-line border-y border-line">
    {items.map((i) => (
      <details class="group py-1">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
          <h3 class="font-sans text-[1.0625rem] leading-snug font-medium">{i.q}</h3>
          <svg class="mt-0.5 shrink-0 text-muted transition-transform duration-200 group-open:rotate-45" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        </summary>
        <p class="max-w-[42rem] pb-6 text-ink-2">{i.a}</p>
      </details>
    ))}
  </div>
</section>
