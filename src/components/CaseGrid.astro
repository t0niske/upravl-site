---
import { cases, rub, maskCase } from '../data/site';
interface Props { limit?: number; note?: boolean }
const { limit, note = true } = Astro.props;
const list = limit ? cases.slice(0, limit) : cases;
---
<div class="overflow-hidden rounded-[14px] border border-line bg-card">
  <div class="hidden grid-cols-[11rem_1fr_9rem_10rem] gap-6 border-b border-line px-6 py-3 text-[0.875rem] text-muted md:grid" aria-hidden="true">
    <span>Номер дела</span><span>Должник</span><span>Завершено</span><span class="text-right">Списано долгов</span>
  </div>
  <ul class="divide-y divide-line">
    {list.map((c) => (
      <li class="grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-1 px-5 py-4 md:grid-cols-[11rem_1fr_9rem_10rem] md:px-6">
        <span><span class="docket">№ {maskCase(c.number)}</span></span>
        <span class="col-start-1 row-start-2 text-[0.9375rem] text-ink-2 md:col-start-2 md:row-start-1">{c.debtor}<span class="text-muted md:hidden"> · <time datetime={c.finished}>{c.finishedLabel}</time></span></span>
        <span class="hidden text-[0.9375rem] text-ink-2 md:block"><time datetime={c.finished}>{c.finishedLabel}</time></span>
        <span class="figure row-span-2 text-right text-[1.375rem] leading-none md:row-span-1">{rub(c.amount)}</span>
      </li>
    ))}
  </ul>
</div>
{note && (
  <p class="mt-4 max-w-[44rem] text-[0.875rem] text-muted">
    Суммы — из определений Арбитражного суда Томской области о завершении реализации имущества и освобождении от обязательств. Имена должников и номера дел не публикуем, чтобы не раскрывать клиентов.
  </p>
)}
