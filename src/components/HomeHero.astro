---
/**
 * Первый экран главной по макету дизайнера (16.11.2026):
 * тёмно-синий градиент со свечением, шапка-плашка поверх, H1 слева, портрет справа,
 * две цифры внизу. На десктопе весь блок помещается в высоту экрана.
 */
import { Image } from 'astro:assets';
import { person, contacts, headerNav, heroStats } from '../data/site';
import portrait from '../assets/antonets-hero.png';

const path = Astro.url.pathname;
const messengers = [
  { label: 'Telegram', href: contacts.telegram || '/kontakty/', icon: 'telegram' },
  { label: 'WhatsApp', href: contacts.whatsapp || '/kontakty/', icon: 'whatsapp' },
  { label: 'Позвонить', href: contacts.phoneHref, icon: 'phone' },
];
---

<section class="hero relative isolate overflow-hidden text-white" aria-labelledby="hero-title">
  <div class="hero-bg absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="hero-inner mx-auto flex w-full max-w-[100rem] flex-col px-4 sm:px-8">
    <!-- Шапка -->
    <header class="relative z-30 mt-2 flex h-16 items-center justify-between gap-6 rounded-[14px] border border-white/10 bg-white/[0.07] pr-2 pl-5 backdrop-blur-md lg:h-[clamp(4.25rem,9vh,5.5rem)] lg:pr-4 lg:pl-8">
      <a href="/" class="flex shrink-0 items-center gap-2.5 whitespace-nowrap text-[1.125rem] font-semibold no-underline lg:text-[1.375rem] 2xl:text-[1.5rem]" aria-label="Главная: арбитражный управляющий Антонец Ю. А.">
        <span class="grid grid-cols-2 gap-[3px]" aria-hidden="true">
          <i class="size-[5px] rounded-[1px] bg-[#3d8bff]"></i><i class="size-[5px] rounded-[1px] bg-[#3d8bff]/60"></i>
          <i class="size-[5px] rounded-[1px] bg-[#3d8bff]/60"></i><i class="size-[5px] rounded-[1px] bg-[#3d8bff]"></i>
        </span>
        Антонец Юрий
      </a>

      <nav aria-label="Основное меню" class="hidden xl:block">
        <ul class="flex items-center gap-0.5 whitespace-nowrap text-[1rem] 2xl:gap-1 2xl:text-[1.125rem]">
          {headerNav.map((i) => (
            <li class="group relative">
              <a href={i.href} class="flex items-center gap-1.5 rounded-[8px] px-3 py-2 text-white/90 2xl:px-3.5 no-underline transition-colors hover:bg-white/10 hover:text-white" aria-current={path === i.href ? 'page' : undefined}>
                {i.label}
                {i.children && <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.25 5 7l3.5-3.75z" fill="currentColor" /></svg>}
              </a>
              {i.children && (
                <ul class="invisible absolute top-full left-0 z-40 mt-2 min-w-64 translate-y-1 rounded-[12px] border border-white/10 bg-[#0d2241]/95 p-2 opacity-0 shadow-[0_12px_32px_rgba(0,0,0,0.3)] backdrop-blur-md transition-[opacity,transform,visibility] duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                  {i.children.map((c) => (
                    <li><a href={c.href} class="block rounded-[8px] px-3 py-2 text-[1rem] text-white/85 no-underline transition-colors hover:bg-white/10 hover:text-white">{c.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-2 lg:gap-3">
        {messengers.map((m) => (
          <a href={m.href} class="hidden size-11 place-items-center rounded-[8px] bg-white text-[#034B8E] no-underline transition-colors hover:bg-[#e3eefb] sm:grid lg:size-12 2xl:size-14" aria-label={m.label} title={m.label}>
            {m.icon === 'telegram' && <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.5A10.5 10.5 0 1 0 22.5 12 10.5 10.5 0 0 0 12 1.5Zm4.87 7.15c-.16 1.66-.84 5.7-1.19 7.56-.15.79-.44 1.05-.72 1.08-.61.06-1.07-.4-1.66-.79-.93-.6-1.45-.98-2.34-1.58-1.04-.68-.37-1.06.22-1.67.16-.16 2.84-2.6 2.9-2.83 0-.03.01-.13-.05-.19s-.15-.03-.22-.02c-.09.02-1.57 1-4.43 2.93-.42.29-.8.43-1.14.42-.37-.01-1.1-.21-1.63-.39-.66-.21-1.18-.33-1.13-.69.02-.19.28-.38.78-.58 3.06-1.33 5.1-2.21 6.12-2.64 2.92-1.21 3.52-1.42 3.92-1.43.09 0 .28.02.41.12a.44.44 0 0 1 .15.29c.01.08.03.27.01.41Z" /></svg>}
            {m.icon === 'whatsapp' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z" /><path d="M9 8.5c0 3.6 2.9 6.5 6.5 6.5l1-1.6-2.2-1-1 .9a5 5 0 0 1-2.6-2.6l.9-1-1-2.2z" fill="currentColor" stroke="none" /></svg>}
            {m.icon === 'phone' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.5h3.2l1.6 4.2-2 1.3a10 10 0 0 0 5.2 5.2l1.3-2 4.2 1.6V17a2.5 2.5 0 0 1-2.7 2.5A15.5 15.5 0 0 1 2.5 6.2 2.5 2.5 0 0 1 5 3.5Z" /></svg>}
          </a>
        ))}
        <details class="group relative xl:hidden">
          <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-[8px] border border-white/20 text-white [&::-webkit-details-marker]:hidden lg:size-12" aria-label="Меню">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </summary>
          <nav aria-label="Мобильное меню" class="absolute top-14 right-0 w-[min(20rem,calc(100vw-2rem))] rounded-[14px] border border-white/10 bg-[#0d2241] p-2 shadow-[0_12px_32px_rgba(0,0,0,0.35)] lg:top-16">
            <ul>
              {headerNav.map((i) => (
                <li>
                  <a href={i.href} class="block rounded-[8px] px-3 py-2.5 text-white no-underline hover:bg-white/10">{i.label}</a>
                  {i.children && (
                    <ul class="mb-1 pl-3">
                      {i.children.map((c) => <li><a href={c.href} class="block rounded-[8px] px-3 py-1.5 text-[0.9375rem] text-white/70 no-underline hover:bg-white/10 hover:text-white">{c.label}</a></li>)}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
            <a href={contacts.phoneHref} class="tnum mt-1 block rounded-[8px] bg-white/10 px-3 py-2.5 font-medium text-white no-underline">{contacts.phone}</a>
          </nav>
        </details>
      </div>
    </header>

    <!-- Контент -->
    <div class="hero-body relative grid flex-1 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
      <div class="relative z-10 flex flex-col pt-10 pb-8 lg:justify-between lg:pt-0 lg:pb-[clamp(2rem,6vh,4.5rem)]">
        <div class="lg:my-auto lg:pt-[4vh]">
          <h1 id="hero-title" class="hero-title">Помогаю законно списать долги через банкротство в&nbsp;Томске</h1>
          <p class="hero-sub mt-[clamp(1rem,3vh,2rem)] max-w-[44rem] text-white/90">
            Банкротство граждан и бизнеса, сопровождение дела в Арбитражном суде Томской области, работа с банками и коллекторами
          </p>
          <a href="#proverka" class="hero-btn mt-[clamp(1.5rem,5vh,3.5rem)] inline-flex w-full items-center justify-center rounded-[8px] bg-[#034B8E] px-7 font-normal text-white no-underline transition-colors hover:bg-[#0a5aa6] sm:w-auto">Бесплатная консультация</a>
        </div>

        <ul class="mt-10 grid grid-cols-2 gap-6 sm:flex sm:gap-16 lg:mt-0">
          <li class="flex flex-col">
            <span class="hero-stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" /><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" /><path d="M7 21h10" /><path d="M12 3v18" /><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" /></svg>
            </span>
            <span class="hero-stat-num tnum">{heroStats.years}</span>
            <span class="hero-stat-label">{heroStats.yearsLabel}</span>
          </li>
          <li class="flex flex-col">
            <span class="hero-stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4.35 14.34A8 8 0 0 1 14.34 4.35" /><path d="M19.65 9.66A8 8 0 0 1 9.66 19.65" /><circle cx="17.66" cy="6.34" r="2.3" /><circle cx="6.34" cy="17.66" r="2.3" /><path d="M10.9 15.9V8.4h2.2a1.9 1.9 0 0 1 0 3.8H9.6" /><path d="M9.6 14.1h3.7" /></svg>
            </span>
            <span class="hero-stat-num tnum">{heroStats.written}</span>
            <span class="hero-stat-label">{heroStats.writtenLabel}</span>
          </li>
        </ul>
      </div>

      <figure class="hero-figure relative -mx-4 mt-2 sm:-mx-8 lg:static lg:m-0">
        <Image src={portrait} alt={`${person.name}, арбитражный управляющий, в тёмно-синем костюме, руки скрещены`} widths={[480, 720, 1000]} sizes="(min-width: 1024px) 46vw, 100vw" class="hero-photo" loading="eager" fetchpriority="high" />
        <figcaption class="hero-name">
          <span class="block font-semibold text-white">{person.name}</span>
          <span class="mt-1 block text-white/75">Арбитражный управляющий</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    background:
      radial-gradient(42% 60% at 72% 42%, rgb(30 92 168 / 0.55), transparent 70%),
      radial-gradient(60% 50% at 85% 100%, rgb(3 75 142 / 0.6), transparent 70%),
      linear-gradient(155deg, #1b2a45 0%, #13284a 40%, #0c3466 75%, #0b3d78 100%);
  }
  .hero-title {
    font-family: var(--font-sans);
    font-weight: 600;
    color: #fff;
    font-size: clamp(2.125rem, min(4.1vw, 7.6vh), 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 13em;
    text-wrap: balance;
  }
  .hero-sub {
    font-size: clamp(1.0625rem, min(1.75vw, 3.3vh), 1.875rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .hero-btn {
    min-height: clamp(3.25rem, 6.5vh, 3.75rem);
    font-size: clamp(1.0625rem, min(1.5vw, 2.8vh), 1.625rem);
  }
  .hero-stat-icon {
    display: grid;
    place-items: center;
    width: clamp(2.75rem, 6vh, 3.5rem);
    aspect-ratio: 1;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }
  .hero-stat-icon svg { width: 58%; height: 58%; }
  .hero-stat-num {
    margin-top: clamp(0.75rem, 2.4vh, 1.5rem);
    font-weight: 600;
    font-size: clamp(1.75rem, min(3vw, 5.4vh), 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .hero-stat-label {
    margin-top: clamp(0.5rem, 1.6vh, 1rem);
    font-size: clamp(1rem, min(1.45vw, 2.6vh), 1.5rem);
    line-height: 1.2;
    color: rgb(255 255 255 / 0.92);
  }
  .hero-photo {
    display: block;
    width: 100%;
    max-width: 30rem;
    margin-left: auto;
    height: auto;
  }
  .hero-name {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.1);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 0.875rem 1.25rem;
    font-size: 1rem;
    line-height: 1.25;
  }

  @media (min-width: 1024px) {
    .hero { height: 100svh; min-height: 40rem; max-height: 75rem; }
    .hero-inner { height: 100%; }
    .hero-figure {
      position: absolute;
      inset: auto 0 0 auto;
      width: 50%;
      height: 100%;
      pointer-events: none;
    }
    .hero-photo {
      position: absolute;
      right: 7%;
      bottom: 0;
      width: auto;
      max-width: none;
      height: 92%;
    }
    .hero-name {
      right: 0;
      bottom: clamp(2rem, 6vh, 4.5rem);
      pointer-events: auto;
      padding: clamp(1rem, 2.6vh, 1.75rem) clamp(1.25rem, 1.6vw, 1.5rem);
      font-size: clamp(1rem, min(1.45vw, 2.6vh), 1.5rem);
    }
    .hero-name span:first-child { font-size: 1.15em; }
  }
</style>
