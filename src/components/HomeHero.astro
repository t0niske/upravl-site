---
/**
 * Первый экран главной по макету дизайнера (16.11.2026):
 * тёмно-синий градиент со свечением, шапка-плашка поверх, H1 слева, портрет справа,
 * две цифры внизу. На десктопе весь блок помещается в высоту экрана.
 */
import { Image } from 'astro:assets';
import { person, heroStats } from '../data/site';
import SiteHeader from './SiteHeader.astro';
import portrait from '../assets/antonets-hero.png';
import court from '../assets/court-bg-a.png';
import { nb } from '../data/typo';

// Фон: здание Арбитражного суда Томской области, фасад анфас (сгенерировано по мотивам, монохром).
// Другие варианты (ракурс снизу, скетч, акварель, линии) лежат в design/court/.
const COURT_OPACITY = 0.5;

---

<section class="hero relative z-40 isolate overflow-hidden text-white" aria-labelledby="hero-title">
  <div class="hero-bg absolute inset-0 -z-10" aria-hidden="true">
    <Image src={court} alt="" widths={[960, 1600, 2400]} sizes="100vw" class="hero-court" style={`opacity:${COURT_OPACITY}`} loading="eager" />
  </div>

  <div class="hero-inner mx-auto flex w-full max-w-[100rem] flex-col px-4 sm:px-[3.25rem]">
    <SiteHeader />

    <!-- Контент -->
    <div class="hero-body relative grid flex-1 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
      <div class="relative z-10 flex flex-col pt-10 pb-8 lg:justify-between lg:pt-0 lg:pb-[clamp(2rem,6vh,4.5rem)]">
        <div class="lg:my-auto lg:pt-[4vh]">
          <h1 id="hero-title" class="hero-title">{nb('Помогаю законно списать долги через банкротство в Томске')}</h1>
          <p class="hero-sub mt-[calc(clamp(1rem,3vh,2rem)-5px)] lg:mt-[clamp(1rem,3vh,2rem)] max-w-[44rem] font-medium text-white/90 lg:font-normal">
            {nb('Банкротство граждан и бизнеса, сопровождение дела в Арбитражном суде Томской области, работа с банками и коллекторами')}
          </p>
          <a href="#proverka" class="hero-btn mt-[clamp(1.5rem,5vh,3.5rem)] inline-flex w-full items-center justify-center rounded-[10px] bg-[#034B8E] px-10 font-semibold text-white no-underline transition-colors hover:bg-[#0a5aa6] sm:w-auto lg:font-normal">Бесплатная консультация</a>
        </div>

        <ul class="mt-10 grid grid-cols-2 gap-6 sm:flex sm:gap-14 lg:mt-0 lg:translate-y-[10px]">
          <li class="flex flex-col">
            <span class="hero-stat-icon" aria-hidden="true">
              <svg class="stat-ico-solid" viewBox="0 0 28 28" fill="currentColor"><path d="M11.8949 0.0763671C11.3808 0.300586 11.2168 1.00059 11.5777 1.42715C11.7964 1.68418 12.0097 1.7498 12.6058 1.7498H13.1254V2.48262V3.20996L13.4097 3.13887C13.5683 3.09512 13.8308 3.0623 14.0004 3.0623C14.1699 3.0623 14.4324 3.09512 14.591 3.13887L14.8754 3.20996V2.48262V1.76074L15.4714 1.73887C15.9746 1.72793 16.0949 1.70605 16.2207 1.60762C16.5105 1.39434 16.598 1.21934 16.598 0.874805C16.598 0.530273 16.5105 0.355273 16.2207 0.141992C16.0785 0.0326173 15.9964 0.0271485 14.066 0.016211C12.48 0.00527358 12.0261 0.016211 11.8949 0.0763671Z" /><path d="M13.5902 3.98694C13.0871 4.11819 12.6441 4.47913 12.4144 4.94944C12.2285 5.32678 12.223 6.03225 12.4035 6.39866C12.5894 6.78694 12.8136 7.0221 13.191 7.22444C13.5082 7.39397 13.5738 7.41038 14.0004 7.40491C14.3941 7.40491 14.509 7.38303 14.7441 7.26272C15.1543 7.04397 15.3293 6.87991 15.5371 6.49709C15.7066 6.17991 15.723 6.11428 15.723 5.68772C15.723 5.26116 15.7066 5.19553 15.5371 4.87834C15.2254 4.30959 14.7496 4.00334 14.1152 3.96506C13.9183 3.95413 13.6832 3.95959 13.5902 3.98694Z" /><path d="M10.2592 6.81406L9.17636 7.4375H7.78183C6.4748 7.4375 6.3873 7.44297 6.42558 7.53047C6.44745 7.58516 6.4912 7.78203 6.52402 7.96797C6.58417 8.30156 6.53495 8.81563 6.42558 9.08906C6.3873 9.18203 6.48027 9.1875 7.88573 9.1875C9.0287 9.1875 9.4498 9.17109 9.64667 9.11094C9.89277 9.03437 12.2498 7.73281 12.2498 7.66719C12.2498 7.65625 12.1514 7.53594 12.0365 7.41016C11.8014 7.15313 11.5881 6.77578 11.4842 6.40937C11.4459 6.28359 11.3967 6.17969 11.3803 6.18516C11.3639 6.18516 10.8607 6.46953 10.2592 6.81406Z" /><path d="M16.5156 6.40937C16.4117 6.77031 16.2203 7.10938 15.9742 7.39375C15.8484 7.53047 15.75 7.65625 15.75 7.67266C15.75 7.73281 18.1125 9.03984 18.3531 9.11094C18.55 9.17109 18.9711 9.1875 20.1141 9.1875C21.5195 9.1875 21.6125 9.18203 21.5742 9.08906C21.5523 9.03984 21.5086 8.84297 21.4758 8.65156C21.4156 8.32344 21.4648 7.80938 21.5742 7.53047C21.6125 7.44297 21.525 7.4375 20.218 7.4375H18.8234L17.7242 6.80859C17.1227 6.46406 16.6195 6.17969 16.6086 6.17969C16.5977 6.17969 16.5539 6.28359 16.5156 6.40937Z" /><path d="M3.93749 7.07107C3.66952 7.15857 3.21015 7.62888 3.12811 7.90779C2.97499 8.42185 3.08436 8.83201 3.47265 9.21482C4.03046 9.7781 4.80155 9.76716 5.32108 9.18748C5.81327 8.6406 5.81327 7.98435 5.32108 7.43748C4.96561 7.04373 4.45702 6.90701 3.93749 7.07107Z" /><path d="M23.1875 7.07107C22.9195 7.15857 22.4601 7.62888 22.3781 7.90779C22.225 8.42185 22.3344 8.83201 22.7226 9.21482C23.2805 9.7781 24.0516 9.76716 24.5711 9.18748C25.0633 8.6406 25.0633 7.98435 24.5711 7.43748C24.2156 7.04373 23.707 6.90701 23.1875 7.07107Z" /><path d="M13.125 15.4547V22.75H14H14.875V15.4547V8.16484L14.5906 8.23594C14.432 8.27969 14.1695 8.3125 14 8.3125C13.8305 8.3125 13.568 8.27969 13.4094 8.23594L13.125 8.16484V15.4547Z" /><path d="M2.84941 10.5109C2.7291 10.7625 2.04004 12.2172 1.3127 13.7539L-0.0107422 16.543L0.0220703 16.9531C0.120508 18.3148 0.847851 19.5344 2.00723 20.2891C2.75098 20.7758 3.42363 20.9727 4.3752 20.9727C5.32676 20.9727 5.99941 20.7758 6.74316 20.2891C7.90254 19.5344 8.62988 18.3148 8.72832 16.9531L8.76113 16.543L7.43769 13.7539C6.71035 12.2172 6.02129 10.7625 5.90644 10.5164L5.69863 10.0734L5.38691 10.232C5.21191 10.3195 5.03691 10.3906 4.99863 10.3906C4.95488 10.3906 4.92207 10.4125 4.92207 10.4398C4.92207 10.4672 5.57285 11.8617 6.36582 13.5461L7.81504 16.5977L6.09238 16.6141C5.15176 16.6195 3.59863 16.6195 2.65801 16.6141L0.935351 16.5977L2.38457 13.5461C3.17754 11.8617 3.82832 10.4672 3.82832 10.4398C3.82832 10.4125 3.78457 10.3906 3.73535 10.3906C3.68613 10.3906 3.51113 10.3141 3.35254 10.2266L3.05723 10.057L2.84941 10.5109Z" /><path d="M22.1213 10.4617C22.0229 10.675 21.3338 12.1352 20.59 13.6992L19.2393 16.543L19.2721 16.9531C19.3705 18.3148 20.0979 19.5344 21.2572 20.2891C22.001 20.7758 22.6736 20.9727 23.6252 20.9727C24.5768 20.9727 25.2494 20.7758 25.9932 20.2891C27.1525 19.5344 27.8799 18.3148 27.9783 16.9531L28.0111 16.543L26.6877 13.7539C25.9604 12.2172 25.2713 10.7625 25.1564 10.5164L24.9486 10.068L24.6533 10.2266C24.4947 10.3141 24.3197 10.3906 24.2705 10.3906C24.2158 10.3906 24.1721 10.4125 24.1721 10.4344C24.1721 10.4617 24.8229 11.8562 25.6213 13.5406L27.065 16.5977L25.3479 16.6141C24.4018 16.6195 22.8486 16.6195 21.908 16.6141L20.1854 16.5977L21.6346 13.5461C22.4275 11.8617 23.0783 10.4672 23.0783 10.4398C23.0783 10.4125 23.0455 10.3906 23.0018 10.3906C22.958 10.3906 22.7885 10.3195 22.6135 10.2266L22.3072 10.0625L22.1213 10.4617Z" /><path d="M10.0625 23.6961C9.79453 23.7836 9.33516 24.2539 9.25312 24.5328C9.21484 24.6586 9.1875 24.8992 9.1875 25.0687V25.375H14H18.8125V25.0687C18.8125 24.6258 18.7141 24.3633 18.4461 24.0625C18.0359 23.6086 18.2219 23.625 13.9781 23.6305C11.4297 23.6359 10.1938 23.6578 10.0625 23.6961Z" /><path d="M7.95703 26.3266C7.58516 26.4906 7.4375 26.7859 7.4375 27.3492C7.4375 27.6828 7.45391 27.7484 7.57422 27.8633L7.70547 28H14H20.2945L20.4313 27.8578C20.5625 27.7266 20.5734 27.6937 20.557 27.2617C20.5352 26.7695 20.4641 26.6164 20.1578 26.3922C20.0102 26.2773 19.9719 26.2773 14.0656 26.2664C9.19297 26.2555 8.09375 26.2664 7.95703 26.3266Z" /></svg>
            </span>
            <span class="hero-stat-num tnum">{heroStats.years}</span>
            <span class="hero-stat-label">{heroStats.yearsLabel}</span>
          </li>
          <li class="flex flex-col justify-self-end">
            <span class="hero-stat-icon" aria-hidden="true">
              <svg class="stat-ico-line" viewBox="2.5 2.5 19 19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.35 14.34A8 8 0 0 1 14.34 4.35" /><path d="M19.65 9.66A8 8 0 0 1 9.66 19.65" /><circle cx="17.66" cy="6.34" r="2.3" /><circle cx="6.34" cy="17.66" r="2.3" /><path d="M10.9 15.9V8.4h2.2a1.9 1.9 0 0 1 0 3.8H9.6" /><path d="M9.6 14.1h3.7" /></svg>
            </span>
            <span class="hero-stat-num tnum">{heroStats.written}</span>
            <span class="hero-stat-label">{heroStats.writtenLabel}</span>
          </li>
        </ul>
      </div>

      <figure class="hero-figure relative -mx-4 mt-2 sm:-mx-8 lg:static lg:m-0">
        <Image src={portrait} alt={`${person.name}, арбитражный управляющий, в тёмно-синем костюме, руки скрещены`} widths={[480, 720, 1000]} sizes="(min-width: 1024px) 46vw, 100vw" class="hero-photo" loading="eager" fetchpriority="high" />
        <figcaption class="hero-name">
          <span class="block font-serif font-bold text-white">{person.name}</span>
          <span class="mt-1 block text-white/90">Арбитражный управляющий</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>


<style>
  .hero-bg {
    background: linear-gradient(155deg, #1b2a45 0%, #13284a 40%, #0c3466 75%, #0b3d78 100%);
  }
  .hero-court {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 100%;
  }
  /* затемнение под текстом слева и плавный переход книзу */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(16 34 64 / 0.95) 0%, rgb(16 34 64 / 0.75) 38%, rgb(16 34 64 / 0.15) 68%, transparent 100%),
      linear-gradient(0deg, rgb(11 40 80 / 0.55) 0%, transparent 35%),
      radial-gradient(40% 55% at 74% 48%, rgb(30 92 168 / 0.35), transparent 70%);
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: #fff;
    font-size: var(--fs-h1);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 13em;
    text-wrap: balance;
  }
  .hero-sub {
    text-wrap: pretty;
    font-size: var(--fs-lead);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .hero-btn {
    min-height: clamp(3.75rem, 8.5vh, 4.75rem);
    font-size: clamp(1.0625rem, min(1.5vw, 2.8vh), 1.625rem);
  }
  .hero-stat-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    aspect-ratio: 1;
    border-radius: 7px;
    background-color: rgb(255 255 255 / 0.1);
    color: #fff;
  }
  .hero-stat-icon svg { width: 50%; height: 50%; }
  /* весы залитые и шире — чуть меньше, чтобы на глаз совпадали с линейным рублём */
  .hero-stat-icon .stat-ico-solid { width: 46%; height: 46%; }
  .hero-stat-num {
    font-family: var(--font-display);
    margin-top: calc(clamp(0.5rem, 1.6vh, 1rem) + 2px);
    font-weight: 600;
    font-size: 1.875rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .hero-stat-label {
    margin-top: clamp(0.25rem, 0.8vh, 0.5rem);
    font-size: clamp(0.9375rem, min(1.15vw, 2.1vh), 1.1875rem);
    line-height: 1.2;
    color: rgb(255 255 255 / 0.92);
  }
  .hero-photo {
    display: block;
    width: 100%;
    max-width: 30rem;
    margin-left: auto;
    height: auto;
  }
  /* Стекло: лёгкий градиент, светлая кромка сверху, тень вниз; размытие с усилением цвета */
  .glass,
  .hero-name {
    /* плоская плашка как в референсе krasovskii.com (белый, без рамки, тени и блика),
       но с размытием фона под ней, чтобы текст не терялся на здании и пиджаке */
    background-color: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(18px);
  }
  /* Safari до 18 понимает только -webkit-: отдельное правило, чтобы сборщик не выкинул его как дубль */
  @supports (-webkit-backdrop-filter: blur(1px)) and (not (backdrop-filter: blur(1px))) {
    .glass, .hero-name { -webkit-backdrop-filter: blur(18px); }
  }
  .hero-photo { position: relative; }
  .hero-name span:first-child { font-size: 1.25em; }
  .hero-name {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    border-radius: 16px;
    padding: 0.875rem 1.25rem;
    font-size: 1rem;
    line-height: 1.25;
  }

  @media (min-width: 1024px) {
    .hero { height: 100svh; min-height: 40rem; max-height: 75rem; }
    .hero-inner { height: 100%; }
    .hero-figure {
      position: absolute;
      inset: auto 0 0 auto;
      width: 50%;
      height: 100%;
      pointer-events: none;
    }
    .hero-photo {
      position: absolute;
      right: 0;
      bottom: -18%;
      width: auto;
      max-width: none;
      height: 114%;
    }
    .hero-name {
      right: 0;
      /* низ карточки на одной линии с низом подписей под цифрами (цифры опущены на 10px) */
      bottom: calc(clamp(2rem, 6vh, 4.5rem) - 10px);
      pointer-events: auto;
      padding: clamp(1rem, 2.6vh, 1.75rem) clamp(1.25rem, 1.6vw, 1.5rem);
      font-size: clamp(1rem, min(1.45vw, 2.6vh), 1.5rem);
    }
    .hero-name span:first-child { font-size: 1.15em; }
    .hero-stat-num { font-size: 36px; }
    .hero-stat-icon { width: 56px; }
  }
</style>
