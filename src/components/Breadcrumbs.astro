---
import type { Crumb } from '../data/schema';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Хлебные крошки" class="wrap pt-5 text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <li><a href="/" class="text-muted">Главная</a></li>
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true">/</span>
        {i === crumbs.length - 1 ? <span aria-current="page" class="text-ink-2">{c.name}</span> : <a href={c.href} class="text-muted">{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>
