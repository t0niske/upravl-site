---
/**
 * Форма заявки и контакты по референсу дизайнера (18.11.2026): слева синяя карточка с формой,
 * справа белая карточка «Контакты» (офис, телефоны, часы, почта и мессенджеры) и карта Яндекса.
 * Отправка — public/lead.php (работает на хостинге с PHP; на GitHub Pages показывает ошибку с телефонами).
 * Скрытое поле data-quiz-field заполняет квиз ответами.
 */
import { Image } from 'astro:assets';
import { nb } from '../data/typo';
import { contacts } from '../data/site';
import iconWhatsapp from '../assets/icons/whatsapp.png';
import iconMax from '../assets/icons/max.png';

interface Props { title?: string; text?: string; topic?: string }
const {
  title = 'Бесплатная консультация по вашей ситуации',
  text = 'Оставьте телефон — перезвоню, задам несколько вопросов о долгах и имуществе и скажу, какая процедура вам подходит и сколько она будет стоить. Без обязательств',
  topic = '',
} = Astro.props;

// метка по координатам офиса (из карточки 2ГИС), без всплывающей карточки поиска
const { lat, lon } = contacts.geo;
const mapSrc = `https://yandex.ru/map-widget/v1/?ll=${lon},${lat}&z=16&pt=${lon},${lat},pm2blm`;
const messengers = [
  { label: 'Telegram', href: contacts.telegram || '/kontakty/', icon: 'telegram' },
  { label: 'WhatsApp', href: contacts.whatsapp || '/kontakty/', icon: 'whatsapp' },
  { label: 'MAX', href: contacts.max || '/kontakty/', icon: 'max' },
];
---

<section id="zayavka" class="lf scroll-mt-20" aria-labelledby="zayavka-title">
  <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
    <div class="lf-grid">
      <form class="lead-form lf-form" action="/lead.php" method="post" novalidate>
        <input type="hidden" name="topic" value={topic} />
        <input type="hidden" name="page" value={Astro.url.pathname} />
        <input type="hidden" name="quiz" value="" data-quiz-field />
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>Сайт <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <span class="lf-chip lf-chip-blue">Заявка</span>
        <h2 id="zayavka-title" class="lf-title">{nb(title)}</h2>
        <p class="lf-lead">{nb(text)}</p>

        <div class="lf-fields">
          <label class="lf-field">
            <span class="sr-only">Как к вам обращаться</span>
            <input name="name" type="text" autocomplete="given-name" maxlength="80" placeholder="Ваше имя" />
          </label>
          <label class="lf-field">
            <span class="sr-only">Телефон, обязательно</span>
            <input name="phone" type="tel" inputmode="tel" autocomplete="tel" required minlength="10" maxlength="25" placeholder="Телефон: +7 (000) 000-00-00" />
          </label>
          <label class="lf-field">
            <span class="sr-only">Коротко о ситуации, необязательно</span>
            <textarea name="message" rows="4" maxlength="2000" placeholder="Коротко о ситуации: например, 4 кредита и микрозайм, общий долг около 900 тыс., есть квартира и машина"></textarea>
          </label>
          <label class="lf-consent">
            <input name="consent" type="checkbox" required value="1" />
            <span>Я даю согласие на обработку персональных данных в соответствии с <a href="/politika-konfidencialnosti/">политикой конфиденциальности</a></span>
          </label>
          <button type="submit" class="lf-btn">Получить консультацию</button>
          <p class="lead-status hidden" role="status" aria-live="polite"></p>
        </div>
      </form>

      <div class="lf-contacts">
        <span class="lf-chip">Свяжитесь со мной</span>
        <p class="lf-ctitle">Контакты</p>
        <dl class="lf-info">
          <div>
            <dt>Офис в Томске</dt>
            <dd>{contacts.addressFull}</dd>
            <dd><a href={contacts.yandexMapsUrl} target="_blank" rel="noopener" class="lf-route">Маршрут на Яндекс Картах</a></dd>
          </div>
          <div>
            <dt>Телефоны</dt>
            <dd class="lf-phones">
              <a href={contacts.phone2Href} class="tnum">{contacts.phone2}</a>
              <a href={contacts.phoneHref} class="tnum">{contacts.phone}</a>
            </dd>
          </div>
          <div>
            <dt>Часы работы</dt>
            <dd>{contacts.hoursDays}<br />{nb(contacts.hoursNote.charAt(0).toUpperCase() + contacts.hoursNote.slice(1))}</dd>
          </div>
          <div>
            <dt>Почта и мессенджеры</dt>
            <dd class="lf-mail">
              <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
              {contacts.email2 && <a href={`mailto:${contacts.email2}`}>{contacts.email2}</a>}
            </dd>
            <dd class="lf-msgs">
              {messengers.map((m) => (
                <a href={m.href} class="lf-msg" aria-label={m.label}>
                  {m.icon === 'telegram' && <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#26A5E4" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" /></svg>}
                  {m.icon === 'whatsapp' && <Image src={iconWhatsapp} alt="" width={64} height={64} />}
                  {m.icon === 'max' && <Image src={iconMax} alt="" width={64} height={64} />}
                </a>
              ))}
            </dd>
          </div>
        </dl>
        <div class="lf-map">
          <iframe src={mapSrc} title="Офис на Яндекс Картах: Томск, ул. Тверская, 14" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.lead-status')!;
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.className = `lead-status ${ok ? 'is-ok' : 'is-err'}`;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const phone = String(fd.get('phone') || '').replace(/\D/g, '');
      if (phone.length < 10) return show('Проверьте номер телефона: нужно не меньше 10 цифр', false);
      if (!fd.get('consent')) return show('Отметьте согласие на обработку данных — без него заявку отправить нельзя', false);
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      btn.textContent = 'Отправляю…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'send');
        form.reset();
        show('Заявка отправлена. Перезвоню в рабочее время; если вопрос срочный — звоните по телефону', true);
        (window as any).ym?.((window as any).YM_ID, 'reachGoal', 'lead');
      } catch {
        show('Не получилось отправить заявку. Позвоните, пожалуйста: +7 (913) 889-35-36 или +7 (3822) 30-02-15', false);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Получить консультацию';
      }
    });
  });
</script>

<style>
  .lf { padding: clamp(2.5rem, 4vw, 3.5rem) 0 clamp(3rem, 5vw, 4.5rem); background: #f3f4f6; }
  .lf-grid { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  @media (min-width: 1024px) { .lf-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }

  .lf-chip { display: inline-flex; align-self: flex-start; padding: 0.5rem 0.875rem; border-radius: 8px; background: #f3f4f6; font-size: 0.9375rem; line-height: 1.2; color: #5f646d; }
  .lf-chip-blue { background: rgb(255 255 255 / 0.12); color: rgb(255 255 255 / 0.85); }

  /* Форма — синяя карточка */
  .lf-form {
    position: relative; display: flex; flex-direction: column;
    padding: clamp(1.25rem, 3vw, 2.75rem); border-radius: clamp(16px, 1.6vw, 24px);
    background: linear-gradient(160deg, #034b8e 0%, #053a6e 55%, #0b1a30 100%); color: #fff;
  }
  .lf-title { margin-top: clamp(1.25rem, 2.2vw, 2rem); font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.08; letter-spacing: -0.025em; color: #fff; text-wrap: wrap; }
  .lf-lead { margin-top: 1rem; max-width: 34rem; font-size: var(--fs-body); line-height: 1.45; color: rgb(255 255 255 / 0.85); text-wrap: wrap; }
  .lf-fields { display: grid; gap: 0.75rem; margin-top: auto; padding-top: clamp(1.5rem, 3vw, 2.75rem); }
  .lf-field { display: block; }
  .lf-field input, .lf-field textarea {
    width: 100%; padding: 0.95rem 1.25rem; border: 0; border-radius: 10px; background: #fff;
    font: inherit; font-size: var(--fs-body); color: #15171c; outline: none;
    box-shadow: inset 0 0 0 2px transparent; transition: box-shadow 150ms var(--ease-out);
  }
  .lf-field input { min-height: 3.5rem; }
  .lf-field textarea { resize: vertical; min-height: 7.5rem; }
  .lf-field input::placeholder, .lf-field textarea::placeholder { color: #8a8f98; }
  .lf-field input:focus, .lf-field textarea:focus { box-shadow: inset 0 0 0 2px #5b9be0; }
  .lf-consent { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 0.75rem; margin-top: 0.25rem; font-size: 0.875rem; line-height: 1.45; color: rgb(255 255 255 / 0.8); }
  .lf-consent input { width: 22px; height: 22px; margin: 0; accent-color: #15171c; }
  .lf-consent a { color: #fff; }
  .lf-btn {
    display: flex; align-items: center; justify-content: center; min-height: clamp(3.25rem, 4vw, 4rem); margin-top: 0.25rem;
    border-radius: 10px; background: #15171c; color: #fff; font-size: clamp(1rem, 1.15vw, 1.1875rem); font-weight: 500; cursor: pointer;
    transition: background-color 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .lf-btn:hover { background: #000; }
  .lf-btn:active { transform: scale(0.98); }
  .lf-btn:disabled { opacity: 0.7; cursor: default; }
  .lf-btn:focus-visible, .lf-consent a:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .lead-status { padding: 0.75rem 1rem; border-radius: 10px; font-size: 0.9375rem; line-height: 1.45; }
  .lead-status.hidden { display: none; }
  .lead-status.is-ok { background: #e6f0ea; color: #1f4d37; }
  .lead-status.is-err { background: #fbe9e2; color: #7a2e10; }

  /* Контакты — белая карточка */
  .lf-contacts { display: flex; flex-direction: column; padding: clamp(1.25rem, 3vw, 2.75rem); border-radius: clamp(16px, 1.6vw, 24px); background: #fff; color: #15171c; }
  .lf-ctitle { margin-top: clamp(1.25rem, 2.2vw, 2rem); padding-bottom: clamp(1.25rem, 2vw, 1.75rem); border-bottom: 1px solid #eceef1; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.08; letter-spacing: -0.025em; }
  .lf-info { display: grid; gap: 1.25rem; padding: clamp(1.25rem, 2vw, 1.75rem) 0; }
  @media (min-width: 640px) {
    .lf-info { grid-template-columns: 1fr 1fr; gap: 1.75rem 0; }
    .lf-info > div:nth-child(odd) { padding-right: 1.5rem; border-right: 1px solid #eceef1; }
    .lf-info > div:nth-child(even) { padding-left: 1.5rem; }
  }
  .lf-info dt { font-size: 0.9375rem; color: #8a8f98; }
  .lf-info dd { margin-top: 0.5rem; font-size: var(--fs-body); line-height: 1.45; color: #15171c; overflow-wrap: anywhere; }
  .lf-phones, .lf-mail { display: flex; flex-direction: column; }
  .lf-phones a, .lf-mail a { white-space: nowrap; }
  /* 1024–1279: карточка узкая — контакты одним столбцом */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .lf-info { grid-template-columns: 1fr; gap: 1.25rem; }
    .lf-info > div:nth-child(odd), .lf-info > div:nth-child(even) { padding: 0; border: 0; }
  }
  .lf-phones a { font-family: var(--font-sans); font-weight: 700; font-size: clamp(1.25rem, 1.5vw, 1.4375rem); line-height: 1.35; color: #15171c; text-decoration: none; }
  .lf-mail a { font-weight: 500; color: #15171c; text-decoration: none; }
  .lf-phones a:hover, .lf-mail a:hover { color: #034b8e; }
  .lf-msgs { display: flex; gap: 0.5rem; margin-top: 0.75rem !important; }
  .lf-msg { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 10px; background: #f3f4f6; transition: background-color 150ms var(--ease-out), transform 120ms var(--ease-out); }
  .lf-msg :global(svg), .lf-msg :global(img) { width: 1.625rem; height: 1.625rem; }
  .lf-msg:hover { background: #e6e8ec; }
  .lf-msg:active { transform: scale(0.96); }
  .lf-phones a:focus-visible, .lf-mail a:focus-visible, .lf-msg:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; border-radius: 6px; }
  .lf-route { font-size: 0.9375rem; font-weight: 500; color: #034b8e; text-decoration: none; }
  .lf-route:hover { text-decoration: underline; }
  .lf-map { flex: 1; min-height: 16rem; overflow: hidden; border-radius: 14px; background: #e9ebee; }
  .lf-map iframe { display: block; width: 100%; height: 100%; min-height: 16rem; border: 0; }
</style>
