---
/**
 * Футер по референсу дизайнера (18.11.2026): тёмный фон, сверху логотип, ниже четыре высокие колонки
 * с вертикальными линиями (навигация, мессенджеры, документы, контакты), содержимое прижато к низу,
 * в контактах крупно телефон и почта; внизу строка с © и юридической оговоркой.
 */
import { Image } from 'astro:assets';
import { contacts, person } from '../data/site';
import iconWhatsapp from '../assets/icons/whatsapp.png';
import iconMax from '../assets/icons/max.png';

const nav = [
  { href: '/bankrotstvo-fizicheskih-lic/', label: 'Банкротство физических лиц' },
  { href: '/bankrotstvo-ip/', label: 'Банкротство ИП' },
  { href: '/bankrotstvo-ur-lica/', label: 'Банкротство компаний' },
  { href: '/dela/', label: 'Завершённые дела' },
  { href: '/yuridicheskie-uslugi/', label: 'Цены' },
  { href: '/ob-upravlyayushchem/', label: 'Об управляющем' },
  { href: '/stati/', label: 'Статьи' },
  { href: '/kontakty/', label: 'Контакты' },
];
const messengers = [
  { label: 'Telegram', href: contacts.telegram || '/kontakty/', icon: 'telegram' },
  { label: 'WhatsApp', href: contacts.whatsapp || '/kontakty/', icon: 'whatsapp' },
  { label: 'MAX', href: contacts.max || '/kontakty/', icon: 'max' },
];
const address = contacts.addressFull.replace(/(г\.|ул\.|д\.|оф\.) /g, '$1 ');
---

<footer class="sf">
  <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
    <div class="sf-top">
      <a href="/" class="sf-logo" aria-label="На главную">
        <span class="sf-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="sf-name">Антонец Юрий</span>
        <span class="sf-role">арбитражный управляющий, Томск</span>
      </a>
    </div>
  </div>

  <div class="sf-cols-wrap">
    <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
      <div class="sf-cols">
        <nav class="sf-col" aria-label="Навигация по сайту">
          <p class="sf-label"><span class="sf-dot" aria-hidden="true"></span>Навигация</p>
          <ul class="sf-links">
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>

        <div class="sf-col">
          <p class="sf-label"><span class="sf-dot" aria-hidden="true"></span>Мессенджеры</p>
          <ul class="sf-msgs">
            {messengers.map((m) => (
              <li>
                <a href={m.href} class="sf-msg">
                  <span>{m.label}</span>
                  {m.icon === 'telegram' && <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#26A5E4" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" /></svg>}
                  {m.icon === 'whatsapp' && <Image src={iconWhatsapp} alt="" width={64} height={64} />}
                  {m.icon === 'max' && <Image src={iconMax} alt="" width={64} height={64} />}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="sf-col">
          <p class="sf-label"><span class="sf-dot" aria-hidden="true"></span>Документы</p>
          <div class="sf-docs">
            <dl class="sf-reg">
              {person.registryNumber && <div><dt>Номер в реестре арбитражных управляющих</dt><dd class="tnum">{person.registryNumber}</dd></div>}
              {person.inn && <div><dt>ИНН</dt><dd class="tnum">{person.inn}</dd></div>}
              {person.sro && <div><dt>СРО</dt><dd>{person.sro}</dd></div>}
            </dl>
            <ul class="sf-links sf-links-sm">
              <li><a href="/politika-konfidencialnosti/">Политика конфиденциальности</a></li>
              <li><a href="/soglasie-na-obrabotku-personalnyh-dannyh/">Согласие на обработку персональных данных</a></li>
              <li><a href="/politika-konfidencialnosti/#cookie">Использование cookies</a></li>
            </ul>
          </div>
        </div>

        <div class="sf-col">
          <p class="sf-label"><span class="sf-dot" aria-hidden="true"></span>Контакты</p>
          <div class="sf-contacts">
            <p class="sf-addr">{address}</p>
            <p class="sf-hours">{contacts.hoursDays}, {contacts.hoursNote}</p>
            <div class="sf-big">
              <a href={contacts.phone2Href} class="tnum">{contacts.phone2}</a>
              <a href={contacts.phoneHref} class="tnum">{contacts.phone}</a>
              <a href={`mailto:${contacts.email}`} class="sf-mail">{contacts.email}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
    <div class="sf-bottom">
      <p>© 2019–2026 {person.name}</p>
      <p class="sf-legal">Информация на сайте носит справочный характер и не является публичной офертой. Итог дела зависит от обстоятельств и решения суда; гарантировать результат по закону нельзя</p>
    </div>
  </div>
</footer>

<style>
  .sf { background: #1d1e21; color: #fff; }
  .sf a { text-decoration: none; }
  .sf-top { padding: clamp(1.75rem, 3vw, 2.5rem) 0; }
  .sf-logo { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.625rem; color: #fff; }
  /* как логотип в шапке: квадратики 5 px, по диагонали яркие и приглушённые */
  .sf-mark { display: grid; grid-template-columns: 5px 5px; gap: 3px; }
  .sf-mark i { width: 5px; height: 5px; border-radius: 1px; background: #3d8bff; }
  .sf-mark i:nth-child(2), .sf-mark i:nth-child(3) { background: rgb(61 139 255 / 0.6); }
  .sf-name { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.125rem, 1.6vw, 1.5rem); }
  .sf-role { margin-left: 0.5rem; }
  .sf-role { font-size: 0.9375rem; color: #8a8f98; }

  .sf-cols-wrap { border-top: 1px solid #33353b; border-bottom: 1px solid #33353b; }
  /* Линии как в карточке контактов: горизонтали сплошные, вертикальные разделители не доходят до них —
     разрывы между смысловыми блоками */
  .sf-cols { --g: clamp(2rem, 4vw, 3.5rem); display: grid; }
  .sf-col { position: relative; display: flex; flex-direction: column; gap: 1.5rem; padding: clamp(1.5rem, 2.4vw, 2.25rem) 0; border-bottom: 1px solid #33353b; }
  .sf-col:last-child { border-bottom: 0; }
  .sf-col::before { content: none; position: absolute; left: calc(var(--g) / -2); top: clamp(1.5rem, 2.4vw, 2.25rem); bottom: clamp(1.5rem, 2.4vw, 2.25rem); width: 1px; background: #33353b; }
  @media (min-width: 768px) {
    .sf-cols { grid-template-columns: 1fr 1fr; column-gap: var(--g); }
    .sf-col:nth-child(3) { border-bottom: 0; }
    .sf-col:nth-child(even)::before { content: ''; }
  }
  @media (min-width: 1280px) {
    .sf-cols { grid-template-columns: 0.8fr 0.9fr 1.1fr 1.6fr; min-height: 22rem; }
    .sf-col { border-bottom: 0; }
    .sf-col:not(:first-child)::before { content: ''; }
  }
  .sf-label { display: flex; align-items: center; gap: 0.625rem; font-size: 0.9375rem; color: #8a8f98; }
  .sf-dot { width: 6px; height: 6px; border-radius: 1px; background: #fff; }

  .sf-links { display: grid; gap: 0.625rem; margin-top: auto; }
  .sf-links a { font-size: 1rem; color: #e4e6ea; transition: color 150ms var(--ease-out); }
  .sf-links a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .sf-links-sm a { font-size: 0.9375rem; }

  .sf-msgs { display: grid; gap: 0.5rem; margin-top: auto; }
  .sf-msg {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.875rem 1.125rem;
    border-radius: 10px; background: #2a2b30; color: #fff; font-weight: 500; transition: background-color 150ms var(--ease-out);
  }
  .sf-msg:hover { background: #33353b; }
  .sf-msg :global(svg), .sf-msg :global(img) { width: 1.5rem; height: 1.5rem; flex: none; }

  .sf-docs { display: flex; flex-direction: column; gap: 1.25rem; margin-top: auto; }
  .sf-reg { display: grid; gap: 0.75rem; }
  .sf-reg dt { font-size: 0.875rem; color: #8a8f98; }
  .sf-reg dd { margin-top: 0.125rem; font-size: 1rem; font-weight: 500; color: #e4e6ea; }

  .sf-contacts { display: flex; flex-direction: column; margin-top: auto; }
  .sf-addr { font-size: 1rem; line-height: 1.4; color: #e4e6ea; }
  .sf-hours { margin-top: 0.5rem; font-size: 0.9375rem; line-height: 1.4; color: #8a8f98; }
  .sf-big { display: flex; flex-direction: column; margin-top: clamp(1.25rem, 2.4vw, 2rem); }
  .sf-big a { font-family: var(--font-sans); font-weight: 600; font-size: clamp(1.375rem, 2vw, 1.75rem); line-height: 1.3; letter-spacing: -0.02em; color: #fff; white-space: nowrap; transition: color 150ms var(--ease-out); }
  .sf-big .sf-mail { margin-top: 0.5rem; overflow-wrap: anywhere; white-space: normal; }
  .sf-big a:hover { color: #c9ccd2; }
  .sf a:focus-visible { outline: 2px solid #fff; outline-offset: 3px; border-radius: 4px; }

  .sf-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem; padding: 1.5rem 0 1.75rem; font-size: 0.875rem; line-height: 1.5; color: #7c818a; }
  .sf-legal { max-width: 52rem; }
</style>
