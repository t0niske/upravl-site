---
/**
 * Блок отзывов по варианту D дизайнера (18.11.2026) с плашкой главной мысли из варианта E:
 * заголовок и заметная плашка оценки 2ГИС на одной линии по верху, лента карточек со стрелками.
 * Отзывы — src/data/reviews.ts (дословно с 2ГИС, имена «Имя Ф.»). Тему пишем мы по смыслу отзыва.
 */
import { nb } from '../data/typo';
import { reviews, reviewsSource } from '../data/reviews';

const featured = reviews.filter((r) => r.featured);
const rating = reviewsSource.rating.toFixed(1).replace('.', ',');
const star = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z';
---

<section id="otzyvy" class="reviews" aria-labelledby="reviews-title">
  <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
    <span class="rw-chip">
      <span class="grid grid-cols-2 gap-[2px]" aria-hidden="true">
        <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
        <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
      </span>
      Отзывы
    </span>
    <div class="rw-head">
      <div>
        <h2 id="reviews-title" class="rw-title">{nb('Что клиенты пишут на 2ГИС')}</h2>
        <p class="rw-lead">{nb('Отзывы публикуем дословно. Юрий Анатольевич сам читает их и отвечает')}</p>
      </div>

      <a href={reviewsSource.url} target="_blank" rel="noopener" class="rw-score" aria-label={`Оценка ${rating} из 5 на 2ГИС, ${reviewsSource.count} отзывов — читать все`}>
        <span class="rw-score-num tnum">{rating}</span>
        <span class="rw-score-body">
          <span class="rw-stars" aria-hidden="true">
            {[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24"><path d={star} /></svg>)}
          </span>
          <span class="rw-score-count">{reviewsSource.count} отзывов на 2ГИС</span>
        </span>
        <span class="rw-score-btn">
          Читать все
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </a>
    </div>

    <ul class="rw-track" data-rw-track>
      {featured.map((r) => (
        <li class="rw-card">
          {r.theme && <span class="rw-theme">{r.theme}</span>}
          {r.highlight && <h3 class="rw-hl">«{nb(r.highlight)}»</h3>}
          <p class="rw-text">{nb(r.text)}</p>
          <p class="rw-name">{r.name}</p>
        </li>
      ))}
    </ul>

    <div class="rw-foot">
      <a href={reviewsSource.url} target="_blank" rel="noopener" class="rw-all">Все отзывы на 2ГИС</a>
      <div class="hidden gap-4 lg:flex">
        <button type="button" class="rw-arrow" data-rw-prev aria-label="Предыдущие отзывы">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
        </button>
        <button type="button" class="rw-arrow" data-rw-next aria-label="Следующие отзывы">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.reviews').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-rw-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-rw-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-rw-next]');
    if (!track || !prev || !next) return;
    const step = () => {
      const card = track.querySelector<HTMLElement>('.rw-card');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .reviews { background: #fff; padding: clamp(2.5rem, 4vw, 3.5rem) 0; }
  .rw-head { margin-top: clamp(1.25rem, 2vw, 1.75rem); display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1.5rem 2rem; }
  .rw-chip {
    display: inline-flex; align-items: center; gap: 0.75rem;
    padding: 0.625rem 1.125rem; border-radius: 8px; background: #f3f4f6;
    font-size: clamp(1rem, 1.1vw, 1.1875rem); line-height: 1.2; color: var(--color-ink);
  }
  .rw-title { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.08; letter-spacing: -0.025em; color: #15171c; text-wrap: wrap; }
  .rw-lead { margin-top: 0.75rem; max-width: 40rem; font-size: var(--fs-lead); line-height: 1.4; color: #5f646d; text-wrap: wrap; }

  /* Плашка оценки — заметная: синий градиент, крупная цифра, кнопка */
  .rw-score {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem;
    padding: clamp(1.25rem, 1.8vw, 1.75rem) clamp(1.25rem, 2vw, 2rem); border-radius: 16px;
    background: linear-gradient(105deg, #034b8e 0%, #053a6e 55%, #0b1a30 100%); color: #fff; text-decoration: none;
    transition: transform 150ms var(--ease-out), box-shadow 150ms var(--ease-out);
  }
  .rw-score:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgb(3 75 142 / 0.25); }
  .rw-score:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; }
  .rw-score-num { font-family: var(--font-display); font-weight: 700; font-size: clamp(3rem, 4.4vw, 4rem); line-height: 1; letter-spacing: -0.03em; }
  .rw-score-body { display: flex; flex-direction: column; gap: 0.5rem; }
  .rw-stars { display: flex; gap: 3px; }
  .rw-stars svg { width: 22px; height: 22px; fill: #f5b301; }
  .rw-score-count { font-size: 1rem; color: rgb(255 255 255 / 0.85); }
  .rw-score-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.125rem; border-radius: 10px; background: #fff; color: #15171c; font-size: 1rem; font-weight: 500; }

  .rw-track {
    --gap: clamp(1rem, 1.5vw, 1.75rem);
    display: flex; gap: var(--gap);
    margin-top: clamp(1.5rem, 2.4vw, 2.25rem);
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    margin-inline: -1rem; padding-inline: 1rem; scroll-padding-inline: 1rem;
  }
  .rw-track::-webkit-scrollbar { display: none; }
  .rw-card { flex: 0 0 90%; scroll-snap-align: start; display: flex; flex-direction: column; padding: clamp(1.25rem, 2vw, 2rem); border-radius: 16px; background: #f3f4f6; }
  @media (min-width: 640px) {
    .rw-track { margin-inline: 0; padding-inline: 0; scroll-padding-inline: 0; }
    .rw-card { flex-basis: calc((100% - var(--gap)) / 2); }
  }
  @media (min-width: 1024px) { .rw-card { flex-basis: calc((100% - 2 * var(--gap)) / 3); } }
  .rw-theme { align-self: flex-start; padding: 0.375rem 0.75rem; border-radius: 8px; background: #034b8e; color: #fff; font-size: 0.9375rem; font-weight: 500; }
  .rw-hl { margin-top: 1rem; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -0.015em; color: #15171c; text-wrap: wrap; }
  .rw-text {
    margin-top: 0.75rem; font-size: var(--fs-body); line-height: 1.5; color: #7c818a; text-wrap: wrap;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; overflow: hidden;
  }
  .rw-name { margin-top: auto; padding-top: 1.25rem; border-top: 1px solid #dfe1e5; font-family: var(--font-display); font-weight: 600; font-size: 1.0625rem; color: #15171c; }
  .rw-text + .rw-name { margin-top: auto; }
  .rw-card > .rw-text { margin-bottom: 1.25rem; }

  .rw-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: clamp(1.25rem, 2vw, 2rem); }
  .rw-all {
    display: inline-flex; align-items: center; justify-content: center; min-height: 3.5rem; padding: 0 1.75rem;
    border-radius: 10px; background: #15171c; color: #fff; font-size: 1.0625rem; font-weight: 500; text-decoration: none;
    transition: background-color 150ms var(--ease-out);
  }
  .rw-all:hover { background: #034b8e; }
  .rw-all:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; }
  .rw-arrow {
    display: grid; place-items: center; width: clamp(3.5rem, 3.6vw, 4.375rem); aspect-ratio: 1;
    border-radius: 8px; background: #15171c; color: #fff; cursor: pointer;
    transition: background-color 150ms var(--ease-out), opacity 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .rw-arrow:hover { background: #034b8e; }
  .rw-arrow:active { transform: scale(0.96); }
  .rw-arrow:disabled { opacity: 0.25; cursor: default; background: #15171c; }
  .rw-arrow:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; }
</style>
