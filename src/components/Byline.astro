---
import { CONTENT_UPDATED, CONTENT_REVIEWED_BY_EXPERT, person } from '../data/site';
interface Props { updated?: string; published?: string }
const { updated = CONTENT_UPDATED, published } = Astro.props;
const fmt = (d: string) => new Date(d).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
  {CONTENT_REVIEWED_BY_EXPERT
    ? <span>Проверено: <a href="/ob-upravlyayushchem/" class="text-ink-2">{person.short}</a>, арбитражный управляющий</span>
    : <span>Редакция сайта арбитражного управляющего {person.short}</span>}
  {published && <span>Опубликовано: <time datetime={published}>{fmt(published)}</time></span>}
  <span>Обновлено: <time datetime={updated}>{fmt(updated)}</time></span>
</p>
