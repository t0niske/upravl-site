---
/**
 * Квиз «Подходит ли вам банкротство». Вопросы и варианты — в HTML (видны без JS),
 * расчёт результата — небольшим скриптом. Ответы уходят в скрытое поле формы заявки.
 */
interface Props { id?: string; compact?: boolean }
const { id = 'proverka' } = Astro.props;

import { questions } from '../data/quiz';
---
<div class="quiz rounded-[18px] border border-line bg-card p-5 sm:p-8" id={id} data-quiz>
  <p class="eyebrow">Проверка за 1 минуту</p>
  <h2 class="mt-1 text-[1.75rem]">Подходит ли вам банкротство</h2>
  <p class="mt-2 text-muted">6 вопросов. Результат — предварительный: точный ответ даю после разбора документов на консультации.</p>

  <form class="mt-6 grid gap-6" data-quiz-form>
    {questions.map((item, idx) => (
      <fieldset class="grid gap-2" data-step={idx}>
        <legend class="font-medium"><span class="mr-1 font-mono text-[0.875rem] text-muted">{String(idx + 1).padStart(2, '0')}</span> {item.q}</legend>
        <p class="text-sm text-muted">{item.hint}</p>
        <div class="mt-1 grid gap-2 sm:grid-cols-2">
          {item.options.map(([value, label]) => (
            <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-[10px] border border-line-strong bg-white px-3 py-2 transition-colors hover:border-ink/40 has-[:checked]:border-ink has-[:checked]:bg-paper">
              <input type="radio" name={item.name} value={value} class="h-4 w-4 accent-[var(--color-ink)]" required />
              <span>{label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}
    <button type="submit" class="btn btn-primary w-full sm:w-auto">Показать результат</button>
    <noscript><p class="text-sm text-muted">Для расчёта нужен JavaScript. Или просто позвоните — отвечу на эти вопросы по телефону.</p></noscript>
  </form>

  <div class="mt-6 hidden rounded-[14px] border border-line-strong bg-paper p-5 sm:p-6" data-quiz-result role="status" aria-live="polite">
    <p class="font-serif text-[1.375rem] leading-snug font-medium" data-r-title></p>
    <p class="mt-2" data-r-text></p>
    <ul class="mt-3 list-disc space-y-1.5 pl-5 text-[0.97rem]" data-r-notes></ul>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="#zayavka" class="btn btn-primary">Обсудить результат бесплатно</a>
      <a href="" class="btn btn-ghost hidden" data-r-link></a>
    </div>
  </div>
</div>

<script>
  import { decide, summary, type A } from '../data/quiz';

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-quiz-form]')!;
    const box = root.querySelector<HTMLElement>('[data-quiz-result]')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const a: A = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
      const r = decide(a);
      box.querySelector('[data-r-title]')!.textContent = r.title;
      box.querySelector('[data-r-text]')!.textContent = r.text;
      const ul = box.querySelector('[data-r-notes]')!;
      ul.innerHTML = '';
      r.notes.forEach((n) => { const li = document.createElement('li'); li.textContent = n; ul.appendChild(li); });
      const link = box.querySelector<HTMLAnchorElement>('[data-r-link]')!;
      if (r.link && location.pathname !== r.link[0]) { link.href = r.link[0]; link.textContent = r.link[1]; link.classList.remove('hidden'); }
      else link.classList.add('hidden');
      box.classList.remove('hidden');
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      const text = summary(a, r.title);
      document.querySelectorAll<HTMLInputElement>('[data-quiz-field]').forEach((f) => (f.value = text));
    });
  });
</script>
