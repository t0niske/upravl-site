---
/**
 * Квиз «Подходит ли вам банкротство». Вопросы и варианты — в HTML (видны без JS),
 * расчёт результата — небольшим скриптом. Ответы уходят в скрытое поле формы заявки.
 */
interface Props { id?: string; compact?: boolean }
const { id = 'proverka' } = Astro.props;

const questions = [
  {
    name: 'debt',
    q: 'Какая общая сумма долгов?',
    hint: 'Кредиты, карты, микрозаймы, налоги, ЖКХ, долги по распискам — всё вместе.',
    options: [
      ['lt25', 'меньше 25 000 ₽'],
      ['25-500', 'от 25 000 до 500 000 ₽'],
      ['500-1m', 'от 500 000 до 1 000 000 ₽'],
      ['gt1m', 'больше 1 000 000 ₽'],
    ],
  },
  {
    name: 'fssp',
    q: 'Приставы окончили исполнительное производство, потому что взыскать нечего?',
    hint: 'Это постановление об окончании по п. 4 ч. 1 ст. 46 закона об исполнительном производстве. Его видно на Госуслугах.',
    options: [
      ['yes', 'да, окончили'],
      ['no', 'нет, производство идёт или его нет'],
      ['unknown', 'не знаю'],
    ],
  },
  {
    name: 'property',
    q: 'Есть ли имущество кроме единственного жилья и вещей?',
    hint: 'Автомобиль, вторая квартира, доля, гараж, земельный участок, доля в ООО.',
    options: [
      ['no', 'нет'],
      ['yes', 'да, есть'],
    ],
  },
  {
    name: 'mortgage',
    q: 'Единственное жильё в ипотеке?',
    hint: 'Ипотечная квартира не защищена от продажи, даже если она единственная.',
    options: [
      ['no', 'нет'],
      ['yes', 'да, в ипотеке'],
      ['nohome', 'своего жилья нет'],
    ],
  },
  {
    name: 'deals',
    q: 'За последние 3 года продавали, дарили или переоформляли имущество?',
    hint: 'Включая сделки с родственниками, раздел имущества с супругом, отказ от наследства.',
    options: [
      ['no', 'нет'],
      ['yes', 'да'],
    ],
  },
  {
    name: 'income',
    q: 'Есть официальный доход, которого хватило бы погасить долги за 3 года?',
    hint: 'Если да, суд может ввести реструктуризацию: долги платят по графику без пеней.',
    options: [
      ['no', 'нет, не хватит'],
      ['yes', 'да, хватит'],
    ],
  },
];
---
<div class="quiz rounded-[18px] border border-line bg-card p-5 sm:p-8" id={id} data-quiz>
  <p class="eyebrow">Проверка за 1 минуту</p>
  <h2 class="mt-1 text-[1.75rem]">Подходит ли вам банкротство</h2>
  <p class="mt-2 text-muted">6 вопросов. Результат — предварительный: точный ответ даю после разбора документов на консультации.</p>

  <form class="mt-6 grid gap-6" data-quiz-form>
    {questions.map((item, idx) => (
      <fieldset class="grid gap-2" data-step={idx}>
        <legend class="font-medium"><span class="mr-1 font-mono text-[0.875rem] text-muted">{String(idx + 1).padStart(2, '0')}</span> {item.q}</legend>
        <p class="text-sm text-muted">{item.hint}</p>
        <div class="mt-1 grid gap-2 sm:grid-cols-2">
          {item.options.map(([value, label]) => (
            <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-[10px] border border-line-strong bg-white px-3 py-2 transition-colors hover:border-ink/40 has-[:checked]:border-ink has-[:checked]:bg-paper">
              <input type="radio" name={item.name} value={value} class="h-4 w-4 accent-[var(--color-ink)]" required />
              <span>{label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}
    <button type="submit" class="btn btn-primary w-full sm:w-auto">Показать результат</button>
    <noscript><p class="text-sm text-muted">Для расчёта нужен JavaScript. Или просто позвоните — отвечу на эти вопросы по телефону.</p></noscript>
  </form>

  <div class="mt-6 hidden rounded-[14px] border border-line-strong bg-paper p-5 sm:p-6" data-quiz-result role="status" aria-live="polite">
    <p class="font-serif text-[1.375rem] leading-snug font-medium" data-r-title></p>
    <p class="mt-2" data-r-text></p>
    <ul class="mt-3 list-disc space-y-1.5 pl-5 text-[0.97rem]" data-r-notes></ul>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="#zayavka" class="btn btn-primary">Обсудить результат бесплатно</a>
      <a href="" class="btn btn-ghost hidden" data-r-link></a>
    </div>
  </div>
</div>

<script>
  type A = Record<string, string>;
  const LABEL: Record<string, string> = {
    lt25: 'долг < 25 тыс.', '25-500': 'долг 25–500 тыс.', '500-1m': 'долг 0,5–1 млн', gt1m: 'долг > 1 млн',
  };

  function decide(a: A) {
    const notes: string[] = [];
    if (a.debt === 'lt25') {
      return {
        title: 'Банкротство вам, скорее всего, не нужно',
        text: 'При долге до 25 000 ₽ внесудебное банкротство недоступно, а судебная процедура обойдётся дороже самого долга. Обычно такие вопросы решаются переговорами с кредитором, отсрочкой или оспариванием начислений.',
        notes,
        link: null as null | [string, string],
      };
    }
    const mfc = a.debt !== 'gt1m' && a.fssp === 'yes' && a.property === 'no';
    if (mfc) {
      notes.push('Процедура бесплатная, длится около 6 месяцев, суд и финансовый управляющий не нужны.');
      notes.push('Важно правильно составить список кредиторов: долги, которые не указаны в заявлении, не спишут.');
      if (a.deals === 'yes') notes.push('Сделки за последние 3 года стоит обсудить до подачи: кредиторы могут прекратить внесудебную процедуру и перевести дело в суд.');
      return {
        title: 'Похоже, вам подходит банкротство через МФЦ',
        text: 'Сумма долга в пределах 25 000–1 000 000 ₽, исполнительное производство окончено, имущества нет — это базовые условия внесудебного банкротства.',
        notes,
        link: ['/bankrotstvo-fizicheskih-lic/cherez-mfc/', 'Условия банкротства через МФЦ'] as [string, string],
      };
    }
    let title = 'Вам подходит судебное банкротство';
    let text = 'Дело рассматривает Арбитражный суд Томской области, процедуру ведёт финансовый управляющий. Итог для большинства должников — освобождение от долгов.';
    if (a.income === 'yes') {
      title = 'Возможна реструктуризация или списание долгов';
      text = 'При достаточном доходе суд может утвердить план реструктуризации: долги платятся по графику до 3 лет, без пеней и штрафов. Если дохода не хватает, вводится реализация имущества и долги списываются.';
    }
    if (a.debt === 'gt1m' || a.debt === '500-1m') notes.push('При долге от 500 000 ₽ и невозможности платить подать заявление — не только право, но и обязанность гражданина (30 рабочих дней).');
    if (a.property === 'yes') notes.push('Имущество сверх защищённого законом (единственное жильё, вещи обихода) продают на торгах. Разберём, что сохранится, ещё до подачи.');
    if (a.mortgage === 'yes') notes.push('Ипотечная квартира не защищена статусом единственного жилья. Варианты: реструктуризация, мировое соглашение, продолжение платежей по договору с согласия банка.');
    if (a.deals === 'yes') notes.push('Сделки за 3 года до подачи могут оспорить. Нужен анализ до заявления — это главный риск процедуры.');
    if (a.debt !== 'gt1m' && a.fssp !== 'yes' && a.property === 'no') notes.push('Если приставы окончат производство из-за отсутствия имущества, откроется бесплатный путь через МФЦ. Иногда имеет смысл подождать.');
    notes.push('Обязательные расходы: 25 000 ₽ на депозит суда для вознаграждения финансового управляющего и публикации.');
    return {
      title, text, notes,
      link: ['/bankrotstvo-fizicheskih-lic/', 'Как проходит банкротство граждан'] as [string, string],
    };
  }

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-quiz-form]')!;
    const box = root.querySelector<HTMLElement>('[data-quiz-result]')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const a: A = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
      const r = decide(a);
      box.querySelector('[data-r-title]')!.textContent = r.title;
      box.querySelector('[data-r-text]')!.textContent = r.text;
      const ul = box.querySelector('[data-r-notes]')!;
      ul.innerHTML = '';
      r.notes.forEach((n) => { const li = document.createElement('li'); li.textContent = n; ul.appendChild(li); });
      const link = box.querySelector<HTMLAnchorElement>('[data-r-link]')!;
      if (r.link && location.pathname !== r.link[0]) { link.href = r.link[0]; link.textContent = r.link[1]; link.classList.remove('hidden'); }
      else link.classList.add('hidden');
      box.classList.remove('hidden');
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      const ru = (v: string) => ({ yes: 'да', no: 'нет', unknown: 'не знает', nohome: 'нет жилья' } as Record<string, string>)[v] ?? v;
      const summary = `Квиз: ${r.title}; ${LABEL[a.debt] ?? ''}; ИП окончено приставами: ${ru(a.fssp)}; имущество: ${ru(a.property)}; ипотека: ${ru(a.mortgage)}; сделки за 3 года: ${ru(a.deals)}; доход на 3 года: ${ru(a.income)}`;
      document.querySelectorAll<HTMLInputElement>('[data-quiz-field]').forEach((f) => (f.value = summary));
    });
  });
</script>
