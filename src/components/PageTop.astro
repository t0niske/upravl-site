---
/**
 * Синяя полоса внутренних страниц: фон как на первом экране главной (стол юриста + градиент),
 * шапка-плашка, хлебные крошки и слот для заголовка страницы (H1, подводка, кнопки, цифры).
 */
import { Image } from 'astro:assets';
import SiteHeader from './SiteHeader.astro';
import court from '../assets/page-bg-desk.png';
import portraitImg from '../assets/antonets-hero.png';
import { person } from '../data/site';
import type { Crumb } from '../data/schema';

interface Props { crumbs?: Crumb[]; bg?: ImageMetadata; portrait?: boolean; bgPos?: string }
const { crumbs = [], portrait = false, bgPos } = Astro.props;
// с портретом фон — только градиент (как на главной), если свой фон не передан явно
const bg = Astro.props.bg ?? (portrait ? undefined : court);
---

<section class={`pt relative z-40 isolate overflow-hidden text-white${portrait ? ' has-portrait' : ''}${bg ? '' : ' no-img'}`}>
  <div class="pt-bg absolute inset-0 -z-10" aria-hidden="true">
    {bg && <Image src={bg} alt="" widths={[960, 1600, 2400]} sizes="100vw" class="pt-court" style={bgPos ? `object-position:${bgPos}` : undefined} loading="eager" />}
  </div>
  <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
    <SiteHeader />
    {crumbs.length > 0 && (
      <nav aria-label="Хлебные крошки" class="pt-crumbs">
        <ol>
          <li><a href="/">Главная</a></li>
          {crumbs.map((c, i) => (
            <li>
              <span aria-hidden="true">/</span>
              {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="pt-body">
      <slot />
    </div>
    {portrait && (
      <figure class="pt-fig">
        <Image src={portraitImg} alt={`${person.name}, арбитражный управляющий`} widths={[480, 720, 1000]} sizes="(min-width: 1024px) 36vw, 80vw" class="pt-photo" loading="eager" fetchpriority="high" />
      </figure>
    )}
  </div>
</section>

<style>
  .pt { padding-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .pt-bg { background: linear-gradient(155deg, #1b2a45 0%, #13284a 40%, #0c3466 75%, #0b3d78 100%); }
  .pt-court { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 80% 60%; opacity: 0.8; }
  .pt-bg::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgb(16 34 64 / 0.96) 0%, rgb(16 34 64 / 0.8) 45%, rgb(16 34 64 / 0.35) 100%),
      linear-gradient(0deg, rgb(11 40 80 / 0.5) 0%, transparent 40%);
  }
  .pt-crumbs { margin-top: clamp(1.5rem, 3vw, 2.5rem); font-size: 0.9375rem; }
  .pt-crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.5rem; }
  .pt-crumbs li { display: flex; align-items: center; gap: 0.5rem; color: rgb(255 255 255 / 0.9); }
  .pt-crumbs a { color: rgb(255 255 255 / 0.65); text-decoration: none; }
  .pt-crumbs a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .pt-crumbs span[aria-hidden] { color: rgb(255 255 255 / 0.4); }
  .pt-body:empty { display: none; }
  /* без картинки — свечение как на главной */
  .no-img .pt-bg::after {
    background:
      radial-gradient(40% 60% at 78% 50%, rgb(30 92 168 / 0.38), transparent 70%),
      linear-gradient(0deg, rgb(11 40 80 / 0.55) 0%, transparent 35%);
  }
  /* большой портрет: на телефоне — под текстом, на десктопе — справа, стоит на нижнем краю */
  .pt-fig { display: flex; justify-content: center; margin: 1.5rem -1rem calc(-1 * clamp(2.5rem, 5vw, 4.5rem)); }
  .pt-photo { display: block; width: min(82%, 20rem); height: auto; }
  @media (min-width: 1024px) {
    .has-portrait .pt-body { position: relative; z-index: 1; max-width: 50%; }
    /* цифры 2×2, чтобы не залезали на портрет */
    .has-portrait :global(.ph-facts) { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.25rem; }
    .has-portrait :global(.ph-fact:nth-child(odd)::before) { display: none; }
    .has-portrait :global(.ph-fact dd), .has-portrait :global(.ph-fact dt) { white-space: nowrap; }
  }
  @media (min-width: 1440px) {
    .has-portrait .pt-body { max-width: 64%; }
    .has-portrait :global(.ph-facts) { grid-template-columns: repeat(4, auto); row-gap: 0; }
    .has-portrait :global(.ph-fact:nth-child(odd):not(:first-child)::before) { display: block; }
  }
  @media (min-width: 1024px) {
    .pt-fig { position: absolute; top: 6.5rem; right: max(3.25rem, calc((100vw - 100rem) / 2 + 3.25rem)); bottom: 0; margin: 0; pointer-events: none; }
    .pt-photo { width: auto; height: 100%; max-width: none; object-fit: contain; object-position: bottom; }
  }
  .pt-body { margin-top: clamp(1rem, 2vw, 1.75rem); }
</style>
