---
/**
 * Квиз на главной по референсу дизайнера (18.11.2026): синяя градиентная плашка,
 * слева заголовок и виды долгов, справа белая карточка — вопросы по одному.
 * Вопросы и расчёт — src/data/quiz.ts (общие с Quiz.astro). Без JS виден первый вопрос и телефон.
 */
import { nb } from '../data/typo';
import { contacts } from '../data/site';
import { questions } from '../data/quiz';

const debts: [string, string][] = [
  ['card', 'Кредиты и карты'],
  ['coins', 'Микрозаймы'],
  ['receipt', 'Налоги и штрафы'],
  ['home', 'Долги за ЖКХ'],
  ['pen', 'Долги по распискам'],
  ['users', 'Поручительство'],
];
const total = questions.length;
---

<section id="proverka" class="hq" aria-labelledby="hq-title">
  <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-8">
    <div class="hq-shell">
      <div class="hq-side">
        <div>
          <h2 id="hq-title" class="hq-title">{nb('Узнайте, можно ли списать ваши долги через банкротство')}</h2>
          <p class="hq-lead">{nb(`${total} вопросов займут пару минут. Увидите предварительный вывод и главные риски, а точный ответ дам после разбора документов на бесплатной консультации`)}</p>
        </div>
        <div class="hq-debts">
          <p class="hq-debts-label">Помогаю списать</p>
          <ul class="hq-chips">
            {debts.map(([icon, label]) => (
              <li class="hq-chip">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {icon === 'card' && <><rect x="2.5" y="5" width="19" height="14" rx="2" /><path d="M2.5 10h19M6 15h4" /></>}
                  {icon === 'coins' && <><circle cx="9" cy="9" r="6" /><path d="M17.5 9.6A6 6 0 1 1 9.6 17.5M8 7.5h2v4" /></>}
                  {icon === 'receipt' && <><path d="M5 3h14v18l-2.5-1.5L14 21l-2-1.5L10 21l-2.5-1.5L5 21z" /><path d="M9 8h6M9 12h6" /></>}
                  {icon === 'home' && <><path d="M3.5 10.5 12 3.5l8.5 7" /><path d="M5.5 9v11h13V9M10 20v-5h4v5" /></>}
                  {icon === 'pen' && <><path d="M14 4h-8a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-6" /><path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z" /></>}
                  {icon === 'users' && <><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.2a6.5 6.5 0 0 1 3.5 5.8" /></>}
                </svg>
                {label}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="hq-card" data-hq>
        <!-- Вопросы по одному -->
        <form class="hq-steps" data-hq-form>
          <div class="hq-progress">
            <span class="hq-step-label tnum" data-hq-count>Вопрос 1 из {total}</span>
            <span class="hq-bar" aria-hidden="true"><i data-hq-bar></i></span>
          </div>
          {questions.map((item, idx) => (
            <fieldset class="hq-q" data-hq-step={idx} hidden={idx !== 0}>
              <legend class="hq-q-title">{nb(item.q)}</legend>
              <p class="hq-q-hint">{nb(item.hint)}</p>
              <div class="hq-opts">
                {item.options.map(([value, label]) => (
                  <label class="hq-opt">
                    <input type="radio" name={item.name} value={value} />
                    <span>{nb(label)}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
          <noscript><p class="hq-q-hint">{nb('Проверка работает с включённым JavaScript. Можно просто позвонить — отвечу на эти вопросы по телефону.')}</p></noscript>
          <button type="button" class="hq-back" data-hq-back hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
            Назад
          </button>
        </form>

        <!-- Результат -->
        <div class="hq-result" data-hq-result hidden role="status" aria-live="polite">
          <p class="hq-step-label">Предварительный вывод</p>
          <p class="hq-card-title" data-r-title tabindex="-1"></p>
          <p class="hq-card-text" data-r-text></p>
          <ul class="hq-notes" data-r-notes></ul>
          <div class="hq-actions">
            <a href="#zayavka" class="hq-btn">Обсудить результат бесплатно</a>
            <button type="button" class="hq-again" data-hq-again>Пройти заново</button>
          </div>
        </div>

        <div class="hq-contact">
          <p class="hq-contact-label">Для быстрой связи</p>
          <a href={contacts.phone2Href} class="hq-phone tnum">{contacts.phone2}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hq { padding: 0 0 clamp(3rem, 5.5vw, 5.75rem); background: #fff; }
  .hq-shell {
    display: grid; gap: clamp(1.5rem, 2.6vw, 2.5rem);
    padding: clamp(0.5rem, 1.1vw, 1rem); border-radius: clamp(16px, 1.6vw, 24px);
    background: linear-gradient(105deg, #034b8e 0%, #053a6e 42%, #0b1a30 100%);
    color: #fff;
  }
  @media (min-width: 1024px) {
    .hq-shell { grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr); gap: clamp(1.5rem, 3vw, 3rem); }
  }

  .hq-side { display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; padding: clamp(1rem, 2.4vw, 2.5rem); }
  .hq-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.75rem, 2.6vw, 3rem); line-height: 1.06; letter-spacing: -0.025em;
    color: #fff; text-wrap: wrap;
  }
  .hq-lead { margin-top: clamp(1rem, 1.6vw, 1.5rem); max-width: 34rem; font-size: clamp(1rem, 1.25vw, 1.25rem); line-height: 1.4; color: rgb(255 255 255 / 0.72); text-wrap: wrap; }
  .hq-debts-label { font-size: clamp(0.9375rem, 1.05vw, 1.0625rem); color: rgb(255 255 255 / 0.62); }
  .hq-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.875rem; max-width: 36rem; }
  .hq-chip {
    display: inline-flex; align-items: center; gap: 0.625rem;
    padding: 0.625rem 1rem 0.625rem 0.875rem; border-radius: 8px;
    background: rgb(255 255 255 / 0.1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    font-size: clamp(0.9375rem, 1.05vw, 1.0625rem); line-height: 1.2;
  }
  .hq-chip svg { width: 18px; height: 18px; flex: none; color: rgb(255 255 255 / 0.75); }

  /* Белая карточка */
  .hq-card {
    display: flex; flex-direction: column; min-height: clamp(28rem, 38vw, 38rem);
    padding: clamp(1.25rem, 2.6vw, 2.75rem); border-radius: clamp(14px, 1.6vw, 24px);
    background: #fff; color: #15171c;
  }
  .hq-card-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.25rem, 1.75vw, 2rem); line-height: 1.15; letter-spacing: -0.015em; text-wrap: wrap;
  }
  .hq-card-text { margin-top: 1rem; max-width: 36rem; font-size: clamp(1rem, 1.15vw, 1.1875rem); line-height: 1.4; color: #6b7079; text-wrap: wrap; }
  .hq-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.625rem;
    min-height: clamp(3.25rem, 4vw, 4rem); margin-top: clamp(1.5rem, 2.2vw, 2rem); padding: 0 1.75rem;
    border-radius: 10px; background: #034b8e; color: #fff;
    font-size: clamp(1rem, 1.15vw, 1.25rem); font-weight: 500; text-decoration: none; cursor: pointer;
    transition: background-color 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .hq-btn svg { width: 20px; height: 20px; }
  .hq-btn:hover { background: #0a5aa6; }
  .hq-btn:active { transform: scale(0.98); }
  .hq-btn:focus-visible, .hq-opt:has(input:focus-visible), .hq-back:focus-visible, .hq-again:focus-visible { outline: 2px solid #034b8e; outline-offset: 2px; }
  [data-r-title]:focus { outline: none; }

  /* Шаги */
  .hq-progress { display: grid; gap: 0.625rem; }
  .hq-step-label { font-size: clamp(0.875rem, 0.95vw, 1rem); color: #7c818a; }
  .hq-bar { display: block; height: 4px; overflow: hidden; border-radius: 2px; background: #e6e8ec; }
  .hq-bar i { display: block; width: 0; height: 100%; border-radius: 2px; background: #034b8e; transition: width 250ms var(--ease-out); }
  .hq-q { margin-top: clamp(1.25rem, 2vw, 1.75rem); }
  .hq-q-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.25rem, 1.6vw, 1.75rem); line-height: 1.18; letter-spacing: -0.015em; text-wrap: wrap; }
  .hq-q-hint { margin-top: 0.625rem; font-size: clamp(0.9375rem, 1vw, 1.0625rem); line-height: 1.4; color: #7c818a; text-wrap: wrap; }
  .hq-opts { display: grid; gap: 0.5rem; margin-top: 1.25rem; }
  @media (min-width: 640px) { .hq-opts { grid-template-columns: 1fr 1fr; } }
  .hq-opt {
    display: flex; align-items: center; gap: 0.75rem; min-height: 3.25rem; padding: 0.625rem 1rem;
    border-radius: 10px; box-shadow: inset 0 0 0 1px #dfe1e5; cursor: pointer;
    font-size: clamp(1rem, 1.05vw, 1.0625rem); line-height: 1.3;
    transition: box-shadow 150ms var(--ease-out), background-color 150ms var(--ease-out);
  }
  .hq-opt input { appearance: none; flex: none; width: 18px; height: 18px; margin: 0; border-radius: 50%; box-shadow: inset 0 0 0 1.5px #b8bcc4; transition: box-shadow 150ms var(--ease-out); }
  .hq-opt input:focus { outline: none; }
  .hq-opt:hover { box-shadow: inset 0 0 0 1px #034b8e; }
  .hq-opt:has(input:checked) { background: #034b8e; color: #fff; box-shadow: none; }
  .hq-opt input:checked { box-shadow: inset 0 0 0 5px #fff; }
  .hq-back {
    display: inline-flex; align-items: center; gap: 0.25rem; margin-top: 1.25rem; padding: 0.375rem 0.25rem;
    font-size: 1rem; color: #6b7079; cursor: pointer; background: none; border: 0;
  }
  .hq-back svg { width: 18px; height: 18px; }
  .hq-back:hover { color: #15171c; }
  .hq-back[hidden] { display: none; }

  /* Результат */
  .hq-result .hq-card-title { margin-top: 0.5rem; }
  .hq-notes { display: grid; gap: 0.625rem; margin-top: 1.25rem; }
  .hq-notes :global(li) {
    position: relative; padding-left: 1.5rem;
    font-size: clamp(0.9375rem, 1.05vw, 1.0625rem); line-height: 1.4; color: #2a2d33;
  }
  .hq-notes :global(li)::before {
    content: ''; position: absolute; left: 0; top: 0.45em; width: 12px; height: 12px;
    background:
      linear-gradient(#034b8e 0 0) 0 0 / 5px 5px no-repeat,
      linear-gradient(#034b8e 0 0) 7px 0 / 5px 5px no-repeat,
      linear-gradient(#034b8e 0 0) 0 7px / 5px 5px no-repeat,
      linear-gradient(#034b8e 0 0) 7px 7px / 5px 5px no-repeat;
  }
  .hq-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; }
  .hq-again { margin-top: clamp(1.5rem, 2.2vw, 2rem); padding: 0.5rem 0.25rem; font-size: 1rem; color: #6b7079; background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .hq-again:hover { color: #15171c; }

  .hq-contact { margin-top: auto; padding-top: clamp(1.75rem, 3vw, 3rem); }
  .hq-contact-label { font-size: clamp(0.875rem, 0.95vw, 1rem); color: #8a8f98; }
  .hq-phone { display: inline-block; margin-top: 0.375rem; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.125rem, 1.4vw, 1.5rem); color: #15171c; text-decoration: none; }
  .hq-phone:hover { color: #034b8e; }
</style>

<script>
  import { decide, summary, type A } from '../data/quiz';

  document.querySelectorAll<HTMLElement>('[data-hq]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-hq-form]')!;
    const result = root.querySelector<HTMLElement>('[data-hq-result]')!;
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-hq-step]')];
    const count = form.querySelector<HTMLElement>('[data-hq-count]')!;
    const bar = form.querySelector<HTMLElement>('[data-hq-bar]')!;
    const back = form.querySelector<HTMLButtonElement>('[data-hq-back]')!;
    let i = 0;

    const show = (n: number) => {
      i = n;
      steps.forEach((s, k) => (s.hidden = k !== n));
      count.textContent = `Вопрос ${n + 1} из ${steps.length}`;
      bar.style.width = `${(n / steps.length) * 100}%`;
      back.hidden = n === 0;
    };

    const finish = () => {
      const a: A = Object.fromEntries([...new FormData(form).entries()].map(([k, v]) => [k, String(v)]));
      const r = decide(a);
      result.querySelector('[data-r-title]')!.textContent = r.title;
      result.querySelector('[data-r-text]')!.textContent = r.text;
      const ul = result.querySelector('[data-r-notes]')!;
      ul.innerHTML = '';
      r.notes.forEach((n) => { const li = document.createElement('li'); li.textContent = n; ul.appendChild(li); });
      form.hidden = true;
      result.hidden = false;
      const text = summary(a, r.title);
      document.querySelectorAll<HTMLInputElement>('[data-quiz-field]').forEach((f) => (f.value = text));
      result.querySelector<HTMLElement>('[data-r-title]')!.focus?.();
    };

    show(0);

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.type !== 'radio') return;
      // короткая пауза, чтобы было видно выбранный вариант
      setTimeout(() => {
        // при долге меньше 25 000 ₽ остальные вопросы не влияют на вывод
        if (t.name === 'debt' && t.value === 'lt25') return finish();
        if (i < steps.length - 1) show(i + 1);
        else finish();
      }, 220);
    });

    back.addEventListener('click', () => { if (i > 0) show(i - 1); });

    root.querySelector('[data-hq-again]')!.addEventListener('click', () => {
      form.reset();
      result.hidden = true;
      form.hidden = false;
      show(0);
    });
  });
</script>
