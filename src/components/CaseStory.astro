---
/**
 * Карточка завершённого дела: фото, итог, короткая история, суд, замазанный номер и дата.
 * Используется в ленте на главной (HomeCases) и на странице /dela/. Данные — recentCases в site.ts.
 */
import { Image } from 'astro:assets';
import { nb } from '../data/typo';
import { maskCase, courtOf, type RecentCase } from '../data/site';
import folder from '../assets/cases/folder.jpg';
import padlock from '../assets/cases/padlock.jpg';
import stamp from '../assets/cases/stamp.jpg';
import keys from '../assets/cases/keys.jpg';
import binders from '../assets/cases/binders.jpg';
import phone from '../assets/cases/phone.jpg';

interface Props { c: RecentCase; heading?: 'h2' | 'h3' }
const { c, heading = 'h3' } = Astro.props;
const Heading = heading;

const imgs = { folder, padlock, stamp, keys, binders, phone };
const alts = {
  folder: 'Папка дела, перевязанная тесёмкой, на стопке документов',
  padlock: 'Открытый замок рядом с банковской картой',
  stamp: 'Документ с печатью и перьевая ручка',
  keys: 'Ключи от квартиры на документе',
  binders: 'Папки с документами на полке',
  phone: 'Телефон экраном вниз рядом с чашкой кофе',
};
const date = c.finished.split('-').reverse().join('.');
---

<article class="cs">
  <Image src={imgs[c.img]} alt={alts[c.img]} widths={[480, 800]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 86vw" class="cs-img" loading="lazy" />
  <div class="cs-body">
    <Heading class="cs-name">{nb(c.title)}</Heading>
    <p class="cs-text">{nb(c.text)}</p>
    <p class="cs-court">{courtOf(c.number)}</p>
    <div class="cs-foot">
      <ul class="cs-tags">
        <li class="cs-tag is-num tnum" title="Номер дела скрыт, чтобы не раскрывать клиента">{maskCase(c.number)}</li>
      </ul>
      <p class="cs-date tnum" title="Дата завершения и срок процедуры"><time datetime={c.finished}>{date}</time> · {c.months}&nbsp;мес.</p>
    </div>
  </div>
</article>


<style>
  .cs { display: flex; flex-direction: column; height: 100%; padding: 0.75rem; border-radius: 16px; background: #fff; }
  .cs-img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 10px; }
  .cs-body { display: flex; flex: 1; flex-direction: column; padding: clamp(0.875rem, 1.2vw, 1.25rem) clamp(0.5rem, 0.9vw, 0.875rem) 0.25rem; }
  .cs-name { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.15; letter-spacing: -0.015em; color: #15171c; text-wrap: wrap; }
  .cs-text { margin-top: 0.5rem; font-size: var(--fs-body); line-height: 1.45; color: #7c818a; text-wrap: wrap; }
  .cs-court { margin-top: 0.75rem; margin-bottom: 1rem; font-size: 0.9375rem; line-height: 1.35; color: #8a8f98; }
  .cs-foot { display: flex; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; margin-top: auto; padding-top: 0.875rem; border-top: 1px solid #eceef1; }
  .cs-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .cs-tag { padding: 0.375rem 0.625rem; border-radius: 8px; background: #f3f4f6; font-size: 0.875rem; line-height: 1.3; color: #5f646d; white-space: nowrap; }
  .cs-tag.is-num { background: #e6eef8; color: #034b8e; font-weight: 500; }
  .cs-date { white-space: nowrap; font-size: 0.875rem; color: #8a8f98; }
</style>
