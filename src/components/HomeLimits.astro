---
/**
 * «Кому банкротство не поможет» (18.11.2026): серый фон, сверху заголовок с подсказкой и кнопкой к квизу,
 * ниже четыре карточки со значками — отличается от «Услуг» (там список с номерами).
 */
import { nb } from '../data/typo';

const limits = [
  { icon: 'family', title: 'Долг — алименты или возмещение вреда', text: 'Эти обязательства закон не списывает, они остаются и после процедуры' },
  { icon: 'transfer', title: 'Имущество недавно переоформлено', text: 'Сделки за 3 года до заявления управляющий проверит; подарок родственнику могут оспорить и вернуть в конкурсную массу' },
  { icon: 'home', title: 'Нужно сохранить ипотечную квартиру', text: 'Единственное жильё в залоге не защищено. Возможна реструктуризация или мировое соглашение с банком' },
  { icon: 'doc', title: 'Долги появились через обман', text: 'Кредиты по ложным справкам и сокрытие доходов — основание отказать в освобождении от долгов' },
];
---

<section id="ogranicheniya" class="lim" aria-labelledby="limits-title">
  <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
    <span class="lim-chip">
      <span class="grid grid-cols-2 gap-[2px]" aria-hidden="true">
        <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
        <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
      </span>
      Ограничения
    </span>

    <div class="lim-head">
      <div>
        <h2 id="limits-title" class="lim-title">{nb('Кому банкротство не поможет')}</h2>
        <p class="lim-lead">{nb('Об этом лучше узнать до того, как платить. Если увижу что-то из этого на консультации — скажу прямо')}</p>
      </div>
    </div>

    <ul class="lim-grid">
      {limits.map((l) => (
        <li class="lim-card">
          <span class="lim-ic" aria-hidden="true">
            <svg viewBox="0 0 512 512" fill="currentColor">
              <g transform="translate(0,512) scale(0.1,-0.1)">
                {l.icon === 'family' && <><path d="M1390 4260 c-233 -29 -452 -159 -586 -347 -170 -237 -208 -541 -103 -813 81 -211 277 -404 492 -485 153 -57 351 -69 507 -29 154 39 313 135 422 254 354 388 276 1000 -164 1287 -165 108 -376 157 -568 133z" /><path d="M3310 4260 c-233 -29 -452 -159 -586 -347 -170 -237 -208 -541 -103 -813 81 -211 277 -404 492 -485 153 -57 351 -69 507 -29 154 39 313 135 422 254 354 388 276 1000 -164 1287 -165 108 -376 157 -568 133z" /><path d="M1268 2339 c-554 -64 -985 -500 -1047 -1062 -14 -125 -14 -207 1 -265 16 -64 86 -134 150 -150 33 -9 210 -12 603 -12 525 0 556 1 551 18 -33 113 -39 192 -26 334 35 392 194 754 449 1020 24 26 43 50 40 52 -12 13 -203 56 -284 66 -106 12 -328 11 -437 -1z" /><path d="M3095 2344 c-376 -40 -700 -221 -921 -514 -152 -201 -254 -498 -254 -741 0 -91 36 -161 105 -204 l48 -30 1316 -3 c1487 -3 1388 -8 1459 73 56 64 67 114 53 252 -25 248 -104 457 -245 648 -189 255 -456 427 -774 496 -86 19 -135 21 -422 24 -179 1 -343 1 -365 -1z" /></>}
                {l.icon === 'transfer' && <><path d="M1210 4468 c-46 -13 -735 -692 -764 -752 -22 -48 -24 -128 -3 -177 18 -42 680 -703 740 -739 124 -73 293 18 305 164 8 94 -6 116 -176 288 l-156 158 1695 2 1696 3 48 30 c65 40 95 97 95 179 -1 104 -53 182 -138 206 -25 6 -592 10 -1717 10 l-1679 0 152 153 c161 162 182 195 182 274 -1 145 -136 242 -280 201z" /><path d="M3791 2340 c-90 -22 -161 -112 -161 -204 1 -81 26 -119 184 -276 l146 -145 -1693 -5 -1694 -5 -48 -30 c-65 -40 -95 -97 -95 -179 1 -104 53 -182 138 -206 25 -6 592 -10 1717 -10 l1679 0 -152 -153 c-161 -162 -182 -195 -182 -274 1 -151 159 -257 292 -195 50 23 736 705 755 751 19 44 18 129 0 172 -17 41 -680 703 -735 736 -44 25 -104 35 -151 23z" /></>}
                {l.icon === 'home' && <><path d="M2464 4877 c-125 -85 -2412 -1831 -2433 -1857 -30 -38 -39 -106 -18 -146 22 -42 347 -469 357 -469 5 0 473 353 1041 785 567 432 1048 795 1068 807 23 15 52 23 81 23 29 0 58 -8 81 -23 20 -12 501 -375 1068 -807 568 -432 1036 -785 1041 -785 10 0 335 427 357 469 21 40 12 108 -18 146 -21 26 -2308 1772 -2433 1857 -38 26 -58 33 -96 33 -38 0 -58 -7 -96 -33z" /><path d="M1637 2984 l-917 -697 0 -981 c0 -1094 -4 -1024 69 -1073 l34 -23 1737 0 1737 0 34 23 c73 49 69 -21 69 1073 l0 981 -909 692 c-500 380 -916 694 -924 697 -8 3 -378 -272 -930 -692z m385 -225 c196 -41 363 -217 399 -421 52 -293 -198 -588 -500 -588 -231 0 -437 161 -496 387 -93 356 235 698 597 622z m1082 -12 c73 -41 94 -121 55 -200 -25 -49 -912 -1596 -943 -1645 -24 -37 -88 -72 -132 -72 -42 0 -104 39 -126 80 -41 75 -53 53 474 970 443 771 489 847 524 867 22 13 55 23 74 23 19 0 53 -10 74 -23z m219 -912 c181 -47 325 -190 373 -370 44 -165 -11 -359 -138 -485 -285 -282 -761 -139 -854 257 -83 353 266 690 619 598z" /><path d="M1835 2451 c-140 -65 -167 -247 -52 -348 134 -117 342 -22 341 157 -1 152 -154 253 -289 191z" /><path d="M3120 1534 c-121 -53 -163 -201 -88 -315 27 -39 117 -89 162 -89 155 0 260 159 197 295 -48 103 -170 153 -271 109z" /></>}
                {l.icon === 'doc' && <><path d="M240 2560 l0 -2320 1440 0 1440 0 0 215 c0 288 -23 265 265 265 l215 0 0 382 0 383 -177 -177 -178 -177 -215 -85 c-118 -47 -225 -86 -238 -86 -30 0 -72 42 -72 73 0 13 27 90 60 172 33 82 60 150 60 152 0 2 -513 3 -1140 3 l-1140 0 0 80 0 80 1183 0 1182 0 80 80 80 80 -1263 0 -1262 0 0 80 0 80 1343 0 1342 0 178 178 177 177 0 1343 0 1342 -1680 0 -1680 0 0 -2320z m1850 2145 c562 -85 976 -590 947 -1154 -21 -403 -245 -757 -595 -939 -161 -83 -294 -120 -478 -129 -259 -13 -535 77 -744 245 -519 415 -561 1190 -90 1662 254 254 605 369 960 315z m1190 -2625 l0 -80 -1360 0 -1360 0 0 80 0 80 1360 0 1360 0 0 -80z m-1040 -960 l0 -80 -840 0 -840 0 0 80 0 80 840 0 840 0 0 -80z m320 0 l0 -80 -80 0 -80 0 0 80 0 80 80 0 80 0 0 -80z" /><path d="M1770 4549 c-135 -24 -286 -85 -397 -160 -82 -55 -224 -208 -274 -295 -102 -175 -133 -293 -133 -494 0 -160 12 -226 65 -359 94 -235 302 -441 540 -535 124 -48 193 -60 349 -60 119 0 160 4 230 23 187 50 309 120 445 256 136 136 206 257 257 445 32 118 32 336 0 457 -47 180 -126 320 -256 449 -128 128 -270 210 -445 255 -89 23 -297 33 -381 18z m-8 -549 l158 -159 160 161 160 161 115 -115 c63 -64 115 -120 115 -124 0 -5 -70 -79 -156 -165 l-155 -155 160 -161 160 -160 -120 -119 -119 -119 -160 160 -160 160 -160 -160 -160 -160 -119 119 -120 119 160 160 160 161 -155 155 c-86 86 -156 160 -156 165 0 8 220 235 229 236 2 0 75 -72 163 -160z" /><path d="M4595 2960 l-120 -120 63 -62 62 -63 122 122 123 123 -60 60 c-33 33 -62 60 -65 60 -3 0 -59 -54 -125 -120z" /><path d="M3715 2080 l-640 -640 63 -62 62 -63 642 642 643 643 -60 60 c-33 33 -62 60 -65 60 -3 0 -293 -288 -645 -640z" /><path d="M2967 1243 c-9 -25 -15 -48 -13 -50 3 -3 85 25 95 34 5 4 -50 63 -59 63 -3 0 -13 -21 -23 -47z" /><path d="M3280 458 l0 -103 100 100 c55 55 100 101 100 102 0 2 -45 3 -100 3 l-100 0 0 -102z" /></>}
              </g>
            </svg>
          </span>
          <h3 class="lim-name">{nb(l.title)}</h3>
          <p class="lim-text">{nb(l.text)}</p>
        </li>
      ))}
    </ul>
    <div class="lim-cta">
      <p class="lim-alt"><span class="lim-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb('Не подходит? Подскажу другой путь: реструктуризацию или переговоры с банком')}</span></p>
      <a href="#proverka" class="lim-btn">Проверить мою ситуацию</a>
    </div>
  </div>
</section>

<style>
  .lim { padding: clamp(2.5rem, 4vw, 3.5rem) 0; background: #f3f4f6; }
  .lim-chip {
    display: inline-flex; align-items: center; gap: 0.75rem;
    padding: 0.625rem 1.125rem; border-radius: 8px; background: #fff;
    font-size: clamp(1rem, 1.1vw, 1.1875rem); line-height: 1.2; color: var(--color-ink);
  }
  .lim-head { margin-top: clamp(1.25rem, 2vw, 1.75rem); }
  .lim-title { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.08; letter-spacing: -0.025em; color: #1d1e21; text-wrap: pretty; }
  .lim-lead { margin-top: 1rem; max-width: 40rem; font-size: var(--fs-lead); line-height: 1.4; color: #5f646d; text-wrap: pretty; }
  .lim-cta { display: flex; flex-direction: column; gap: 1rem; margin-top: clamp(0.75rem, 1.4vw, 1.25rem); padding: clamp(1rem, 1.8vw, 1.5rem) clamp(1.25rem, 2vw, 2rem); border-radius: 16px; background: #fff; }
  @media (min-width: 768px) { .lim-cta { flex-direction: row; align-items: center; justify-content: space-between; gap: 2rem; } }
  .lim-alt { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 0.875rem; font-size: var(--fs-body); line-height: 1.45; color: #2a2d33; text-wrap: pretty; }
  .lim-sq { display: grid; grid-template-columns: 5px 5px; grid-auto-rows: 5px; gap: 2px; margin-top: 0.45em; }
  .lim-sq i { width: 5px; height: 5px; border-radius: 1px; background: #034b8e; }
  .lim-btn {
    display: inline-flex; flex: none; align-items: center; justify-content: center; min-height: clamp(3.25rem, 4vw, 4rem); padding: 0 1.75rem;
    border-radius: 10px; background: #034b8e; color: #fff; font-size: clamp(1rem, 1.15vw, 1.25rem); font-weight: 500; text-decoration: none;
    transition: background-color 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .lim-btn:hover { background: #0a5aa6; }
  .lim-btn:active { transform: scale(0.98); }
  .lim-btn:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; }

  .lim-grid { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); margin-top: clamp(1.5rem, 2.6vw, 2.25rem); }
  @media (min-width: 640px) { .lim-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1280px) { .lim-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .lim-card { display: flex; flex-direction: column; padding: clamp(1.25rem, 2vw, 2rem); border-radius: 16px; background: #fff; }
  .lim-ic { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 12px; background: #1d1e21; color: #fff; }
  .lim-ic svg { width: 24px; height: 24px; }
  .lim-name { margin-top: clamp(1.5rem, 3vw, 2.5rem); font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -0.015em; color: #1d1e21; text-wrap: pretty; }
  .lim-text { margin-top: 0.625rem; font-size: var(--fs-body); line-height: 1.45; color: #7c818a; text-wrap: pretty; }
</style>
