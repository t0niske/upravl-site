---
/**
 * «Кому банкротство не поможет» (18.11.2026): серый фон, сверху заголовок с подсказкой и кнопкой к квизу,
 * ниже четыре карточки со значками — отличается от «Услуг» (там список с номерами).
 */
import { nb } from '../data/typo';

const limits = [
  { icon: 'family', title: 'Долг — алименты или возмещение вреда', text: 'Эти обязательства закон не списывает, они остаются и после процедуры' },
  { icon: 'transfer', title: 'Имущество недавно переоформлено', text: 'Сделки за 3 года до заявления управляющий проверит; подарок родственнику вернут в конкурсную массу' },
  { icon: 'home', title: 'Нужно сохранить ипотечную квартиру', text: 'Единственное жильё в залоге не защищено. Возможна реструктуризация или мировое соглашение с банком' },
  { icon: 'doc', title: 'Долги появились через обман', text: 'Кредиты по ложным справкам и сокрытие доходов — основание отказать в освобождении от долгов' },
];
---

<section id="ogranicheniya" class="lim" aria-labelledby="limits-title">
  <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
    <span class="lim-chip">
      <span class="grid grid-cols-2 gap-[2px]" aria-hidden="true">
        <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
        <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
      </span>
      Ограничения
    </span>

    <div class="lim-head">
      <div>
        <h2 id="limits-title" class="lim-title">{nb('Кому банкротство не поможет')}</h2>
        <p class="lim-lead">{nb('Об этом лучше узнать до того, как платить. Если увижу что-то из этого на консультации — скажу прямо')}</p>
      </div>
    </div>

    <ul class="lim-grid">
      {limits.map((l) => (
        <li class="lim-card">
          <span class="lim-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              {l.icon === 'family' && <><circle cx="8" cy="7" r="3" /><circle cx="17" cy="9" r="2.2" /><path d="M2.5 20a5.5 5.5 0 0 1 11 0M13.5 20a4 4 0 0 1 8 0" /></>}
              {l.icon === 'transfer' && <><path d="M4 8h13l-3-3M20 16H7l3 3" /></>}
              {l.icon === 'home' && <><path d="M3.5 10.5 12 3.5l8.5 7" /><path d="M5.5 9v11h13V9" /><path d="M10 14h4M12 12v4" /></>}
              {l.icon === 'doc' && <><path d="M6 3h9l4 4v14H6z" /><path d="M15 3v4h4M9 13l6 6M15 13l-6 6" /></>}
            </svg>
          </span>
          <h3 class="lim-name">{nb(l.title)}</h3>
          <p class="lim-text">{nb(l.text)}</p>
        </li>
      ))}
    </ul>
    <div class="lim-cta">
      <p class="lim-alt"><span class="lim-sq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{nb('Не подходит? Подскажу другой путь: реструктуризацию, переговоры с банком или бесплатное банкротство через МФЦ')}</span></p>
      <a href="#proverka" class="lim-btn">Проверить мою ситуацию</a>
    </div>
  </div>
</section>

<style>
  .lim { padding: clamp(2.5rem, 4vw, 3.5rem) 0; background: #f3f4f6; }
  .lim-chip {
    display: inline-flex; align-items: center; gap: 0.75rem;
    padding: 0.625rem 1.125rem; border-radius: 8px; background: #fff;
    font-size: clamp(1rem, 1.1vw, 1.1875rem); line-height: 1.2; color: var(--color-ink);
  }
  .lim-head { margin-top: clamp(1.25rem, 2vw, 1.75rem); }
  .lim-title { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.08; letter-spacing: -0.025em; color: #1d1e21; text-wrap: wrap; }
  .lim-lead { margin-top: 1rem; max-width: 40rem; font-size: var(--fs-lead); line-height: 1.4; color: #5f646d; text-wrap: wrap; }
  .lim-cta { display: flex; flex-direction: column; gap: 1rem; margin-top: clamp(0.75rem, 1.4vw, 1.25rem); padding: clamp(1rem, 1.8vw, 1.5rem) clamp(1.25rem, 2vw, 2rem); border-radius: 16px; background: #fff; }
  @media (min-width: 768px) { .lim-cta { flex-direction: row; align-items: center; justify-content: space-between; gap: 2rem; } }
  .lim-alt { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 0.875rem; font-size: var(--fs-body); line-height: 1.45; color: #2a2d33; text-wrap: wrap; }
  .lim-sq { display: grid; grid-template-columns: 5px 5px; grid-auto-rows: 5px; gap: 2px; margin-top: 0.45em; }
  .lim-sq i { width: 5px; height: 5px; border-radius: 1px; background: #034b8e; }
  .lim-btn {
    display: inline-flex; flex: none; align-items: center; justify-content: center; min-height: clamp(3.25rem, 4vw, 4rem); padding: 0 1.75rem;
    border-radius: 10px; background: #034b8e; color: #fff; font-size: clamp(1rem, 1.15vw, 1.25rem); font-weight: 500; text-decoration: none;
    transition: background-color 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .lim-btn:hover { background: #0a5aa6; }
  .lim-btn:active { transform: scale(0.98); }
  .lim-btn:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; }

  .lim-grid { display: grid; gap: clamp(0.75rem, 1.4vw, 1.25rem); margin-top: clamp(1.5rem, 2.6vw, 2.25rem); }
  @media (min-width: 640px) { .lim-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1280px) { .lim-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .lim-card { display: flex; flex-direction: column; padding: clamp(1.25rem, 2vw, 2rem); border-radius: 16px; background: #fff; }
  .lim-ic { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 12px; background: #1d1e21; color: #fff; }
  .lim-ic svg { width: 26px; height: 26px; }
  .lim-name { margin-top: clamp(1.5rem, 3vw, 2.5rem); font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -0.015em; color: #1d1e21; text-wrap: wrap; }
  .lim-text { margin-top: 0.625rem; font-size: var(--fs-body); line-height: 1.45; color: #7c818a; text-wrap: wrap; }
</style>
