---
/**
 * Блок кейсов на главной по референсу дизайнера (вариант D, 18.11.2026): карточки с фото,
 * итог дела, короткая история, суд и замазанный номер дела.
 * Данные — recentCases в site.ts (из определений суда, без личных данных). Фото — сгенерированные
 * нейтральные иллюстрации (design/photos/case-*), не снимки клиентов.
 */
import { nb } from '../data/typo';
import { recentCases } from '../data/site';
import CaseStory from './CaseStory.astro';

const featured = recentCases.filter((c) => c.featured);
const total = recentCases.length;
---

<section id="dela" class="cases" aria-labelledby="cases-title">
  <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
    <span class="hc-chip">
      <span class="grid grid-cols-2 gap-[2px]" aria-hidden="true">
        <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
        <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
      </span>
      Дела
    </span>

    <div class="mt-5 flex items-end justify-between gap-8">
      <div>
        <h2 id="cases-title" class="hc-title">{nb('Завершённые дела: как это было')}</h2>
        <p class="hc-lead">{nb('Дела, которые я вёл финансовым управляющим. Имена и номера дел не раскрываю')}</p>
      </div>
      <div class="hidden shrink-0 gap-4 lg:flex">
        <button type="button" class="hc-arrow" data-hc-prev aria-label="Предыдущие дела">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
        </button>
        <button type="button" class="hc-arrow" data-hc-next aria-label="Следующие дела">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </div>
    </div>

    <ul class="hc-track" data-hc-track>
      {featured.map((c) => (
        <li class="hc-card"><CaseStory c={c} /></li>
      ))}
      <li class="hc-card">
        <a href="/dela/" class="hc-more">
          <span class="hc-more-title">{nb('Все завершённые дела')}</span>
          <span class="hc-more-text">{nb(`${total} дел с номерами и короткими историями, а также дела прошлых лет`)}</span>
          <span class="hc-more-arrow" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
        </a>
      </li>
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.cases').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-hc-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-hc-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-hc-next]');
    if (!track || !prev || !next) return;
    const step = () => {
      const card = track.querySelector<HTMLElement>('.hc-card');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .cases { background: #f3f4f6; padding: clamp(2rem, 2.8vw, 2.5rem) 0; }
  .hc-chip {
    display: inline-flex; align-items: center; gap: 0.75rem;
    padding: 0.625rem 1.125rem; border-radius: 8px; background: #fff;
    font-size: clamp(1rem, 1.1vw, 1.1875rem); line-height: 1.2; color: var(--color-ink);
  }
  .hc-title { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.08; letter-spacing: -0.025em; color: #1d1e21; text-wrap: pretty; }
  .hc-lead { margin-top: clamp(0.75rem, 1.2vw, 1.25rem); max-width: 60rem; font-size: var(--fs-lead); line-height: 1.4; color: #5f646d; text-wrap: pretty; }
  .hc-arrow {
    display: grid; place-items: center; width: clamp(3.5rem, 3.6vw, 4.375rem); aspect-ratio: 1;
    border-radius: 8px; background: #1d1e21; color: #fff; cursor: pointer;
    transition: background-color 150ms var(--ease-out), opacity 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .hc-arrow:hover { background: #034b8e; }
  .hc-arrow:active { transform: scale(0.96); }
  .hc-arrow:disabled { opacity: 0.25; cursor: default; background: #1d1e21; }
  .hc-arrow:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; }

  .hc-track {
    --gap: clamp(1rem, 1.5vw, 1.75rem);
    display: flex; gap: var(--gap);
    margin-top: clamp(1.25rem, 2vw, 2rem);
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    margin-inline: -1rem; padding-inline: 1rem; scroll-padding-inline: 1rem;
  }
  .hc-track::-webkit-scrollbar { display: none; }
  .hc-card { flex: 0 0 90%; scroll-snap-align: start; display: flex; }
  .hc-card > :global(*) { flex: 1; }
  @media (min-width: 640px) {
    .hc-track { margin-inline: 0; padding-inline: 0; scroll-padding-inline: 0; }
    .hc-card { flex-basis: calc((100% - var(--gap)) / 2); }
  }
  @media (min-width: 1024px) {
    .hc-card { flex-basis: calc((100% - 2 * var(--gap)) / 3); }
  }

  .hc-more {
    display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; min-height: 16rem; padding: clamp(1.5rem, 2.2vw, 2.25rem);
    border-radius: 16px; background: #1d1e21; color: #fff; text-decoration: none; transition: background-color 150ms var(--ease-out);
  }
  .hc-more:hover { background: #034b8e; }
  .hc-more:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; }
  .hc-more-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.15; letter-spacing: -0.015em; }
  .hc-more-text { margin-top: -0.25rem; font-size: var(--fs-body); line-height: 1.45; color: #b5bac2; text-wrap: pretty; }
  .hc-more-arrow { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; margin-top: auto; border-radius: 8px; background: #fff; color: #1d1e21; }
</style>
