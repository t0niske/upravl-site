---
/**
 * Блок кейсов на главной по референсу дизайнера (вариант D, 18.11.2026): карточки с фото,
 * итог дела, короткая история, ссылка на картотеку и плашки с данными дела.
 * Данные — recentCases в site.ts (из определений суда, без личных данных). Фото — сгенерированные
 * нейтральные иллюстрации (design/photos/case-*), не снимки клиентов.
 */
import { Image } from 'astro:assets';
import { nb } from '../data/typo';
import { recentCases } from '../data/site';
import folder from '../assets/cases/folder.jpg';
import padlock from '../assets/cases/padlock.jpg';
import stamp from '../assets/cases/stamp.jpg';
import keys from '../assets/cases/keys.jpg';
import binders from '../assets/cases/binders.jpg';
import phone from '../assets/cases/phone.jpg';

const imgs = { folder, padlock, stamp, keys, binders, phone };
const alts = {
  folder: 'Папка дела, перевязанная тесёмкой, на стопке документов',
  padlock: 'Открытый замок рядом с банковской картой',
  stamp: 'Документ с печатью и перьевая ручка',
  keys: 'Ключи от квартиры на документе',
  binders: 'Папки с документами на полке',
  phone: 'Телефон экраном вниз рядом с чашкой кофе',
};
const date = (iso: string) => iso.split('-').reverse().join('.');
---

<section id="dela" class="cases" aria-labelledby="cases-title">
  <div class="mx-auto w-full max-w-[100rem] px-4 sm:px-[3.25rem]">
    <span class="hc-chip">
      <span class="grid grid-cols-2 gap-[2px]" aria-hidden="true">
        <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
        <i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i><i class="size-[5px] rounded-[1px] bg-[#034B8E]"></i>
      </span>
      Дела
    </span>

    <div class="mt-[clamp(1.5rem,3.4vw,3.5rem)] flex items-end justify-between gap-8">
      <div>
        <h2 id="cases-title" class="hc-title">{nb('Завершённые дела: как это было')}</h2>
        <p class="hc-lead">{nb('Определения Арбитражного суда Томской области за 2025–2026 годы. Имена не публикую, каждое дело можно найти в картотеке по номеру')}</p>
      </div>
      <div class="hidden shrink-0 gap-4 lg:flex">
        <button type="button" class="hc-arrow" data-hc-prev aria-label="Предыдущие дела">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
        </button>
        <button type="button" class="hc-arrow" data-hc-next aria-label="Следующие дела">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </div>
    </div>

    <ul class="hc-track" data-hc-track>
      {recentCases.map((c) => (
        <li class="hc-card">
          <Image src={imgs[c.img]} alt={alts[c.img]} widths={[480, 800]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 86vw" class="hc-img" loading="lazy" />
          <div class="hc-body">
            <h3 class="hc-name">{nb(c.title)}</h3>
            <p class="hc-text">{nb(c.text)}</p>
            <a href="https://kad.arbitr.ru/" target="_blank" rel="noopener" class="hc-check" data-case={c.number}>
              Проверить в картотеке
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <div class="hc-foot">
              <p class="hc-foot-label">Дело</p>
              <ul class="hc-tags">
                <li class="hc-tag is-num tnum">{c.number}</li>
                <li class="hc-tag">{c.debtor}</li>
              </ul>
              <p class="hc-date">Завершено <time datetime={c.finished}>{date(c.finished)}</time>, процедура {c.months}&nbsp;мес.</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="hc-note">{nb('По ссылке откроется картотека арбитражных дел, номер дела скопируется — вставьте его в поле «Номер дела»')}</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.cases').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-hc-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-hc-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-hc-next]');
    root.querySelectorAll<HTMLAnchorElement>('[data-case]').forEach((a) => {
      a.addEventListener('click', () => { navigator.clipboard?.writeText(a.dataset.case || '').catch(() => {}); });
    });
    if (!track || !prev || !next) return;
    const step = () => {
      const card = track.querySelector<HTMLElement>('.hc-card');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .cases { background: #f3f4f6; padding: clamp(3rem, 5.5vw, 5.75rem) 0 clamp(3.5rem, 7vw, 7rem); }
  .hc-chip {
    display: inline-flex; align-items: center; gap: 0.75rem;
    padding: 0.625rem 1.125rem; border-radius: 8px; background: #fff;
    font-size: clamp(1rem, 1.1vw, 1.1875rem); line-height: 1.2; color: var(--color-ink);
  }
  .hc-title { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.08; letter-spacing: -0.025em; color: #15171c; text-wrap: wrap; }
  .hc-lead { margin-top: clamp(0.75rem, 1.2vw, 1.25rem); max-width: 44rem; font-size: var(--fs-lead); line-height: 1.4; color: #5f646d; text-wrap: wrap; }
  .hc-arrow {
    display: grid; place-items: center; width: clamp(3.5rem, 3.6vw, 4.375rem); aspect-ratio: 1;
    border-radius: 8px; background: #15171c; color: #fff; cursor: pointer;
    transition: background-color 150ms var(--ease-out), opacity 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .hc-arrow:hover { background: #034b8e; }
  .hc-arrow:active { transform: scale(0.96); }
  .hc-arrow:disabled { opacity: 0.25; cursor: default; background: #15171c; }
  .hc-arrow:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; }

  .hc-track {
    --gap: clamp(1rem, 1.5vw, 1.75rem);
    display: flex; gap: var(--gap);
    margin-top: clamp(1.75rem, 3vw, 3.5rem);
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    margin-inline: -1rem; padding-inline: 1rem; scroll-padding-inline: 1rem;
  }
  .hc-track::-webkit-scrollbar { display: none; }
  .hc-card { flex: 0 0 90%; scroll-snap-align: start; display: flex; flex-direction: column; padding: 0.75rem; border-radius: 16px; background: #fff; }
  @media (min-width: 640px) {
    .hc-track { margin-inline: 0; padding-inline: 0; scroll-padding-inline: 0; }
    .hc-card { flex-basis: calc((100% - var(--gap)) / 2); }
  }
  @media (min-width: 1024px) { .hc-card { flex-basis: calc((100% - 2 * var(--gap)) / 3); } }

  .hc-img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 10px; }
  .hc-body { display: flex; flex: 1; flex-direction: column; padding: clamp(1rem, 1.6vw, 1.5rem) clamp(0.5rem, 0.9vw, 0.875rem) 0.5rem; }
  .hc-name { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: 1.15; letter-spacing: -0.015em; color: #15171c; text-wrap: wrap; }
  .hc-text { margin-top: 0.75rem; font-size: var(--fs-body); line-height: 1.45; color: #7c818a; text-wrap: wrap; }
  .hc-check {
    display: inline-flex; align-self: flex-start; align-items: center; gap: 0.5rem; margin-top: 1rem; margin-bottom: 1.5rem;
    font-size: var(--fs-body); font-weight: 500; color: #034b8e; text-decoration: none;
  }
  .hc-check svg { transition: transform 150ms var(--ease-out); }
  .hc-check:hover svg { transform: translateX(3px); }
  .hc-check:focus-visible { outline: 2px solid #034b8e; outline-offset: 3px; border-radius: 4px; }
  .hc-foot { margin-top: auto; padding-top: 1rem; border-top: 1px solid #eceef1; }
  .hc-foot-label { font-size: 0.9375rem; font-weight: 600; color: #15171c; }
  .hc-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.625rem; }
  .hc-tag { padding: 0.375rem 0.625rem; border-radius: 8px; background: #f3f4f6; font-size: 0.875rem; line-height: 1.3; color: #5f646d; white-space: nowrap; }
  .hc-tag.is-num { background: #e6eef8; color: #034b8e; font-weight: 500; }
  .hc-date { margin-top: 0.625rem; font-size: 0.875rem; color: #8a8f98; }

  .hc-note { margin-top: clamp(1.25rem, 2vw, 2rem); font-size: clamp(0.875rem, 0.95vw, 1rem); line-height: 1.45; color: #7c818a; }
</style>
