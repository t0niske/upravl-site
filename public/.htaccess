# bankrotstvo70.ru — статический сайт (Astro). Apache / shared-хостинг.
AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# HTTPS и без www (один канонический хост).
# На REG.RU перед Apache стоит nginx: %{HTTPS} там всегда off, протокол — в X-Forwarded-Proto
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://bankrotstvo70.ru/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://bankrotstvo70.ru/$1 [R=301,L]

# --- Старые статьи WordPress (301, без цепочек) ---
RewriteRule ^2020/01/23/ /stati/mify-o-bankrotstve-grazhdan/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/2020/02/25/%d0%b0%d1%80%d0%b1 [NC]
RewriteRule ^2020/02/25/ /stati/kto-takoj-arbitrazhnyj-upravlyayushchij/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/2020/02/25/%d1%81%d1%83%d0%b1 [NC]
RewriteRule ^2020/02/25/ /bankrotstvo-ur-lica/subsidiarnaya-otvetstvennost/ [R=301,L]
RewriteRule ^20[0-9]{2}/[0-9]{2}/?$ /stati/ [R=301,L]

# --- Служебные и демо-страницы WordPress: удалены навсегда ---
RewriteRule ^(news|blog|glossary|404-page|feed|comments/feed)(/.*)?$ - [G,L]
RewriteRule ^(portfolios|teams|client|testimonial|clt_testimonials|tooltips|foogallery|popup|category|author|tag)(/.*)?$ - [G,L]
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/.*)?$ - [G,L]
RewriteRule ^(wp-login|xmlrpc|wp-cron|i)\.php$ - [G,L]
RewriteRule ^home/?$ / [R=301,L]

# Слеш на конце для страниц-каталогов
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-z0-9]+$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# Безопасность
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
<If "%{REQUEST_URI} =~ m#^/_astro/#">
Header set Cache-Control "public, max-age=31536000, immutable"
</If>
<Else>
<FilesMatch "\.(webp|avif|jpg|png|svg|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</Else>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=600, must-revalidate"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

# Настройки обработчика заявок не отдаём наружу
<FilesMatch "^lead-config(.example)?.php$">
Require all denied
</FilesMatch>
