# Скопируйте в .env и заполните. Файл .env в git не попадает.
# На хостинге: ~/bankrotstvo70-crm/.env (вне папки сайта).

# local — база создаётся сама при первом запросе; production — только командой php database/migrate.php
APP_ENV=local
APP_URL=http://localhost:8797
APP_TIMEZONE=Asia/Tomsk

# Пусто — SQLite в storage/database.sqlite (заявок немного, pdo_sqlite на хостинге есть).
# MySQL при желании: DB_DSN=mysql:host=localhost;dbname=...;charset=utf8mb4
DB_DSN=
DB_USER=
DB_PASS=

# Бот MAX (bin/max-webhook.php subscribe — подключить вебхук APP_URL/api/max-bot).
# Токен — business.max.ru → Чат-боты → ⋮ → Настройки. Секрет — любая строка 32+ символов (A-Z, a-z, 0-9, _ -).
# MAX_LEADS_CHAT_ID — группа для заявок, LEADS_MAIL_TO — почта для заявок (как в lead-config.php сайта).
# MAX_BOT_DRY_RUN=1 — ничего не отправлять в MAX, писать в storage/logs/bot-out.log (локальная проверка).
MAX_BOT_TOKEN=
MAX_BOT_SECRET=
MAX_LEADS_CHAT_ID=
LEADS_MAIL_TO=
MAX_BOT_DRY_RUN=0

# ИИ-ответы: Yandex AI Studio (DeepSeek). Без ключа бот отвечает вопросами-ответами с сайта.
AI_API_KEY=
AI_FOLDER_ID=
AI_MODEL=deepseek-v4-flash
AI_DAILY_LIMIT=15

# Сроки хранения (152-ФЗ): заходы без заявки — месяцев; заявки, по которым человек не стал клиентом, — месяцев
VISITS_RETENTION_MONTHS=3
LEADS_RETENTION_MONTHS=12
